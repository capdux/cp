    "bytesize",
    "pretty-bytes",
    "buffer",
    "buf",
    "endian",
    "iec",
    "si"
  ],
  "repository": "https://github.com/cp-lang/cp/tree/main/packages/bytes",
  "source": {
    "registry": "npm",
    "name": "bytes",
    "repo": "https://github.com/visionmedia/bytes.js",
    "license": "MIT"
  },
  "sources": [
    {
      "registry": "npm",
      "name": "bytes",
      "repo": "https://github.com/visionmedia/bytes.js",
      "license": "MIT"
    },
    {
      "registry": "crates.io",
      "name": "bytes",
      "repo": "https://github.com/tokio-rs/bytes",
      "license": "MIT"
    }
  ],
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
