{
  "name": "ssh-key",
  "version": "1.0.0",
  "description": "Zero-heap OpenSSH public key (ssh-ed25519, ssh-rsa, ecdsa-sha2-*, sk-ssh-*) authorized_keys parser, validator, and formatter for CP (compatible with npm sshpk & Rust ssh-key)",
  "license": "MIT",
  "main": "src/index.cp",
  "types": "src/index.d.cp",
  "keywords": [
    "ssh",
    "openssh",
    "ed25519",
    "rsa",
    "authorized_keys",
    "sshpk",
    "security"
  ],
  "repository": "https://github.com/cp-lang/cp/tree/main/packages/ssh-key",
  "source": {
    "registry": "crates.io",
    "name": "ssh-key",
    "repo": "https://github.com/RustCrypto/SSH",
    "license": "MIT"
  },
  "sources": [
    {
      "registry": "crates.io",
      "name": "ssh-key",
      "repo": "https://github.com/RustCrypto/SSH",
      "license": "MIT"
    },
    {
      "registry": "npm",
      "name": "sshpk",
      "repo": "https://github.com/TritonDataCenter/node-sshpk",
      "license": "MIT"
    }
  ],
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
