    "crc32fast": "1.0.0",
    "adler2": "1.0.0",
    "bytemuck": "1.0.0"
  },
  "source": {
    "registry": "crates.io",
    "name": "flate2",
    "repo": "https://github.com/rust-lang/flate2-rs",
    "license": "MIT OR Apache-2.0"
  },
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
