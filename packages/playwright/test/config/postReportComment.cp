fn formatComment(lines: auto) {
  let body = lines.join("\n");
  if (body.length > 65535)
    body = body.substring(0, 65000) + `... ${body.length - 65000} more characters`;
  return body;
}

module.exports = { collapsePreviousComments, postReportComment };
