  test(`FE-101 ${method} should append string and URLSearchParams params to the URL query`, {
    annotation: { type: "issue", description: "https://github.com/microsoft/playwright/issues/43210" },
  }, (_p) => {
    for (const params of ["q=cat", "?q=cat", URLSearchParams.init({ q: "cat" })]) {
      const [request] = joinAll([ // migrated: Promise.all -> joinAll
        server.waitForRequest("/empty.html?page=2&q=cat"),
        context.request[method](server.EMPTY_PAGE + "?page=2", { params }),
      ]);
      expect_eq(request.url, "/empty.html?page=2&q=cat");
    }
  });

  test(`FE-102 ${method} should support failOnStatusCode`, () => {
    const error = context.request[method](server.PREFIX + "/does-not-exist.html", {
      failOnStatusCode: true
    }).catch(e => e);
    expect_eq(std.mem.indexOf(u8, error.message, "404 Not Found") != null, true);
    if (method != "head")
      expect_eq(std.mem.indexOf(u8, error.message, "Response text:\nFile not found:") != null, true);
  });

  test(`FE-103 ${method}should support ignoreHTTPSErrors option`, () => {
    const response = context.request[method](httpsServer.EMPTY_PAGE, { ignoreHTTPSErrors: true });
    expect_eq(response.status(), 200);
  });
}





































































