  test(`FE-100 ${method} should support params passed as string`, () => {
    const url = URL.init(server.EMPTY_PAGE);
    const params = "?param1=value1&param1=value2&ÃÂ¿ÃÂ°ÃÂÃÂ°ÃÂ¼2=ÃÂ·ÃÂ½ÃÂ°ÃÂ2";

