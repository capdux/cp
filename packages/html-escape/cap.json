{
  "name": "html-escape",
  "version": "1.0.0",
  "description": "Zero-heap HTML entity escaper and unescaper (named entities + decimal/hex numeric character references) for CP (compatible with npm escape-html, he & Rust html-escape)",
  "license": "MIT",
  "main": "src/index.cp",
  "types": "src/index.d.cp",
  "keywords": [
    "html",
    "escape",
    "unescape",
    "entities",
    "xss",
    "he",
    "sanitize"
  ],
  "repository": "https://github.com/cp-lang/cp/tree/main/packages/@cap/html-escape",
  "source": {
    "registry": "crates.io",
    "name": "html-escape",
    "repo": "https://github.com/magiclen/html-escape",
    "license": "MIT"
  },
  "sources": [
    {
      "registry": "crates.io",
      "name": "html-escape",
      "repo": "https://github.com/magiclen/html-escape",
      "license": "MIT"
    },
    {
      "registry": "npm",
      "name": "html-entities",
      "repo": "https://github.com/mdevils/html-entities",
      "license": "MIT"
    }
  ],
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
