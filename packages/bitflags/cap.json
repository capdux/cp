{
  "name": "bitflags",
  "version": "1.0.0",
  "description": "Zero-heap 64-bit bitflags set algebra (contains, intersects, insert, remove, toggle, difference, popcount, trailing/leading zeros) for CP (compatible with Rust bitflags & npm bitfield)",
  "license": "MIT",
  "main": "src/index.cp",
  "types": "src/index.d.cp",
  "keywords": [
    "bitflags",
    "bitset",
    "flags",
    "bitmask",
    "bits",
    "rust-bitflags"
  ],
  "repository": "https://github.com/cp-lang/cp/tree/main/packages/@cap/bitflags",
  "source": {
    "registry": "crates.io",
    "name": "bitflags",
    "repo": "https://github.com/bitflags/bitflags",
    "license": "MIT"
  },
  "sources": [
    {
      "registry": "crates.io",
      "name": "bitflags",
      "repo": "https://github.com/bitflags/bitflags",
      "license": "MIT"
    },
    {
      "registry": "npm",
      "name": "bitfield",
      "repo": "https://github.com/fb55/bitfield",
      "license": "BSD-2-Clause"
    }
  ],
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
