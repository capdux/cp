{
  "name": "sprintf-js",
  "version": "1.0.0",
  "description": "Zero-allocation C-style sprintf formatting engine supporting %s/%d/%i/%u/%x/%X/%o/%b/%f/%c with flags, width, and precision in pure CP",
  "license": "BSD-3-Clause",
  "main": "src/index.cp",
  "types": "src/index.d.cp",
  "keywords": [
    "sprintf",
    "printf",
    "format",
    "string",
    "zero-alloc"
  ],
  "source": {
    "registry": "npm",
    "name": "sprintf-js",
    "repo": "https://github.com/alexei/sprintf.js",
    "license": "BSD-3-Clause"
  },
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
