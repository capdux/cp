{
  "name": "@cap/duckdb",
  "ver": "1.2.1",
  "description": "DuckDB (v1.2.1) in-process analytical SQL OLAP database for CP via prebuilt dynamic library",
  "main": "src/index.cp",
  "license": "MIT",
  "bin": {
    "duckdb_shim": {
      "path": ".",
      "src": [
        "c/duckdb_ffi.c"
      ],
      "include": [
        "include",
        "c"
      ],
      "flag": [
        "-O3"
      ],
      "opt": "fast",
      "prebuilt": "prebuilt"
    }
  },
  "sys": {
    "duckdb": {
      "prebuilt": "prebuilt"
    },
    "c": {},
    "m": {},
    "pthread": {},
    "dl": {}
  },
  "source": {
    "registry": "c++",
    "name": "duckdb",
    "repo": "https://github.com/duckdb/duckdb",
    "license": "MIT"
  }
}
