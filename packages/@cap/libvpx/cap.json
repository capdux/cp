{
  "name": "@cap/libvpx",
  "ver": "1.15.0",
  "description": "Google libvpx 1.15.0 royalty-free VP8/VP9 video codec for CP via prebuilt dynamic library",
  "main": "src/index.cp",
  "license": "BSD-3-Clause",
  "bin": {
    "vpx_shim": {
      "path": ".",
      "src": [
        "c/vpx_ffi.c"
      ],
      "include": [
        "include",
        "c"
      ],
      "flag": [
        "-O3",
        "-g0"
      ],
      "opt": "fast",
      "prebuilt": "prebuilt"
    }
  },
  "sys": {
    "vpx": {
      "prebuilt": "prebuilt"
    },
    "c": {},
    "m": {},
    "pthread": {}
  }
}
