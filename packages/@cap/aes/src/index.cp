const AES_RCON: [10]u8 = @as([10]u8, [
    0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36,
]);

fn aesXtime(x: u8): u8 {
    const shifted: u8 = x << 1;
    if ((x & (0x80 as u8)) != (0 as u8)) {
        return shifted ^ (0x1b as u8);
    }
    return shifted;
}

fn aesMul(a_in: u8, b_in: u8): u8 {
    let a = a_in;
    let b = b_in;
    let p: u8 = 0;
    let i: usize = 0;
    while (i < 8) {
        if ((b & (1 as u8)) != (0 as u8)) {
            p = p ^ a;
        }
        a = aesXtime(a);
        b = b >> 1;
        i += 1;
    }
    return p;
}

fn aesSubBytes(state: []u8) {
    let i: usize = 0;
    while (i < 16) {
        state[i] = AES_SBOX[state[i] as usize];
        i += 1;
    }
}

fn aesInvSubBytes(state: []u8) {
    let i: usize = 0;
    while (i < 16) {
        state[i] = AES_INV_SBOX[state[i] as usize];
        i += 1;
    }
}

fn aesShiftRows(s: []u8) {
    // Row 1: shift left by 1
    const t1 = s[1];
    s[1] = s[5];
    s[5] = s[9];
    s[9] = s[13];
    s[13] = t1;
    // Row 2: shift left by 2
    const t2 = s[2];
    const t6 = s[6];
    s[2] = s[10];
    s[6] = s[14];
    s[10] = t2;
    s[14] = t6;
    // Row 3: shift left by 3 (right by 1)
    const t15 = s[15];
    s[15] = s[11];
    s[11] = s[7];
    s[7] = s[3];
    s[3] = t15;
}

fn aesInvShiftRows(s: []u8) {
    // Row 1: shift right by 1
    const t13 = s[13];
    s[13] = s[9];
    s[9] = s[5];
    s[5] = s[1];
    s[1] = t13;
    // Row 2: shift right by 2
    const t2 = s[2];
    const t6 = s[6];
    s[2] = s[10];
    s[6] = s[14];
    s[10] = t2;
    s[14] = t6;
    // Row 3: shift right by 3 (left by 1)
    const t3 = s[3];
    s[3] = s[7];
    s[7] = s[11];
    s[11] = s[15];
    s[15] = t3;
}

fn aesMixColumns(s: []u8) {
    let c: usize = 0;
    while (c < 4) {
        const idx = c * 4;
        const a0 = s[idx];
        const a1 = s[idx + 1];
        const a2 = s[idx + 2];
        const a3 = s[idx + 3];
        const t = a0 ^ a1 ^ a2 ^ a3;
        s[idx] = a0 ^ t ^ aesXtime(a0 ^ a1);
        s[idx + 1] = a1 ^ t ^ aesXtime(a1 ^ a2);
        s[idx + 2] = a2 ^ t ^ aesXtime(a2 ^ a3);
        s[idx + 3] = a3 ^ t ^ aesXtime(a3 ^ a0);
        c += 1;
    }
}

fn aesInvMixColumns(s: []u8) {
    let c: usize = 0;
    while (c < 4) {
        const idx = c * 4;
        const a0 = s[idx];
        const a1 = s[idx + 1];
        const a2 = s[idx + 2];
        const a3 = s[idx + 3];
        s[idx] = aesMul(a0, 0x0e as u8) ^ aesMul(a1, 0x0b as u8) ^ aesMul(a2, 0x0d as u8) ^ aesMul(a3, 0x09 as u8);
        s[idx + 1] = aesMul(a0, 0x09 as u8) ^ aesMul(a1, 0x0e as u8) ^ aesMul(a2, 0x0b as u8) ^ aesMul(a3, 0x0d as u8);
        s[idx + 2] = aesMul(a0, 0x0d as u8) ^ aesMul(a1, 0x09 as u8) ^ aesMul(a2, 0x0e as u8) ^ aesMul(a3, 0x0b as u8);
        s[idx + 3] = aesMul(a0, 0x0b as u8) ^ aesMul(a1, 0x0d as u8) ^ aesMul(a2, 0x09 as u8) ^ aesMul(a3, 0x0e as u8);
        c += 1;
    }
}

fn aesAddRoundKey(s: []u8, rk: []const u8, round: usize) {
    const off = round * 16;
    let i: usize = 0;
    while (i < 16) {
        s[i] = s[i] ^ rk[off + i];
        i += 1;
    }
}

fn aesExpandKey(key: []const u8, nk: usize, nr: usize, rk: []u8) {
    const totalWords = 4 * (nr + 1);
    let i: usize = 0;
    while (i < nk * 4) {
        rk[i] = key[i];
        i += 1;
    }
    let w: usize = nk;
    while (w < totalWords) {
        const prev = (w - 1) * 4;
        let t0 = rk[prev];
        let t1 = rk[prev + 1];
        let t2 = rk[prev + 2];
        let t3 = rk[prev + 3];
        if ((w % nk) == 0) {
            const tmp = t0;
            t0 = AES_SBOX[t1 as usize] ^ AES_RCON[(w / nk) - 1];
            t1 = AES_SBOX[t2 as usize];
            t2 = AES_SBOX[t3 as usize];
            t3 = AES_SBOX[tmp as usize];
        } else if (nk > 6 && (w % nk) == 4) {
            t0 = AES_SBOX[t0 as usize];
            t1 = AES_SBOX[t1 as usize];
            t2 = AES_SBOX[t2 as usize];
            t3 = AES_SBOX[t3 as usize];
        }
        const back = (w - nk) * 4;
        const dst = w * 4;
        rk[dst] = rk[back] ^ t0;
        rk[dst + 1] = rk[back + 1] ^ t1;
        rk[dst + 2] = rk[back + 2] ^ t2;
        rk[dst + 3] = rk[back + 3] ^ t3;
        w += 1;
    }
}

fn aesEncryptCore(block: [16]u8, rk: []const u8, nr: usize): [16]u8 {
    let s: [16]u8 = block;
    aesAddRoundKey(s[0..16], rk, 0);
    let r: usize = 1;
    while (r < nr) {
        aesSubBytes(s[0..16]);
        aesShiftRows(s[0..16]);
        aesMixColumns(s[0..16]);
        aesAddRoundKey(s[0..16], rk, r);
        r += 1;
    }
    aesSubBytes(s[0..16]);
    aesShiftRows(s[0..16]);
    aesAddRoundKey(s[0..16], rk, nr);
    return s;
}

fn aesDecryptCore(block: [16]u8, rk: []const u8, nr: usize): [16]u8 {
    let s: [16]u8 = block;
    aesAddRoundKey(s[0..16], rk, nr);
    let r: usize = nr - 1;
    while (r >= 1) {
        aesInvShiftRows(s[0..16]);
        aesInvSubBytes(s[0..16]);
        aesAddRoundKey(s[0..16], rk, r);
        aesInvMixColumns(s[0..16]);
        r -= 1;
    }
    aesInvShiftRows(s[0..16]);
    aesInvSubBytes(s[0..16]);
    aesAddRoundKey(s[0..16], rk, 0);
    return s;
}

/// FIPS-197 AES-128 block cipher (10 rounds, 128-bit key).
pub struct Aes128 {
    rk: [176]u8;

    static fn new(key: [16]u8): Aes128 {
        let rk: [176]u8 = undefined;
        let k: [16]u8 = key;
        aesExpandKey(k[0..16], 4, 10, rk[0..176]);
        return Aes128{ rk: rk };
    }

    fn encryptBlock(block: [16]u8): [16]u8 {
        let localRk: [176]u8 = _.rk;
        const out: [16]u8 = aesEncryptCore(block, localRk[0..176], 10);
        return out;
    }

    fn decryptBlock(block: [16]u8): [16]u8 {
        let localRk: [176]u8 = _.rk;
        const out: [16]u8 = aesDecryptCore(block, localRk[0..176], 10);
        return out;
    }
}

/// FIPS-197 AES-192 block cipher (12 rounds, 192-bit key).
pub struct Aes192 {
    rk: [208]u8;

    static fn new(key: [24]u8): Aes192 {
        let rk: [208]u8 = undefined;
        let k: [24]u8 = key;
        aesExpandKey(k[0..24], 6, 12, rk[0..208]);
        return Aes192{ rk: rk };
    }

    fn encryptBlock(block: [16]u8): [16]u8 {
        let localRk: [208]u8 = _.rk;
        const out: [16]u8 = aesEncryptCore(block, localRk[0..208], 12);
        return out;
    }

    fn decryptBlock(block: [16]u8): [16]u8 {
        let localRk: [208]u8 = _.rk;
        const out: [16]u8 = aesDecryptCore(block, localRk[0..208], 12);
        return out;
    }
}

/// FIPS-197 AES-256 block cipher (14 rounds, 256-bit key).
pub struct Aes256 {
    rk: [240]u8;

    static fn new(key: [32]u8): Aes256 {
        let rk: [240]u8 = undefined;
        let k: [32]u8 = key;
        aesExpandKey(k[0..32], 8, 14, rk[0..240]);
        return Aes256{ rk: rk };
    }

    fn encryptBlock(block: [16]u8): [16]u8 {
        let localRk: [240]u8 = _.rk;
        const out: [16]u8 = aesEncryptCore(block, localRk[0..240], 14);
        return out;
    }

    fn decryptBlock(block: [16]u8): [16]u8 {
        let localRk: [240]u8 = _.rk;
        const out: [16]u8 = aesDecryptCore(block, localRk[0..240], 14);
        return out;
    }
}
