{
  "name": "@cap/harfbuzz",
  "ver": "15.2.0",
  "description": "HarfBuzz (v15.2.0) industrial-standard OpenType text shaping engine (CJK/Arabic/Latin/Indic) for CP",
  "main": "src/index.cp",
  "license": "MIT",
  "bin": {
    "harfbuzz": {
