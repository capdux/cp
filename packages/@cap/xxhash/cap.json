{
  "name": "@cap/xxhash",
  "ver": "0.8.3",
  "description": "xxHash 0.8.3 extremely fast non-cryptographic hash algorithm (XXH32/XXH64/XXH3) for CP",
  "main": "src/index.cp",
  "license": "BSD-2-Clause",
  "bin": {
    "xxhash": {
      "path": "c",
      "src": [
        "xxhash.c"
      ],
      "include": [
        "."
      ],
      "flag": [
        "-O3",
        "-g0"
      ],
      "opt": "fast",
      "prebuilt": "prebuilt"
    }
  },
  "sys": {
    "c": {}
  },
  "source": {
    "registry": "c",
    "name": "xxHash",
    "repo": "https://github.com/Cyan4973/xxHash",
    "license": "BSD-2-Clause"
  }
}
