{
  "name": "@cap/sdl3",
  "ver": "3.2.8",
  "description": "SDL3 (v3.2.8) cross-platform window, audio, input & GPU abstraction for CP via prebuilt dynamic library",
  "main": "src/index.cp",
  "license": "Zlib",
  "bin": {
    "sdl3_shim": {
      "path": ".",
      "src": [
        "c/sdl3_ffi.c"
      ],
      "include": [
        "include",
        "c"
      ],
      "flag": [
        "-O3"
      ],
      "opt": "fast",
      "prebuilt": "prebuilt"
    }
  },
  "sys": {
    "SDL3": {
      "prebuilt": "prebuilt"
    },
    "c": {},
    "m": {},
    "pthread": {},
    "dl": {}
  }
}
