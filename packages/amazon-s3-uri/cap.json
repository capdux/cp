{
  "name": "amazon-s3-uri",
  "version": "1.0.0",
  "description": "Zero-heap AWS S3 / R2 / MinIO URI parser (s3://, virtual-hosted-style, path-style) and bucket name validator for CP (compatible with npm amazon-s3-uri & Rust s3-uri)",
  "license": "MIT",
  "main": "src/index.cp",
  "types": "src/index.d.cp",
  "keywords": [
    "s3",
    "aws",
    "r2",
    "minio",
    "storage",
    "uri",
    "cloud"
  ],
  "repository": "https://github.com/cp-lang/cp/tree/main/packages/amazon-s3-uri",
  "source": {
    "registry": "npm",
    "name": "amazon-s3-uri",
    "repo": "https://github.com/jvdl/amazon-s3-uri",
    "license": "MIT"
  },
  "sources": [
    {
      "registry": "npm",
      "name": "amazon-s3-uri",
      "repo": "https://github.com/jvdl/amazon-s3-uri",
      "license": "MIT"
    },
    {
      "registry": "crates.io",
      "name": "aws-sdk-s3",
      "repo": "https://github.com/awslabs/aws-sdk-rust",
      "license": "Apache-2.0"
    }
  ],
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
