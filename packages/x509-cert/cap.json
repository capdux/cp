  "types": "src/index.d.cp",
  "dependencies": {
    "der": "1.0.0",
    "const-oid": "1.0.0",
    "spki": "1.0.0",
    "pem-rfc7468": "1.0.0"
  },
  "source": {
    "registry": "crates.io",
    "name": "x509-cert",
    "repo": "https://github.com/RustCrypto/formats",
    "license": "MIT"
  },
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
