  "license": "MIT",
  "main": "src/index.cp",
  "types": "src/index.d.cp",
  "dependencies": {
    "pem-rfc7468": "1.0.0"
  },
  "keywords": [
    "tls",
    "pki",
    "x509",
    "dns",
    "server-name",
    "pem",
    "der",
    "rustls",
    "zero-alloc"
  ],
  "source": {
    "registry": "crates.io",
    "name": "rustls-pki-types",
    "repo": "https://github.com/rustls/pki-types",
    "license": "MIT"
  },
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
