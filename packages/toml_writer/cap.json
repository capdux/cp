{
  "name": "toml_writer",
  "version": "1.0.0",
  "description": "Zero-heap TOML 1.0 serializer and formatter (bare/quoted keys, escaped strings, tables, array-of-tables, inline arrays) inspired by Rust toml_writer",
  "license": "MIT",
  "main": "src/index.cp",
  "types": "src/index.d.cp",
  "keywords": [
    "toml",
    "toml_writer",
    "serializer",
    "config",
    "formatter",
    "zero-alloc"
  ],
  "source": {
    "registry": "crates.io",
    "name": "toml_writer",
    "repo": "https://github.com/toml-rs/toml",
    "license": "MIT"
  },
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
}
