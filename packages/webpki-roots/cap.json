    "spki": "1.0.0"
  },
  "keywords": [
    "webpki",
    "roots",
    "mozilla",
    "ca",
    "trust-anchors",
    "x509",
    "tls",
    "pki",
    "zero-alloc"
  ],
  "source": {
    "registry": "crates.io",
    "name": "webpki-roots",
    "repo": "https://github.com/rustls/webpki-roots",
    "license": "MIT"
  },
  "docs": {
    "types": "src/index.d.cp",
    "agent": "README_AGENT.md",
    "readme": "README.md",
    "readme_zh": "README.zh-CN.md"
  }
