import { test, assert, assertEq } from "cap:test";
import {
    YarnLockParseError,
    YarnLockFormatKind,
    detectYarnLockFormat,
    splitYarnDescriptor,
    YarnIntegrityAlgo,
    parseYarnIntegrity,
    YarnV1DepKind,
    YarnV1AliasEntry,
    YarnV1DepEntry,
    YarnV1PackageRecord,
    YarnV1ParseBuffers,
    parseYarnLockV1,
    YarnDanglingDep,
    lookupYarnAlias,
    buildYarnMigrationReport,
    formatYarnMigrationSummary,
    formatYarnLockV1,
} from "cap:pkg";

fn strEql(a: []const u8, b: []const u8): bool {
    if (a.len != b.len) return false;
    let i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) return false;
        i += 1;
    }
    return true;
}

fn strContains(haystack: []const u8, needle: []const u8): bool {
    if (needle.len == 0) return true;
    if (needle.len > haystack.len) return false;
    let i: usize = 0;
    while (i + needle.len <= haystack.len) {
        if (strEql(haystack[i..i + needle.len], needle)) return true;
        i += 1;
    }
    return false;
}

test("detectYarnLockFormat distinguishes Yarn v1 from Yarn Berry v2+ and parseYarnLockV1 rejects Berry", () => {
    const v1 = "# THIS IS AN AUTOGENERATED FILE.\n# yarn lockfile v1\n\nlodash@^4.17.21:\n  version \"4.17.21\"\n";
    const berry = "__metadata:\n  version: 8\n  cacheKey: 10c0\n";
    const other = "lockfileVersion: '9.0'\n";

    assert(detectYarnLockFormat(v1) == YarnLockFormatKind.YarnV1);
    assert(detectYarnLockFormat(berry) == YarnLockFormatKind.YarnBerryV2Plus);
    assert(detectYarnLockFormat(other) == YarnLockFormatKind.Unknown);

    let pkgs: [4]YarnV1PackageRecord = [YarnV1PackageRecord.empty(); 4];
    let aliases: [4]YarnV1AliasEntry = [YarnV1AliasEntry.empty(); 4];
    let deps: [4]YarnV1DepEntry = [YarnV1DepEntry.empty(); 4];
    let scratch: [64]u8 = [0; 64];
    let bufs = YarnV1ParseBuffers{ packages: pkgs[0..], aliases: aliases[0..], deps: deps[0..], unescape_scratch: scratch[0..] };

    let berry_err = false;
    * = parseYarnLockV1(berry, &bufs) catch |e| {
        berry_err = (e == YarnLockParseError.UnsupportedYarnBerryFormat);
    };
    assert(berry_err);
});

test("splitYarnDescriptor splits unscoped, scoped, npm alias, workspace, and URL descriptors", () => {
    const d1 = splitYarnDescriptor("lodash@^4.17.21") catch unreachable;
    assert(strEql(d1.name, "lodash") && strEql(d1.range, "^4.17.21") && !d1.is_scoped);

    const d2 = splitYarnDescriptor("@babel/core@^7.22.0") catch unreachable;
    assert(strEql(d2.name, "@babel/core") && strEql(d2.range, "^7.22.0") && d2.is_scoped);

    const d3 = splitYarnDescriptor("my-lodash@npm:lodash@^4.17.21") catch unreachable;
    assert(strEql(d3.name, "my-lodash") && strEql(d3.range, "npm:lodash@^4.17.21") && d3.is_npm_alias);

    const d4 = splitYarnDescriptor("@acme/ui@workspace:^") catch unreachable;
    assert(strEql(d4.name, "@acme/ui") && strEql(d4.range, "workspace:^") && d4.is_workspace);

    const d5 = splitYarnDescriptor("pkg@https://example.com/pkg-1.0.0.tgz") catch unreachable;
    assert(strEql(d5.name, "pkg") && d5.is_url);

    let bad_err = false;
    * = splitYarnDescriptor("@broken-no-slash@^1.0.0") catch |e| {
        bad_err = (e == YarnLockParseError.InvalidDescriptor);
    };
    assert(bad_err);
});

test("parseYarnIntegrity validates sha512/sha256/sha1 SRI strings and rejects malformed digests", () => {
    const s512 = parseYarnIntegrity("sha512-AbCdEf0123456789+/==") catch unreachable;
    assert(s512.algo == YarnIntegrityAlgo.Sha512 && s512.valid_base64);
    assert(strEql(s512.digest_b64, "AbCdEf0123456789+/=="));

    const s1 = parseYarnIntegrity("sha1-1234567890abcdef==") catch unreachable;
    assert(s1.algo == YarnIntegrityAlgo.Sha1 && s1.valid_base64);

    const empty = parseYarnIntegrity("") catch unreachable;
    assert(empty.algo == YarnIntegrityAlgo.None && !empty.valid_base64);

    let bad_algo = false;
    * = parseYarnIntegrity("md5-1234567890") catch |e| {
        bad_algo = (e == YarnLockParseError.InvalidIntegrityFormat);
    };
    assert(bad_algo);

    let bad_b64 = false;
    * = parseYarnIntegrity("sha512-not!valid@base64") catch |e| {
        bad_b64 = (e == YarnLockParseError.InvalidIntegrityFormat);
    };
    assert(bad_b64);
});

test("parseYarnLockV1 parses multi-alias headers, dependencies, optionalDependencies, and CRLF", () => {
    const src =
        "# THIS IS AN AUTOGENERATED FILE. DO NOT EDIT THIS FILE DIRECTLY.\r\n" ++
        "# yarn lockfile v1\r\n\r\n" ++
        "\"@babel/core@^7.20.0\", \"@babel/core@^7.22.0\":\r\n" ++
        "  version \"7.22.5\"\r\n" ++
        "  resolved \"https://registry.yarnpkg.com/@babel/core/-/core-7.22.5.tgz\"\r\n" ++
        "  integrity sha512-AbCdEf0123456789==\r\n" ++
        "  dependencies:\r\n" ++
        "    \"@babel/types\" \"^7.22.5\"\r\n" ++
        "    semver \"^6.3.1\"\r\n" ++
        "  optionalDependencies:\r\n" ++
        "    fsevents \"^2.3.2\"\r\n\r\n" ++
        "\"@babel/types@^7.22.5\":\r\n" ++
        "  version \"7.22.5\"\r\n" ++
        "  resolved \"https://registry.yarnpkg.com/@babel/types/-/types-7.22.5.tgz\"\r\n" ++
        "  integrity sha512-ZyXwVu9876543210==\r\n";

    let pkgs: [8]YarnV1PackageRecord = [YarnV1PackageRecord.empty(); 8];
    let aliases: [16]YarnV1AliasEntry = [YarnV1AliasEntry.empty(); 16];
    let deps: [16]YarnV1DepEntry = [YarnV1DepEntry.empty(); 16];
    let scratch: [256]u8 = [0; 256];
    let bufs = YarnV1ParseBuffers{ packages: pkgs[0..], aliases: aliases[0..], deps: deps[0..], unescape_scratch: scratch[0..] };

    const res = parseYarnLockV1(src, &bufs) catch unreachable;
    assert(res.format == YarnLockFormatKind.YarnV1);
    assertEq(res.package_count, @as(usize, 2));
    assertEq(res.alias_count, @as(usize, 3));
    assertEq(res.dep_count, @as(usize, 3));

    assert(strEql(pkgs[0].name, "@babel/core"));
    assert(strEql(pkgs[0].version, "7.22.5"));
    assertEq(pkgs[0].alias_count, @as(u32, 2));
    assertEq(pkgs[0].dep_count, @as(u32, 3));
    assertEq(pkgs[0].opt_dep_count, @as(u32, 1));
    assert(pkgs[0].integrity_algo == YarnIntegrityAlgo.Sha512);
    assert(deps[2].kind == YarnV1DepKind.Optional);
    assert(strEql(deps[2].name, "fsevents"));
});

test("lookupYarnAlias and buildYarnMigrationReport audit integrity coverage and dangling deps", () => {
    const src =
        "# yarn lockfile v1\n\n" ++
        "app@^1.0.0:\n" ++
        "  version \"1.0.0\"\n" ++
        "  dependencies:\n" ++
        "    helper \"^2.0.0\"\n" ++
        "    missing-req \"^3.0.0\"\n" ++
        "  optionalDependencies:\n" ++
        "    missing-opt \"^1.0.0\"\n\n" ++
        "helper@^2.0.0:\n" ++
        "  version \"2.0.1\"\n" ++
        "  integrity sha512-HelperHash123456==\n";

    let pkgs: [4]YarnV1PackageRecord = [YarnV1PackageRecord.empty(); 4];
    let aliases: [8]YarnV1AliasEntry = [YarnV1AliasEntry.empty(); 8];
    let deps: [8]YarnV1DepEntry = [YarnV1DepEntry.empty(); 8];
    let scratch: [128]u8 = [0; 128];
    let bufs = YarnV1ParseBuffers{ packages: pkgs[0..], aliases: aliases[0..], deps: deps[0..], unescape_scratch: scratch[0..] };

    const res = parseYarnLockV1(src, &bufs) catch unreachable;
    assertEq(lookupYarnAlias(aliases[0..res.alias_count], "helper", "^2.0.0") ?? 99, @as(u32, 1));
    assert(lookupYarnAlias(aliases[0..res.alias_count], "missing-req", "^3.0.0") == null);

    let dangling: [4]YarnDanglingDep = [YarnDanglingDep.empty(); 4];
    const rep = buildYarnMigrationReport(
        pkgs[0..res.package_count],
        aliases[0..res.alias_count],
        deps[0..res.dep_count],
        dangling[0..],
    );
    assertEq(rep.package_count, @as(u32, 2));
    assertEq(rep.resolved_dep_edges, @as(u32, 1));
    assertEq(rep.dangling_required_count, @as(u32, 1));
    assertEq(rep.dangling_optional_count, @as(u32, 1));
    assertEq(rep.missing_integrity_count, @as(u32, 1));
    assertEq(rep.sha512_count, @as(u32, 1));

    let sbuf: [256]u8 = [0; 256];
    const slen = formatYarnMigrationSummary(rep, sbuf[0..]) catch unreachable;
    const summary = sbuf[0..slen];
    assert(strContains(summary, "2 package(s), 2 alias(es), 1/3 dep edges resolved"));
    assert(strContains(summary, "1 missing integrity"));
    assert(strContains(summary, "1 dangling required dep(s)"));
});

test("formatYarnLockV1 round-trips identically through parse -> format -> re-parse", () => {
    const src =
        "# yarn lockfile v1\n\n" ++
        "\"@acme/core@^1.0.0\", \"@acme/core@^1.2.0\":\n" ++
        "  version \"1.2.3\"\n" ++
        "  resolved \"https://registry.yarnpkg.com/@acme/core/-/core-1.2.3.tgz\"\n" ++
        "  integrity sha512-RoundTripHash123==\n" ++
        "  dependencies:\n" ++
        "    zod \"^3.22.0\"\n\n" ++
        "zod@^3.22.0:\n" ++
        "  version \"3.23.8\"\n" ++
        "  resolved \"https://registry.yarnpkg.com/zod/-/zod-3.23.8.tgz\"\n" ++
        "  integrity sha512-ZodHash987654321==\n";

    let pkgs1: [4]YarnV1PackageRecord = [YarnV1PackageRecord.empty(); 4];
    let aliases1: [8]YarnV1AliasEntry = [YarnV1AliasEntry.empty(); 8];
    let deps1: [8]YarnV1DepEntry = [YarnV1DepEntry.empty(); 8];
    let scratch1: [128]u8 = [0; 128];
    let bufs1 = YarnV1ParseBuffers{ packages: pkgs1[0..], aliases: aliases1[0..], deps: deps1[0..], unescape_scratch: scratch1[0..] };
    const r1 = parseYarnLockV1(src, &bufs1) catch unreachable;

    let formatted: [2048]u8 = [0; 2048];
    const flen = formatYarnLockV1(
        pkgs1[0..r1.package_count],
        aliases1[0..r1.alias_count],
        deps1[0..r1.dep_count],
        formatted[0..],
    ) catch unreachable;

    let pkgs2: [4]YarnV1PackageRecord = [YarnV1PackageRecord.empty(); 4];
    let aliases2: [8]YarnV1AliasEntry = [YarnV1AliasEntry.empty(); 8];
    let deps2: [8]YarnV1DepEntry = [YarnV1DepEntry.empty(); 8];
    let scratch2: [128]u8 = [0; 128];
    let bufs2 = YarnV1ParseBuffers{ packages: pkgs2[0..], aliases: aliases2[0..], deps: deps2[0..], unescape_scratch: scratch2[0..] };
    const r2 = parseYarnLockV1(formatted[0..flen], &bufs2) catch unreachable;

    assertEq(r2.package_count, r1.package_count);
    assertEq(r2.alias_count, r1.alias_count);
    assertEq(r2.dep_count, r1.dep_count);
    assert(strEql(pkgs2[0].name, pkgs1[0].name));
    assert(strEql(pkgs2[0].version, pkgs1[0].version));
    assert(strEql(pkgs2[0].integrity, pkgs1[0].integrity));
    assert(strEql(pkgs2[1].version, pkgs1[1].version));
    assert(strEql(deps2[0].name, "zod"));
});

test("parseYarnLockV1 guards malformed headers, unterminated quotes, and unexpected indentation", () => {
    let pkgs: [4]YarnV1PackageRecord = [YarnV1PackageRecord.empty(); 4];
    let aliases: [4]YarnV1AliasEntry = [YarnV1AliasEntry.empty(); 4];
    let deps: [4]YarnV1DepEntry = [YarnV1DepEntry.empty(); 4];
    let scratch: [64]u8 = [0; 64];
    let bufs = YarnV1ParseBuffers{ packages: pkgs[0..], aliases: aliases[0..], deps: deps[0..], unescape_scratch: scratch[0..] };

    let hdr_err = false;
    * = parseYarnLockV1("lodash@^4.17.21\n", &bufs) catch |e| {
        hdr_err = (e == YarnLockParseError.MalformedHeaderLine);
    };
    assert(hdr_err);

    let quote_err = false;
    * = parseYarnLockV1("\"unterminated@^1.0.0:\n", &bufs) catch |e| {
        quote_err = (e == YarnLockParseError.UnterminatedQuotedString);
    };
    assert(quote_err);

    let ind_err = false;
    * = parseYarnLockV1("  version \"1.0.0\"\n", &bufs) catch |e| {
        ind_err = (e == YarnLockParseError.UnexpectedIndentation);
    };
    assert(ind_err);
});
