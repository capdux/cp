import { test, assert, assertEq } from "cap:test";
import {
    TEXT_LOCK_VERSION_CURRENT,
    TextLockfileError,
    TextLockKvPair,
    TextLockCatalogEntry,
    TextLockWorkspace,
    TextLockPackage,
    TextLockfileBuffers,
    TextLockParseDiag,
    parseTextLockfile,
    formatTextLockfile,
    TextLockDiffKind,
    TextLockDiffEntry,
    diffTextLockfiles,
} from "cap:pkg";

fn strEql(a: []const u8, b: []const u8): bool {
    if (a.len != b.len) return false;
    let i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) return false;
        i += 1;
    }
    return true;
}

fn strContains(haystack: []const u8, needle: []const u8): bool {
    if (needle.len == 0) return true;
    if (needle.len > haystack.len) return false;
    let i: usize = 0;
    while (i + needle.len <= haystack.len) {
        if (strEql(haystack[i..i + needle.len], needle)) return true;
        i += 1;
    }
    return false;
}

test("parseTextLockfile parses full JSONC lockfile with comments, trailing commas, workspaces, overrides, patches, trusted, catalog, and package tuples", () => {
    const src =
        "// cap.lock generated by cap\n" ++
        "{\n" ++
        "  /* header comment */\n" ++
        "  \"lockfileVersion\": 1,\n" ++
        "  \"configVersion\": 1,\n" ++
        "  \"workspaces\": {\n" ++
        "    \"\": {\n" ++
        "      \"name\": \"monorepo\",\n" ++
        "      \"dependencies\": { \"zod\": \"^3.23.0\", },\n" ++
        "      \"devDependencies\": { \"typescript\": \"^5.5.0\" },\n" ++
        "    },\n" ++
        "    \"packages/ui\": {\n" ++
        "      \"name\": \"@org/ui\",\n" ++
        "      \"peerDependencies\": { \"react\": \">=18\" },\n" ++
        "    },\n" ++
        "  },\n" ++
        "  \"overrides\": { \"semver\": \"7.6.3\", },\n" ++
        "  \"patchedDependencies\": { \"zod@3.23.8\": \"patches/zod+3.23.8.patch\" },\n" ++
        "  \"trustedDependencies\": [\"esbuild\", \"sharp\",],\n" ++
        "  \"catalog\": { \"react\": \"^19.0.0\" },\n" ++
        "  \"packages\": {\n" ++
        "    \"zod\": [\"zod@3.23.8\", \"https://registry.npmjs.org/zod/-/zod-3.23.8.tgz\", { \"dependencies\": { \"tslib\": \"2.6.0\" }, \"os\": [\"linux\", \"darwin\"], \"cpu\": [\"x64\", \"arm64\"], \"bin\": { \"zod-cli\": \"bin/zod.js\" } }, \"sha512-abc123\"],\n" ++
        "    \"esbuild\": [\"esbuild@0.24.0\", \"\", { \"bin\": \"bin/esbuild\" }, \"sha512-def456\"],\n" ++
        "  },\n" ++
        "}\n";

    let ws: [4]TextLockWorkspace = [TextLockWorkspace.empty(); 4];
    let pkgs: [8]TextLockPackage = [TextLockPackage.empty(); 8];
    let kvs: [32]TextLockKvPair = [TextLockKvPair.empty(); 32];
    let strs: [32][]const u8 = [""; 32];
    let cats: [8]TextLockCatalogEntry = [TextLockCatalogEntry.empty(); 8];
    let bufs = TextLockfileBuffers{
        workspaces: ws[0..],
        packages: pkgs[0..],
        kv_pairs: kvs[0..],
        string_items: strs[0..],
        catalogs: cats[0..],
    };
    let diag = TextLockParseDiag{};

    const lock = parseTextLockfile(src, &bufs, &diag) catch unreachable;
    assertEq(lock.lockfile_version, TEXT_LOCK_VERSION_CURRENT);
    assertEq(lock.config_version, @as(u32, 1));
    assertEq(lock.workspace_count, @as(usize, 2));
    assertEq(lock.package_count, @as(usize, 2));
    assertEq(lock.overrides_len, @as(usize, 1));
    assertEq(lock.patched_len, @as(usize, 1));
    assertEq(lock.trusted_len, @as(usize, 2));
    assertEq(lock.catalog_count, @as(usize, 1));

    assert(strEql(ws[0].name, "monorepo"));
    assertEq(ws[0].deps_len, @as(usize, 1));
    assertEq(ws[0].dev_deps_len, @as(usize, 1));
    assert(strEql(ws[1].rel_path, "packages/ui"));
    assertEq(ws[1].peer_deps_len, @as(usize, 1));

    assert(strEql(pkgs[0].key, "zod"));
    assert(strEql(pkgs[0].name_and_version, "zod@3.23.8"));
    assert(strEql(pkgs[0].integrity, "sha512-abc123"));
    assertEq(pkgs[0].deps_len, @as(usize, 1));
    assertEq(pkgs[0].os_len, @as(usize, 2));
    assertEq(pkgs[0].cpu_len, @as(usize, 2));
    assertEq(pkgs[0].bin_len, @as(usize, 1));
});

test("formatTextLockfile guarantees 100% deterministic parse -> format -> parse -> format roundtrip idempotence", () => {
    // Unsorted workspaces and packages in input
    const unsorted_src =
        "{\n" ++
        "  \"lockfileVersion\": 1,\n" ++
        "  \"configVersion\": 1,\n" ++
        "  \"workspaces\": {\n" ++
        "    \"packages/z\": { \"name\": \"@org/z\", \"dependencies\": { \"zod\": \"^3.0.0\", \"axios\": \"^1.0.0\" } },\n" ++
        "    \"\": { \"name\": \"root\" }\n" ++
        "  },\n" ++
        "  \"packages\": {\n" ++
        "    \"zod\": [\"zod@3.23.8\", \"\", {}, \"sha512-zzz\"],\n" ++
        "    \"axios\": [\"axios@1.7.0\", \"\", { \"dependencies\": { \"follow-redirects\": \"^1.15.0\" } }, \"sha512-aaa\"]\n" ++
        "  }\n" ++
        "}\n";

    let ws1: [4]TextLockWorkspace = [TextLockWorkspace.empty(); 4];
    let pkgs1: [8]TextLockPackage = [TextLockPackage.empty(); 8];
    let kvs1: [16]TextLockKvPair = [TextLockKvPair.empty(); 16];
    let strs1: [16][]const u8 = [""; 16];
    let cats1: [4]TextLockCatalogEntry = [TextLockCatalogEntry.empty(); 4];
    let bufs1 = TextLockfileBuffers{ workspaces: ws1[0..], packages: pkgs1[0..], kv_pairs: kvs1[0..], string_items: strs1[0..], catalogs: cats1[0..] };
    let diag1 = TextLockParseDiag{};

    const lock1 = parseTextLockfile(unsorted_src, &bufs1, &diag1) catch unreachable;
    let scratch: [32]usize = [0; 32];
    let fmt1_buf: [2048]u8 = [0; 2048];
    const fmt1_len = formatTextLockfile(lock1, bufs1, scratch[0..], fmt1_buf[0..]) catch unreachable;
    const fmt1 = fmt1_buf[0..fmt1_len];

    // Reparse formatted output and format a second time
    let ws2: [4]TextLockWorkspace = [TextLockWorkspace.empty(); 4];
    let pkgs2: [8]TextLockPackage = [TextLockPackage.empty(); 8];
    let kvs2: [16]TextLockKvPair = [TextLockKvPair.empty(); 16];
    let strs2: [16][]const u8 = [""; 16];
    let cats2: [4]TextLockCatalogEntry = [TextLockCatalogEntry.empty(); 4];
    let bufs2 = TextLockfileBuffers{ workspaces: ws2[0..], packages: pkgs2[0..], kv_pairs: kvs2[0..], string_items: strs2[0..], catalogs: cats2[0..] };
    let diag2 = TextLockParseDiag{};

    const lock2 = parseTextLockfile(fmt1, &bufs2, &diag2) catch unreachable;
    let fmt2_buf: [2048]u8 = [0; 2048];
    const fmt2_len = formatTextLockfile(lock2, bufs2, scratch[0..], fmt2_buf[0..]) catch unreachable;
    const fmt2 = fmt2_buf[0..fmt2_len];

    // Byte-for-byte idempotence!
    assert(strEql(fmt1, fmt2));
    // Verify canonical order: root "" before "packages/z", "axios" before "zod"
    assert(strEql(ws2[0].rel_path, ""));
    assert(strEql(ws2[1].rel_path, "packages/z"));
    assert(strEql(pkgs2[0].key, "axios"));
    assert(strEql(pkgs2[1].key, "zod"));
});

test("parseTextLockfile rejects unsupported lockfileVersion and reports exact line/col diagnostics", () => {
    const future_src = "{\n  \"lockfileVersion\": 99,\n  \"packages\": {}\n}\n";
    let ws: [2]TextLockWorkspace = [TextLockWorkspace.empty(); 2];
    let pkgs: [2]TextLockPackage = [TextLockPackage.empty(); 2];
    let kvs: [4]TextLockKvPair = [TextLockKvPair.empty(); 4];
    let strs: [4][]const u8 = [""; 4];
    let cats: [2]TextLockCatalogEntry = [TextLockCatalogEntry.empty(); 2];
    let bufs = TextLockfileBuffers{ workspaces: ws[0..], packages: pkgs[0..], kv_pairs: kvs[0..], string_items: strs[0..], catalogs: cats[0..] };
    let diag = TextLockParseDiag{};

    let ver_err = false;
    * = parseTextLockfile(future_src, &bufs, &diag) catch {
        ver_err = true;
    };
    assert(ver_err);
    assertEq(diag.line, @as(u32, 2));
    assert(strContains(diag.message, "lockfileVersion"));
});

test("parseTextLockfile rejects duplicate package keys", () => {
    const dup_src =
        "{\n" ++
        "  \"lockfileVersion\": 1,\n" ++
        "  \"packages\": {\n" ++
        "    \"zod\": [\"zod@3.23.0\", \"\", {}, \"sha512-a\"],\n" ++
        "    \"zod\": [\"zod@3.23.8\", \"\", {}, \"sha512-b\"]\n" ++
        "  }\n" ++
        "}\n";
    let ws: [2]TextLockWorkspace = [TextLockWorkspace.empty(); 2];
    let pkgs: [4]TextLockPackage = [TextLockPackage.empty(); 4];
    let kvs: [4]TextLockKvPair = [TextLockKvPair.empty(); 4];
    let strs: [4][]const u8 = [""; 4];
    let cats: [2]TextLockCatalogEntry = [TextLockCatalogEntry.empty(); 2];
    let bufs = TextLockfileBuffers{ workspaces: ws[0..], packages: pkgs[0..], kv_pairs: kvs[0..], string_items: strs[0..], catalogs: cats[0..] };
    let diag = TextLockParseDiag{};

    let dup_err = false;
    * = parseTextLockfile(dup_src, &bufs, &diag) catch {
        dup_err = true;
    };
    assert(dup_err);
    assertEq(diag.line, @as(u32, 5));
});

test("diffTextLockfiles accurately classifies Added, Removed, Changed, and Unchanged packages", () => {
    const old_pkgs: [3]TextLockPackage = [
        TextLockPackage{ key: "unchanged", name_and_version: "unchanged@1.0.0", integrity: "sha512-same" },
        TextLockPackage{ key: "upgraded", name_and_version: "upgraded@1.0.0", integrity: "sha512-old" },
        TextLockPackage{ key: "removed", name_and_version: "removed@2.0.0", integrity: "sha512-rem" },
    ];
    const new_pkgs: [3]TextLockPackage = [
        TextLockPackage{ key: "unchanged", name_and_version: "unchanged@1.0.0", integrity: "sha512-same" },
        TextLockPackage{ key: "upgraded", name_and_version: "upgraded@1.1.0", integrity: "sha512-new" },
        TextLockPackage{ key: "added", name_and_version: "added@3.0.0", integrity: "sha512-add" },
    ];

    let diffs: [8]TextLockDiffEntry = [TextLockDiffEntry.empty(); 8];
    const sum = diffTextLockfiles(old_pkgs[0..], new_pkgs[0..], diffs[0..]) catch unreachable;

    assertEq(sum.added, @as(u32, 1));
    assertEq(sum.removed, @as(u32, 1));
    assertEq(sum.changed, @as(u32, 1));
    assertEq(sum.unchanged, @as(u32, 1));
    assertEq(sum.total_diffs, @as(usize, 3));

    assert(diffs[0].kind == TextLockDiffKind.Changed && strEql(diffs[0].package_key, "upgraded"));
    assert(diffs[1].kind == TextLockDiffKind.Removed && strEql(diffs[1].package_key, "removed"));
    assert(diffs[2].kind == TextLockDiffKind.Added && strEql(diffs[2].package_key, "added"));
});

test("parseTextLockfile safely skips unknown nested extension fields and rejects excessive nesting", () => {
    const ext_src = "{\n  \"lockfileVersion\": 1,\n  \"customMeta\": { \"nested\": [1, true, null, { \"k\": \"v\" }] },\n  \"packages\": {}\n}\n";
    let ws: [2]TextLockWorkspace = [TextLockWorkspace.empty(); 2];
    let pkgs: [2]TextLockPackage = [TextLockPackage.empty(); 2];
    let kvs: [4]TextLockKvPair = [TextLockKvPair.empty(); 4];
    let strs: [4][]const u8 = [""; 4];
    let cats: [2]TextLockCatalogEntry = [TextLockCatalogEntry.empty(); 2];
    let bufs = TextLockfileBuffers{ workspaces: ws[0..], packages: pkgs[0..], kv_pairs: kvs[0..], string_items: strs[0..], catalogs: cats[0..] };
    let diag = TextLockParseDiag{};

    const lock = parseTextLockfile(ext_src, &bufs, &diag) catch unreachable;
    assertEq(lock.lockfile_version, @as(u32, 1));
});

test("deterministic 500-iteration fuzz over truncated and malformed JSONC lockfiles causes 0 panics", () => {
    let seed: u64 = 0x9e3779b97f4a7c15;
    const base_valid =
        "// comment\n" ++
        "{\n" ++
        "  \"lockfileVersion\": 1,\n" ++
        "  \"workspaces\": { \"\": { \"name\": \"a\", \"dependencies\": { \"x\": \"1.0.0\" } } },\n" ++
        "  \"packages\": { \"x\": [\"x@1.0.0\", \"\", { \"os\": [\"linux\"] }, \"sha512-1\"] }\n" ++
        "}\n";

    const mutations: [8]u8 = ['{', '}', '[', ']', '"', ',', '/', '*'];

    let ws: [4]TextLockWorkspace = [TextLockWorkspace.empty(); 4];
    let pkgs: [4]TextLockPackage = [TextLockPackage.empty(); 4];
    let kvs: [8]TextLockKvPair = [TextLockKvPair.empty(); 8];
    let strs: [8][]const u8 = [""; 8];
    let cats: [4]TextLockCatalogEntry = [TextLockCatalogEntry.empty(); 4];
    let scratch_src: [256]u8 = [0; 256];
    let diag = TextLockParseDiag{};

    let iter: u32 = 0;
    let parsed_ok: u32 = 0;
    let parsed_err: u32 = 0;

    while (iter < 500) {
        seed = seed ^ (seed >> 12);
        seed = seed ^ (seed << 25);
        seed = seed ^ (seed >> 27);
        let r = seed *% 2685821657736338717;

        const cut_len: usize = @as(usize, @intCast(r % (base_valid.len + 1)));
        let i: usize = 0;
        while (i < cut_len) {
            scratch_src[i] = base_valid[i];
            i += 1;
        }
        // Randomly corrupt 1..3 bytes
        if (cut_len > 0 && (r & 3) != 0) {
            let m: u32 = 0;
            while (m < 2) {
                r = r *% 6364136223846793005 +% 1442695040888963407;
                const idx = @as(usize, @intCast((r >> 16) % cut_len));
                scratch_src[idx] = mutations[@as(usize, @intCast((r >> 8) % 8))];
                m += 1;
            }
        }

        let bufs = TextLockfileBuffers{
            workspaces: ws[0..],
            packages: pkgs[0..],
            kv_pairs: kvs[0..],
            string_items: strs[0..],
            catalogs: cats[0..],
        };
        const res = parseTextLockfile(scratch_src[0..cut_len], &bufs, &diag) catch null;
        if (res != null) {
            parsed_ok += 1;
        } else {
            parsed_err += 1;
            assert(diag.line >= 1);
            assert(diag.col >= 1);
        }
        iter += 1;
    }

    assert(parsed_err > 400);
    assert(parsed_ok + parsed_err == 500);
});
