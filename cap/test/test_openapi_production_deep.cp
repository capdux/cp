// Source: cp/cap/test/test_openapi_production_deep.cp
// Deep Production Test Suite for cap:openapi
// Covers:
//   1. Full OpenAPI 3.1.0 spec construction & JSON export verified via cap:json
//   2. Malformed path templates, invalid status codes & duplicate operationId interception
//   3. Path template routing priority (static > {param}), param extraction, 404 vs 405
//   4. Request contract validation (missing required query/header, integer/boolean types, requestBody)
//   5. Dynamic lazy namespace mounting via `import cap from "cap"; cap.openapi`

const std = @import("std");
import { test, expect_eq } from "cap:test";
import { JsonParser } from "cap:json";
import {
    OpenApiError,
    HttpMethod,
    ParamIn,
    SecuritySchemeType,
    OpenApiInfo,
    OpenApiParam,
    OpenApiResponse,
    OpenApiSecurityScheme,
    OpenApiOperation,
    OpenApiDoc,
    KeyValuePair,
    MatchStatus,
    OpenApiValidator,
} from "cap:web";
import cap from "cap";

fn testSpecBuildAndJsonExport()! {
    const alloc = std.heap.page_allocator;

    const info = OpenApiInfo.init("Agent Gateway API", "3.1.0")
        .withSummary("CP Agent Runtime API")
        .withDescription("OpenAPI 3.1.0 specification generated by cap:openapi")
        .withContact("CP Team", "dev@cp-lang.org", "https://cp-lang.org")
        .withLicense("Apache 2.0", "Apache-2.0", "https://www.apache.org/licenses/LICENSE-2.0");

    let doc = OpenApiDoc.init(alloc, info)?;
    defer doc.deinit();

    doc.setJsonSchemaDialect("https://spec.openapis.org/oas/3.1/dialect/base")?;
    doc.addServer("https://api.cp-lang.org/v1", "Production Cluster")?;
    doc.addServer("http://127.0.0.1:8080", "Local Dev")?;
    doc.addTag("users", "User management endpoints")?;
    doc.addTag("agents", "AI Agent execution endpoints")?;

    doc.addSecurityScheme(
        OpenApiSecurityScheme.bearer("bearerAuth", "JWT")
            .withDescription("Bearer JWT authentication"),
    )?;
    doc.addSecurityScheme(
        OpenApiSecurityScheme.apiKey("apiKeyAuth", "X-API-Key", .Header)
            .withDescription("Service API key header"),
    )?;

    doc.registerComponentSchema(
        "User",
        "{\"type\":\"object\",\"required\":[\"id\",\"email\"],\"properties\":{\"id\":{\"type\":\"string\",\"format\":\"uuid\"},\"email\":{\"type\":\"string\",\"format\":\"email\"}}}",
    )?;
    doc.registerComponentSchema(
        "CreateUserInput",
        "{\"type\":\"object\",\"required\":[\"email\"],\"properties\":{\"email\":{\"type\":\"string\",\"format\":\"email\"}}}",
    )?;

    const list_tags: [1][]const u8 = ["users"];
    const list_params: [1]OpenApiParam = [
        OpenApiParam.query("limit", false, "integer").withDescription("Max items to return"),
    ];
    const list_resps: [1]OpenApiResponse = [
        OpenApiResponse.jsonSchema("200", "User list", "{\"type\":\"array\",\"items\":{\"$ref\":\"#/components/schemas/User\"}}"),
    ];
    const list_sec: [1][]const u8 = ["bearerAuth"];
    doc.addOperation(
        "/users",
        .Get,
        OpenApiOperation.init("listUsers")
            .withSummary("List all users")
            .withTags(&list_tags)
            .withParams(&list_params)
            .withResponses(&list_resps)
            .withSecurity(&list_sec),
    )?;

    const create_resps: [2]OpenApiResponse = [
        OpenApiResponse.jsonRef("201", "User created", "User"),
        OpenApiResponse.init("400", "Validation error"),
    ];
    const create_sec: [1][]const u8 = ["apiKeyAuth"];
    doc.addOperation(
        "/users",
        .Post,
        OpenApiOperation.init("createUser")
            .withSummary("Create user")
            .withTags(&list_tags)
            .withRequestBodyRef("CreateUserInput", true)
            .withResponses(&create_resps)
            .withSecurity(&create_sec),
    )?;

    const get_params: [1]OpenApiParam = [
        OpenApiParam.path("id", "string").withFormat("uuid"),
    ];
    const get_resps: [2]OpenApiResponse = [
        OpenApiResponse.jsonRef("200", "User details", "User"),
        OpenApiResponse.init("404", "User not found"),
    ];
    doc.addOperation(
        "/users/{id}",
        .Get,
        OpenApiOperation.init("getUserById")
            .withTags(&list_tags)
            .withParams(&get_params)
            .withResponses(&get_resps),
    )?;

    expect_eq(doc.endpointCount(), 3 as usize);

    const json_bytes = doc.toJson(alloc)?;
    defer alloc.free(json_bytes);

    let parse_arena = std.heap.ArenaAllocator.init(alloc);
    defer parse_arena.deinit();
    const root = JsonParser.parse(parse_arena.allocator(), json_bytes) catch unreachable;

    expect_eq(root.isObject(), true);
    expect_eq(std.mem.eql(u8, root.get("openapi").?.asString().?, "3.1.0"), true);
    expect_eq(std.mem.eql(u8, root.get("jsonSchemaDialect").?.asString().?, "https://spec.openapis.org/oas/3.1/dialect/base"), true);

    const info_obj = root.get("info").?;
    expect_eq(std.mem.eql(u8, info_obj.get("title").?.asString().?, "Agent Gateway API"), true);
    expect_eq(std.mem.eql(u8, info_obj.get("license").?.get("identifier").?.asString().?, "Apache-2.0"), true);
    expect_eq(std.mem.eql(u8, info_obj.get("contact").?.get("email").?.asString().?, "dev@cp-lang.org"), true);

    expect_eq(root.get("servers").?.len(), 2 as usize);
    expect_eq(root.get("tags").?.len(), 2 as usize);

    const paths = root.get("paths").?;
    const users_item = paths.get("/users").?;
    expect_eq(std.mem.eql(u8, users_item.get("get").?.get("operationId").?.asString().?, "listUsers"), true);
    expect_eq(std.mem.eql(u8, users_item.get("post").?.get("operationId").?.asString().?, "createUser"), true);
    expect_eq(users_item.get("post").?.get("requestBody").?.get("required").?.asBool().?, true);
    expect_eq(
        std.mem.eql(
            u8,
            users_item.get("post").?.get("requestBody").?.get("content").?.get("application/json").?.get("schema").?.get("$ref").?.asString().?,
            "#/components/schemas/CreateUserInput",
        ),
        true,
    );

    const user_by_id = paths.get("/users/{id}").?.get("get").?;
    expect_eq(std.mem.eql(u8, user_by_id.get("operationId").?.asString().?, "getUserById"), true);
    expect_eq(user_by_id.get("parameters").?.getIndex(0).?.get("required").?.asBool().?, true);
    expect_eq(std.mem.eql(u8, user_by_id.get("parameters").?.getIndex(0).?.get("in").?.asString().?, "path"), true);

    const comps = root.get("components").?;
    expect_eq(comps.get("schemas").?.get("User").?.isObject(), true);
    expect_eq(std.mem.eql(u8, comps.get("securitySchemes").?.get("bearerAuth").?.get("scheme").?.asString().?, "bearer"), true);
    expect_eq(std.mem.eql(u8, comps.get("securitySchemes").?.get("apiKeyAuth").?.get("name").?.asString().?, "X-API-Key"), true);
    expect_eq(std.mem.eql(u8, comps.get("securitySchemes").?.get("apiKeyAuth").?.get("in").?.asString().?, "header"), true);
}

fn expectAddOpError(
    doc: *OpenApiDoc,
    path: []const u8,
    method: HttpMethod,
    op: OpenApiOperation,
    expected_err: []const u8,
): ! {
    let matched = false;
    doc.addOperation(path, method, op) catch e => {
        matched = std.mem.eql(u8, @errorName(e), expected_err);
    };
    expect_eq(matched, true);
}

fn testInvalidPathsStatusAndDuplicateOpId()! {
    const alloc = std.heap.page_allocator;
    let doc = OpenApiDoc.init(alloc, OpenApiInfo.init("Strict Spec", "1.0.0"))?;
    defer doc.deinit();

    // 1. Missing leading '/'
    expectAddOpError(&doc, "users/list", .Get, OpenApiOperation.init("noSlash"), "InvalidPath")?;

    // 2. Empty path
    expectAddOpError(&doc, "", .Get, OpenApiOperation.init("emptyPath"), "InvalidPath")?;

    // 3. Unclosed '{id'
    expectAddOpError(&doc, "/users/{id", .Get, OpenApiOperation.init("unclosedBrace"), "InvalidPath")?;

    // 4. Empty '{}'
    expectAddOpError(&doc, "/users/{}", .Get, OpenApiOperation.init("emptyBrace"), "InvalidPath")?;

    // 5. Stray '}'
    expectAddOpError(&doc, "/users/id}", .Get, OpenApiOperation.init("strayBrace"), "InvalidPath")?;

    // 6. Duplicate param name within same path
    expectAddOpError(&doc, "/orgs/{id}/repos/{id}", .Get, OpenApiOperation.init("dupParam"), "InvalidPath")?;

    // 7. Invalid HTTP status code
    const bad_resps: [1]OpenApiResponse = [OpenApiResponse.init("999", "Invalid")];
    expectAddOpError(
        &doc,
        "/health",
        .Get,
        OpenApiOperation.init("healthCheck").withResponses(&bad_resps),
        "InvalidStatusCode",
    )?;

    // 8. Duplicate operationId interception
    doc.addOperation("/v1/ping", .Get, OpenApiOperation.init("pingOp"))?;
    expectAddOpError(&doc, "/v2/ping", .Post, OpenApiOperation.init("pingOp"), "DuplicateOperationId")?;
    expect_eq(doc.endpointCount(), 1 as usize);
}

fn checkMatchStatus(
    alloc: std.mem.Allocator,
    validator: OpenApiValidator,
    method: HttpMethod,
    path: []const u8,
): u16! {
    let rm = validator.matchRoute(alloc, method, path) catch e => {
        if (std.mem.eql(u8, @errorName(e), "RouteNotFound")) return 404;
        if (std.mem.eql(u8, @errorName(e), "MethodNotAllowed")) return 405;
        return e;
    };
    rm.deinit();
    return 200;
}

fn testRoutingSpecificityAnd404Vs405()! {
    const alloc = std.heap.page_allocator;
    let doc = OpenApiDoc.init(alloc, OpenApiInfo.init("Router API", "1.0.0"))?;
    defer doc.deinit();

    // Register parameterized route BEFORE static route to prove specificity overrides insertion order
    doc.addOperation("/users/{id}", .Get, OpenApiOperation.init("getUser"))?;
    doc.addOperation("/users/{id}", .Delete, OpenApiOperation.init("deleteUser"))?;
    doc.addOperation("/users/me", .Get, OpenApiOperation.init("getMe"))?;
    doc.addOperation("/orgs/{org}/repos/{repo}", .Get, OpenApiOperation.init("getRepo"))?;
    doc.addOperation("/orgs/{org}/repos/featured", .Get, OpenApiOperation.init("getFeaturedRepo"))?;

    const validator = OpenApiValidator.init(&doc);

    // 1. Static segment wins over {id}
    let m_me = validator.matchRoute(alloc, .Get, "/users/me")?;
    defer m_me.deinit();
    expect_eq(std.mem.eql(u8, m_me.operation_id, "getMe"), true);
    expect_eq(m_me.path_params.len, 0 as usize);

    // 2. Parameterized match extracts {id}
    let m_user = validator.matchRoute(alloc, .Get, "/users/usr_9981")?;
    defer m_user.deinit();
    expect_eq(std.mem.eql(u8, m_user.operation_id, "getUser"), true);
    expect_eq(std.mem.eql(u8, m_user.getParam("id").?, "usr_9981"), true);

    // 3. Multi-param template with query string stripped
    let m_repo = validator.matchRoute(alloc, .Get, "/orgs/cp-lang/repos/compiler?branch=main")?;
    defer m_repo.deinit();
    expect_eq(std.mem.eql(u8, m_repo.operation_id, "getRepo"), true);
    expect_eq(std.mem.eql(u8, m_repo.getParam("org").?, "cp-lang"), true);
    expect_eq(std.mem.eql(u8, m_repo.getParam("repo").?, "compiler"), true);

    // 4. Static tail wins over {repo} while still capturing {org}
    let m_feat = validator.matchRoute(alloc, .Get, "/orgs/cp-lang/repos/featured")?;
    defer m_feat.deinit();
    expect_eq(std.mem.eql(u8, m_feat.operation_id, "getFeaturedRepo"), true);
    expect_eq(std.mem.eql(u8, m_feat.getParam("org").?, "cp-lang"), true);

    // 5. 404 RouteNotFound
    const st_404 = checkMatchStatus(alloc, validator, .Get, "/nonexistent/resource")?;
    expect_eq(st_404, 404 as u16);

    let ex_404 = validator.matchRouteEx(alloc, .Get, "/nonexistent/resource")?;
    defer ex_404.deinit();
    expect_eq(ex_404.status == .NotFound, true);
    expect_eq(ex_404.allowed_methods.len, 0 as usize);

    // 6. 405 MethodNotAllowed with allowed_methods list [Get, Delete]
    let ex_405 = validator.matchRouteEx(alloc, .Post, "/users/42")?;
    defer ex_405.deinit();
    expect_eq(ex_405.status == .MethodNotAllowed, true);
    expect_eq(ex_405.allowed_methods.len, 2 as usize);
    expect_eq(ex_405.allowed_methods[0] == .Get, true);
    expect_eq(ex_405.allowed_methods[1] == .Delete, true);

    const st_405 = checkMatchStatus(alloc, validator, .Patch, "/users/42")?;
    expect_eq(st_405, 405 as u16);

    const allowed_list = validator.allowedMethods(alloc, "/users/42")?;
    defer alloc.free(allowed_list);
    expect_eq(allowed_list.len, 2 as usize);
}

fn testRequestContractValidation()! {
    const alloc = std.heap.page_allocator;
    let doc = OpenApiDoc.init(alloc, OpenApiInfo.init("Contract API", "1.0.0"))?;
    defer doc.deinit();

    const params: [4]OpenApiParam = [
        OpenApiParam.path("org", "string"),
        OpenApiParam.path("item_id", "integer"),
        OpenApiParam.query("limit", true, "integer"),
        OpenApiParam.query("dry_run", false, "boolean"),
    ];
    const params_with_hdr: [5]OpenApiParam = [
        params[0],
        params[1],
        params[2],
        params[3],
        OpenApiParam.header("X-Trace-Id", true, "string"),
    ];
    doc.addOperation(
        "/orgs/{org}/items/{item_id}",
        .Post,
        OpenApiOperation.init("createOrgItem")
            .withParams(&params_with_hdr)
            .withRequestBodyRequired(true),
    )?;

    const validator = OpenApiValidator.init(&doc);

    // 1. Failing request: bad integer path param, missing required query `limit`,
    //    bad boolean `dry_run`, missing required header `X-Trace-Id`, missing body
    const bad_query: [1]KeyValuePair = [
        KeyValuePair{ key: "dry_run", value: "not_a_bool" },
    ];
    let bad_rep = validator.validateRequest(
        alloc,
        .Post,
        "/orgs/acme/items/abc123",
        &bad_query,
        [],
        false,
    )?;
    defer bad_rep.deinit();

    expect_eq(bad_rep.valid, false);
    expect_eq(bad_rep.status_code, 400 as u16);
    expect_eq(std.mem.eql(u8, bad_rep.operation_id, "createOrgItem"), true);
    expect_eq(bad_rep.hasError("invalid_param_type", "item_id"), true);
    expect_eq(bad_rep.hasError("missing_required_param", "limit"), true);
    expect_eq(bad_rep.hasError("invalid_param_type", "dry_run"), true);
    expect_eq(bad_rep.hasError("missing_required_param", "X-Trace-Id"), true);
    expect_eq(bad_rep.hasError("missing_request_body", "body"), true);
    expect_eq(bad_rep.errorCount(), 5 as usize);

    // 2. Compliant request (case-insensitive header match)
    const ok_query: [2]KeyValuePair = [
        KeyValuePair{ key: "limit", value: "25" },
        KeyValuePair{ key: "dry_run", value: "true" },
    ];
    const ok_headers: [1]KeyValuePair = [
        KeyValuePair{ key: "x-trace-id", value: "trace-001" },
    ];
    let ok_rep = validator.validateRequest(
        alloc,
        .Post,
        "/orgs/acme/items/9001",
        &ok_query,
        &ok_headers,
        true,
    )?;
    defer ok_rep.deinit();

    expect_eq(ok_rep.valid, true);
    expect_eq(ok_rep.status_code, 200 as u16);
    expect_eq(ok_rep.errorCount(), 0 as usize);
    expect_eq(std.mem.eql(u8, ok_rep.operation_id, "createOrgItem"), true);
    expect_eq(std.mem.eql(u8, ok_rep.getPathParam("org").?, "acme"), true);
    expect_eq(std.mem.eql(u8, ok_rep.getPathParam("item_id").?, "9001"), true);

    // 3. 405 MethodNotAllowed via validateRequest
    let mna_rep = validator.validateRequest(alloc, .Get, "/orgs/acme/items/9001", [], [], false)?;
    defer mna_rep.deinit();
    expect_eq(mna_rep.valid, false);
    expect_eq(mna_rep.status_code, 405 as u16);
    expect_eq(mna_rep.allowed_methods.len, 1 as usize);
    expect_eq(mna_rep.allowed_methods[0] == .Post, true);
}

fn testCapOpenApiLazyMount()! {
    const alloc = std.heap.page_allocator;

    let doc = cap.web.OpenApiDoc.init(
        alloc,
        cap.web.OpenApiInfo.init("Lazy Mount API", "0.1.0"),
    )?;
    defer doc.deinit();

    const p: [1]cap.web.OpenApiParam = [
        cap.web.OpenApiParam.path("tool", "string"),
        // Single element
    ];
    const q: [1]cap.web.OpenApiParam = [
        cap.web.OpenApiParam.query("timeout_ms", true, "integer"),
    ];
    let params_all: [2]cap.web.OpenApiParam = [p[0], q[0]];
    doc.addOperation(
        "/tools/{tool}/invoke",
        .Post,
        cap.web.OpenApiOperation.init("invokeTool")
            .withParams(&params_all)
            .withRequestBodyRequired(true),
    )?;

    const spec_json = doc.toJson(alloc)?;
    defer alloc.free(spec_json);
    expect_eq(std.mem.indexOf(u8, spec_json, "\"operationId\":\"invokeTool\"") != null, true);

    const validator = cap.web.OpenApiValidator.init(&doc);
    const req_q: [1]cap.web.KeyValuePair = [
        cap.web.KeyValuePair{ key: "timeout_ms", value: "1500" },
    ];
    let rep = validator.validateRequest(alloc, .Post, "/tools/web_search/invoke", &req_q, [], true)?;
    defer rep.deinit();
    expect_eq(rep.valid, true);
    expect_eq(std.mem.eql(u8, rep.getPathParam("tool").?, "web_search"), true);
}

fn main() {
    test("1. Full OpenAPI 3.1.0 Spec Construction & cap:json Verification", () => {
        testSpecBuildAndJsonExport()?;
    });

    test("2. Malformed Paths, Invalid Status Codes & Duplicate operationId Interception", () => {
        testInvalidPathsStatusAndDuplicateOpId()?;
    });

    test("3. Path Template Specificity (Static > Param), Param Extraction & 404 vs 405", () => {
        testRoutingSpecificityAnd404Vs405()?;
    });

    test("4. Request Contract Validation (Required Params, Types & RequestBody)", () => {
        testRequestContractValidation()?;
    });

    test("5. Dynamic Lazy Namespace Mounting via `import cap from \"cap\"; cap.openapi`", () => {
        testCapOpenApiLazyMount()?;
    });
}
