// Source: cp/cap/test/test_sam_production_deep.cp
// Deep Production Test Suite for cap:sam
// Covers:
//   1. @HD/@SQ/@RG/@CO header iteration & findSamHeaderTag extraction
//   2. Alignment record 11-column parsing, 12 FLAG helpers & optional TAG:TYPE:VALUE lookup
//   3. CigarIter, cigarRefLen & cigarQueryLen across all 9 SAM v1.6 CIGAR ops + "*"
//   4. Single-pass summarizeSam statistics across mapped/unmapped/paired/reverse/duplicate/secondary reads
//   5. Fewer than 11 columns, invalid FLAG/MAPQ & malformed CIGAR (0M, bad op, overflow) guards

const std = @import("std");
import { test, expect_eq } from "cap:test";
import {
    SAM_FLAG_PAIRED,
    SAM_FLAG_PROPER_PAIR,
    SAM_FLAG_UNMAPPED,
    SAM_FLAG_MATE_UNMAPPED,
    SAM_FLAG_REVERSE,
    SAM_FLAG_MATE_REVERSE,
    SAM_FLAG_READ1,
    SAM_FLAG_READ2,
    SAM_FLAG_SECONDARY,
    SAM_FLAG_QC_FAIL,
    SAM_FLAG_DUPLICATE,
    SAM_FLAG_SUPPLEMENTARY,
    CigarOp,
    SamHeaderLine,
    SamRecord,
    SamStats,
    CigarIter,
    SamHeaderIter,
    SamRecordIter,
    cigarRefLen,
    cigarQueryLen,
    findSamHeaderTag,
    parseSamLine,
    summarizeSam,
} from "cap:science";

const SAMPLE_SAM: []const u8 =
    "@HD\tVN:1.6\tSO:coordinate\r\n" ++
    "@SQ\tSN:chr1\tLN:248956422\r\n" ++
    "@RG\tID:rg01\tSM:NA12878\r\n" ++
    "@CO\tGenerated by CP SAM test suite\n" ++
    "read1\t99\tchr1\t100\t60\t50M2I10D5S\t=\t300\t250\tACGT\tIIII\tNM:i:3\tMD:Z:50^ACGTACGTAC\tRG:Z:rg01\r\n" ++
    "read2\t147\tchr1\t300\t60\t50M\t=\t100\t-250\tTGCA\tFFFF\tNM:i:0\n" ++
    "read3\t4\t*\t0\t0\t*\t*\t0\t0\tNNNN\t####\n" ++
    "read4\t1280\tchr1\t500\t30\t20=1X5H\t*\t0\t0\tACGT\tIIII\n" ++
    "read5\t2064\tchr1\t600\t40\t10M100N10M\t*\t0\t0\tACGT\tIIII\n";

fn testSamHeaderAndTags() {
    let hit = SamHeaderIter.init(SAMPLE_SAM);

    const h0 = hit.next().?;
    expect_eq(std.mem.eql(u8, h0.record_type, "HD"), true);
    expect_eq(std.mem.eql(u8, findSamHeaderTag(h0.fields_slice, "VN").?, "1.6"), true);
    expect_eq(std.mem.eql(u8, findSamHeaderTag(h0.fields_slice, "SO").?, "coordinate"), true);
    expect_eq(findSamHeaderTag(h0.fields_slice, "XX") == null, true);

    const h1 = hit.next().?;
    expect_eq(std.mem.eql(u8, h1.record_type, "SQ"), true);
    expect_eq(std.mem.eql(u8, findSamHeaderTag(h1.fields_slice, "SN").?, "chr1"), true);
    expect_eq(std.mem.eql(u8, findSamHeaderTag(h1.fields_slice, "LN").?, "248956422"), true);

    const h2 = hit.next().?;
    expect_eq(std.mem.eql(u8, h2.record_type, "RG"), true);
    expect_eq(std.mem.eql(u8, findSamHeaderTag(h2.fields_slice, "ID").?, "rg01"), true);
    expect_eq(std.mem.eql(u8, findSamHeaderTag(h2.fields_slice, "SM").?, "NA12878"), true);

    const h3 = hit.next().?;
    expect_eq(std.mem.eql(u8, h3.record_type, "CO"), true);
    expect_eq(std.mem.eql(u8, h3.fields_slice, "Generated by CP SAM test suite"), true);

    // Stops cleanly at first alignment line
    expect_eq(hit.next() == null, true);
}

fn testAlignmentRecordsFlagsAndTags() {
    let rit = SamRecordIter.init(SAMPLE_SAM);

    // read1: flag 99 = PAIRED(1) | PROPER_PAIR(2) | MATE_REVERSE(32) | READ1(64)
    const r1 = rit.next().?;
    expect_eq(std.mem.eql(u8, r1.qname, "read1"), true);
    expect_eq(r1.flag, 99);
    expect_eq(std.mem.eql(u8, r1.rname, "chr1"), true);
    expect_eq(r1.pos, 100);
    expect_eq(r1.mapq, 60);
    expect_eq(r1.pnext, 300);
    expect_eq(r1.tlen, 250);
    expect_eq(r1.isMapped(), true);
    expect_eq(r1.isPaired(), true);
    expect_eq(r1.isProperPair(), true);
    expect_eq(r1.isReverse(), false);
    expect_eq(std.mem.eql(u8, r1.findTag("NM").?, "3"), true);
    expect_eq(std.mem.eql(u8, r1.findTag("MD").?, "50^ACGTACGTAC"), true);
    expect_eq(std.mem.eql(u8, r1.findTag("RG").?, "rg01"), true);
    expect_eq(r1.findTag("ZZ") == null, true);

    // read2: flag 147 = PAIRED(1) | PROPER_PAIR(2) | REVERSE(16) | READ2(128)
    const r2 = rit.next().?;
    expect_eq(r2.isReverse(), true);
    expect_eq(r2.tlen, -250);
    expect_eq(std.mem.eql(u8, r2.findTag("NM").?, "0"), true);

    // read3: flag 4 = UNMAPPED
    const r3 = rit.next().?;
    expect_eq(r3.isMapped(), false);
    expect_eq(r3.pos, 0);

    // read4: flag 1280 = SECONDARY(256) | DUPLICATE(1024)
    const r4 = rit.next().?;
    expect_eq(r4.isSecondary(), true);
    expect_eq(r4.isDuplicate(), true);
    expect_eq(r4.isSupplementary(), false);

    // read5: flag 2064 = REVERSE(16) | SUPPLEMENTARY(2048)
    const r5 = rit.next().?;
    expect_eq(r5.isReverse(), true);
    expect_eq(r5.isSupplementary(), true);

    expect_eq(rit.next() == null, true);
}

fn testCigarAllOpsAndSpanCalculation() {
    // Exercise all 9 valid CIGAR ops: M, I, D, N, S, H, P, =, X
    const full_cigar = "10M2I3D4N5S6H7P8=9X";
    let it = CigarIter.init(full_cigar);

    const o0 = it.next().?;
    expect_eq(o0.len, 10);
    expect_eq(o0.op, 'M');

    const o1 = it.next().?;
    expect_eq(o1.len, 2);
    expect_eq(o1.op, 'I');

    let count: usize = 2;
    while (op := it.next()) {
        * = op;
        count += 1;
    }
    expect_eq(count, 9);
    expect_eq(it.had_error, false);

    // Ref-consuming: M(10) + D(3) + N(4) + =(8) + X(9) = 34
    expect_eq(cigarRefLen(full_cigar).?, 34);
    // Query-consuming: M(10) + I(2) + S(5) + =(8) + X(9) = 34
    expect_eq(cigarQueryLen(full_cigar).?, 34);

    // Unavailable CIGAR "*"
    let star_it = CigarIter.init("*");
    expect_eq(star_it.next() == null, true);
    expect_eq(star_it.had_error, false);
    expect_eq(cigarRefLen("*").?, 0);
    expect_eq(cigarQueryLen("*").?, 0);
}

fn testSummarizeSamStats() {
    const st = summarizeSam(SAMPLE_SAM).?;
    expect_eq(st.total_reads, 5);
    expect_eq(st.mapped_reads, 4);
    expect_eq(st.unmapped_reads, 1);
    expect_eq(st.paired_reads, 2);
    expect_eq(st.proper_pair_reads, 2);
    expect_eq(st.reverse_reads, 2);
    expect_eq(st.duplicate_reads, 1);
    expect_eq(st.secondary_reads, 1);
}

fn testMalformedSamAndCigarGuards() {
    // Fewer than 11 mandatory columns
    expect_eq(parseSamLine("r1\t0\tchr1\t10\t60\t10M") == null, true);
    // Header line rejected by parseSamLine
    expect_eq(parseSamLine("@HD\tVN:1.6") == null, true);
    // Invalid FLAG (> u16 or non-numeric)
    expect_eq(parseSamLine("r1\t99999\tchr1\t10\t60\t10M\t*\t0\t0\tA\tI") == null, true);
    expect_eq(parseSamLine("r1\tABC\tchr1\t10\t60\t10M\t*\t0\t0\tA\tI") == null, true);
    // Invalid MAPQ (> 255)
    expect_eq(parseSamLine("r1\t0\tchr1\t10\t300\t10M\t*\t0\t0\tA\tI") == null, true);
    // Invalid CIGAR inside alignment line
    expect_eq(parseSamLine("r1\t0\tchr1\t10\t60\t10Q\t*\t0\t0\tA\tI") == null, true);

    // Malformed CIGAR strings
    expect_eq(cigarRefLen("") == null, true);
    expect_eq(cigarRefLen("0M") == null, true);
    expect_eq(cigarRefLen("50Z") == null, true);
    expect_eq(cigarRefLen("50") == null, true);
    expect_eq(cigarQueryLen("99999999999M") == null, true); // u32 overflow

    // summarizeSam returns null on malformed alignment line
    expect_eq(summarizeSam("@HD\tVN:1.6\nBROKEN_LINE\n") == null, true);
}

test("1. SAM @HD/@SQ/@RG/@CO Header Iteration & Tag Extraction", () => {
    testSamHeaderAndTags();
});

test("2. 11-Column Alignment Record, FLAG Bitmasks & Optional TAG Lookup", () => {
    testAlignmentRecordsFlagsAndTags();
});

test("3. CigarIter, cigarRefLen & cigarQueryLen Across All 9 CIGAR Ops", () => {
    testCigarAllOpsAndSpanCalculation();
});

test("4. Single-Pass summarizeSam Alignment Statistics", () => {
    testSummarizeSamStats();
});

test("5. Malformed Columns, Invalid FLAG/MAPQ & Invalid CIGAR Guards", () => {
    testMalformedSamAndCigarGuards();
});
