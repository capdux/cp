// Production Deep Tests for cap:pkg YarnLockPrinter (lib/pkg/yarn_lock_printer.cp)
import { test, expect_eq } from "cap:test";
import {
    MAX_YARN_LOCK_PACKAGES,
    YarnPrintError,
    YarnLockDepKind,
    YarnLockDep,
    YarnLockPackage,
    mustQuoteYarnName,
    mustQuoteYarnKey,
    YarnLockPrinter,
} from "cap:pkg";

test("pkg yarn_lock_printer: YAML quoting rules for scoped names, ranges, and npm: aliases", fn() {
    expect_eq(mustQuoteYarnName("lodash"), false);
    expect_eq(mustQuoteYarnName("@babel/core"), true);
    expect_eq(mustQuoteYarnName("has space"), true);
    expect_eq(mustQuoteYarnName("a:b"), true);

    // Exact semver without special chars doesn't require quotes for unscoped pkg
    expect_eq(mustQuoteYarnKey("lodash", "4.17.21"), false);
    // Caret, tilde, space, npm: alias, or scoped package requires quotes
    expect_eq(mustQuoteYarnKey("lodash", "^4.17.21"), true);
    expect_eq(mustQuoteYarnKey("lodash", "npm:lodash-es@4.17.21"), true);
    expect_eq(mustQuoteYarnKey("@babel/core", "7.26.0"), true);
});

test("pkg yarn_lock_printer: full yarn.lock v1 output with header, integrity & dep sections", fn() {
    let printer = YarnLockPrinter.init("0123456789abcdef");

    const specs = ["^7.25.0", "7.26.0", "^7.25.0"]; // duplicate "^7.25.0" must be deduplicated
    const deps = [
        YarnLockDep{ name: "@babel/parser", spec: "^7.26.0", kind: .prod },
        YarnLockDep{ name: "semver", spec: "^6.3.1", kind: .prod },
        YarnLockDep{ name: "fsevents", spec: "^2.3.3", kind: .optional },
    ];
    printer.addPackage(YarnLockPackage{
        name: "@babel/core",
        version: "7.26.0",
        resolved_url: "https://registry.npmjs.org/@babel/core/-/core-7.26.0.tgz",
        integrity: "sha512-xyz123==",
        requested_specs: specs[0..],
        dependencies: deps[0..],
    }) catch unreachable;

    let buf: [1024]u8 = undefined;
    const out = printer.printToBuffer(buf[0..]) catch unreachable;

    const expected =
        "# THIS IS AN AUTOGENERATED FILE. DO NOT EDIT THIS FILE DIRECTLY.\n" ++
        "# yarn lockfile v1\n" ++
        "# bun ./bun.lockb --hash: 0123456789abcdef\n" ++
        "\n" ++
        "\"@babel/core@^7.25.0\", \"@babel/core@7.26.0\":\n" ++
        "  version \"7.26.0\"\n" ++
        "  resolved \"https://registry.npmjs.org/@babel/core/-/core-7.26.0.tgz\"\n" ++
        "  integrity sha512-xyz123==\n" ++
        "  dependencies:\n" ++
        "    \"@babel/parser\" \"^7.26.0\"\n" ++
        "    semver \"^6.3.1\"\n" ++
        "  optionalDependencies:\n" ++
        "    fsevents \"^2.3.3\"\n";
    expect_eq(out, expected);
});

test("pkg yarn_lock_printer: deterministic alphabetical sort by (name, version)", fn() {
    let printer = YarnLockPrinter.init("");
    const s_zod = ["3.23.8"];
    const s_a2 = ["2.0.0"];
    const s_a1 = ["1.0.0"];

    printer.addPackage(YarnLockPackage{
        name: "zod",
        version: "3.23.8",
        resolved_url: "https://registry.npmjs.org/zod/-/zod-3.23.8.tgz",
        requested_specs: s_zod[0..],
    }) catch unreachable;
    printer.addPackage(YarnLockPackage{
        name: "axios",
        version: "2.0.0",
        resolved_url: "https://registry.npmjs.org/axios/-/axios-2.0.0.tgz",
        requested_specs: s_a2[0..],
    }) catch unreachable;
    printer.addPackage(YarnLockPackage{
        name: "axios",
        version: "1.0.0",
        resolved_url: "https://registry.npmjs.org/axios/-/axios-1.0.0.tgz",
        requested_specs: s_a1[0..],
    }) catch unreachable;

    printer.sortAlphabetical();
    let buf: [1024]u8 = undefined;
    const out = printer.printToBuffer(buf[0..]) catch unreachable;

    const pos_a1 = std.mem.indexOf(u8, out, "axios@1.0.0:") ?? unreachable;
    const pos_a2 = std.mem.indexOf(u8, out, "axios@2.0.0:") ?? unreachable;
    const pos_zod = std.mem.indexOf(u8, out, "zod@3.23.8:") ?? unreachable;
    expect_eq(pos_a1 < pos_a2, true);
    expect_eq(pos_a2 < pos_zod, true);
});

test("pkg yarn_lock_printer: default caret spec when requested_specs is empty", fn() {
    let printer = YarnLockPrinter.init("");
    printer.addPackage(YarnLockPackage{
        name: "chalk",
        version: "5.3.0",
        resolved_url: "https://registry.npmjs.org/chalk/-/chalk-5.3.0.tgz",
    }) catch unreachable;

    let buf: [512]u8 = undefined;
    const out = printer.printToBuffer(buf[0..]) catch unreachable;
    expect_eq(std.mem.indexOf(u8, out, "\"chalk@^5.3.0\":\n") != null, true);
    // No integrity line when integrity is empty
    expect_eq(std.mem.indexOf(u8, out, "integrity") == null, true);
});

test("pkg yarn_lock_printer: rejects empty name / empty version & checks capacity constant", fn() {
    expect_eq(MAX_YARN_LOCK_PACKAGES, 64);
    let printer = YarnLockPrinter.init("");

    let empty_name = false;
    * = printer.addPackage(YarnLockPackage{
        name: "",
        version: "1.0.0",
        resolved_url: "https://example.com/a.tgz",
    }) catch { empty_name = true; };
    expect_eq(empty_name, true);

    let empty_ver = false;
    * = printer.addPackage(YarnLockPackage{
        name: "foo",
        version: "",
        resolved_url: "https://example.com/a.tgz",
    }) catch { empty_ver = true; };
    expect_eq(empty_ver, true);
    expect_eq(printer.count(), 0);
});

test("pkg yarn_lock_printer: BufferTooSmall guard", fn() {
    let printer = YarnLockPrinter.init("abc");
    printer.addPackage(YarnLockPackage{
        name: "lodash",
        version: "4.17.21",
        resolved_url: "https://registry.npmjs.org/lodash/-/lodash-4.17.21.tgz",
    }) catch unreachable;

    let tiny: [16]u8 = undefined;
    let oob = false;
    * = printer.printToBuffer(tiny[0..]) catch { oob = true; };
    expect_eq(oob, true);
});
