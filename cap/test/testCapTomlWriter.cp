// cap/test/testCapTomlWriter.cp
// Comprehensive unit tests for @cap/toml-writer

import { test, expect_eq } from "cap:test";
import {
    isBareKey,
    TomlWriter,
} from "../../packages/@cap/toml-writer/src/index.cp";

fn main() {
    test("1. @cap/toml-writer — bare key validation", () => {
        expect_eq(isBareKey("package_name-1"), true);
        expect_eq(isBareKey("has space"), false);
        expect_eq(isBareKey("a.b"), false);
        expect_eq(isBareKey(""), false);
    });

    test("2. @cap/toml-writer — basic table and scalar key-values", () => {
        let buf: [512]u8 = undefined;
        let w = TomlWriter.init(buf[0..512]);
        w.writeTableHeader("package");
        w.writeKvStr("name", "capdux");
        w.writeKvInt("edition", 2026);
        w.writeKvBool("publish", true);
        expect_eq(w.overflow, false);
        expect_eq(w.asSlice(), "[package]\nname = \"capdux\"\nedition = 2026\npublish = true\n");
    });

    test("3. @cap/toml-writer — quoted keys and string escaping", () => {
        let buf: [512]u8 = undefined;
        let w = TomlWriter.init(buf[0..512]);
        w.writeKvStr("a.b", "line1\n\"quoted\"\\path\t!");
        expect_eq(w.asSlice(), "\"a.b\" = \"line1\\n\\\"quoted\\\"\\\\path\\t!\"\n");
    });

    test("4. @cap/toml-writer — string arrays and negative integers", () => {
        let buf: [512]u8 = undefined;
        let w = TomlWriter.init(buf[0..512]);
        const tags: [3]string = ["cp", "rust", "zero-heap"];
        w.writeKvStrArray("keywords", tags[0..3]);
        w.writeKvInt("offset", -42);
        w.writeKvInt("zero", 0);
        expect_eq(w.asSlice(), "keywords = [\"cp\", \"rust\", \"zero-heap\"]\noffset = -42\nzero = 0\n");
    });

    test("5. @cap/toml-writer — comments and array-of-tables", () => {
        let buf: [512]u8 = undefined;
        let w = TomlWriter.init(buf[0..512]);
        w.writeComment("Generated by Capdux");
        w.writeArrayTableHeader("bin");
        w.writeKvStr("name", "cap");
        expect_eq(w.asSlice(), "# Generated by Capdux\n\n[[bin]]\nname = \"cap\"\n");
    });

    test("6. @cap/toml-writer — overflow flag on tiny buffer", () => {
        let tiny: [8]u8 = undefined;
        let w = TomlWriter.init(tiny[0..8]);
        w.writeKvStr("longkey", "longvalue");
        expect_eq(w.overflow, true);
    });
}
