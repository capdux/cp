import { test, expect_eq } from "cap:test";
import {
    defaultResolvConfig,
    parseResolvConf,
} from "../../packages/resolv-conf/src/index.cp";

fn main() {
    test("1. @cap/resolv-conf — parses nameservers, search domains, and options", () => {
        const conf = "# Generated by systemd-resolved\nnameserver 1.1.1.1\nnameserver 2606:4700:4700::1111 ; Cloudflare v6\nsearch corp.local svc.cluster.local\noptions ndots:5 timeout:2 attempts:3 edns0 rotate\n";
        const cfg = parseResolvConf(conf);
        expect_eq(cfg.nameserver_count, 2 as usize);
        expect_eq(cfg.nameservers[0], "1.1.1.1");
        expect_eq(cfg.nameservers[1], "2606:4700:4700::1111");
        expect_eq(cfg.search_count, 2 as usize);
        expect_eq(cfg.search_domains[0], "corp.local");
        expect_eq(cfg.search_domains[1], "svc.cluster.local");
        expect_eq(cfg.ndots, 5 as u32);
        expect_eq(cfg.timeout_sec, 2 as u32);
        expect_eq(cfg.attempts, 3 as u32);
        expect_eq(cfg.edns0, true);
        expect_eq(cfg.rotate, true);
    });

    test("2. @cap/resolv-conf — defaultResolvConfig provides standard POSIX defaults", () => {
        const cfg = defaultResolvConfig();
        expect_eq(cfg.nameserver_count, 0 as usize);
        expect_eq(cfg.ndots, 1 as u32);
        expect_eq(cfg.timeout_sec, 5 as u32);
        expect_eq(cfg.attempts, 2 as u32);
        expect_eq(cfg.edns0, false);
    });

    test("3. @cap/resolv-conf — handles domain directive and overrides earlier search", () => {
        const conf = "search old.example\ndomain prod.internal\n";
        const cfg = parseResolvConf(conf);
        expect_eq(cfg.domain, "prod.internal");
        expect_eq(cfg.search_count, 1 as usize);
        expect_eq(cfg.search_domains[0], "prod.internal");
    });

    test("4. @cap/resolv-conf — parses use-vc and trust-ad flags", () => {
        const conf = "options use-vc trust-ad\n";
        const cfg = parseResolvConf(conf);
        expect_eq(cfg.use_vc, true);
        expect_eq(cfg.trust_ad, true);
    });

    test("5. @cap/resolv-conf — ignores comments, blank lines, and invalid option values", () => {
        const conf = "\n  # full comment\n; semicolon comment\noptions ndots:bad timeout:10\nnameserver 8.8.8.8\n";
        const cfg = parseResolvConf(conf);
        expect_eq(cfg.nameserver_count, 1 as usize);
        expect_eq(cfg.nameservers[0], "8.8.8.8");
        expect_eq(cfg.ndots, 1 as u32);
        expect_eq(cfg.timeout_sec, 10 as u32);
    });

    test("6. @cap/resolv-conf — handles CRLF and tabs cleanly", () => {
        const conf = "nameserver\t127.0.0.53\r\nsearch\tlocaldomain\r\n";
        const cfg = parseResolvConf(conf);
        expect_eq(cfg.nameserver_count, 1 as usize);
        expect_eq(cfg.nameservers[0], "127.0.0.53");
        expect_eq(cfg.search_domains[0], "localdomain");
    });
}
