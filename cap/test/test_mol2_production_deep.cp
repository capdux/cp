// Source: cp/cap/test/test_mol2_production_deep.cp (Production deep tests for cap:mol2)

import std from "std";
import { test, expect_eq } from "cap:test";
import {
    MOL2_RTI_MOLECULE,
    MOL2_RTI_ATOM,
    MOL2_RTI_BOND,
    MOL2_RTI_SUBSTRUCTURE,
    Mol2Header,
    Mol2Atom,
    Mol2Bond,
    Mol2Stats,
    Mol2AtomIter,
    Mol2BondIter,
    Mol2RecordIter,
    isMol2,
    parseMol2Header,
    parseMol2AtomLine,
    parseMol2BondLine,
    summarizeMol2,
} from "cap:science";

fn approxEq(a: f64, b: f64, eps: f64): bool {
    const diff = if (a > b) (a - b) else (b - a);
    return diff < eps;
}

// 完整小分子：含 SYBYL 力场原子类型 C.ar / C.2 / O.2 / N.am、部分电荷、ar/am/2 键及 @<TRIPOS>SUBSTRUCTURE
const BENZAMIDE_MOL2: []const u8 =
    "# Tripos SYBYL MOL2 generated by CP-Chem\r\n" ++
    "@<TRIPOS>MOLECULE\r\n" ++
    "Benzamide_Core\r\n" ++
    " 5 5 1 0 0\r\n" ++
    "SMALL\r\n" ++
    "GASTEIGER\r\n" ++
    "\r\n" ++
    "@<TRIPOS>ATOM\r\n" ++
    "      1 C1          1.2000    0.0000    0.0000 C.ar    1 LIG1        0.1000\r\n" ++
    "      2 C2          0.6000    1.0392    0.0000 C.ar    1 LIG1       -0.0500\r\n" ++
    "# inline comment inside ATOM section\r\n" ++
    "      3 C7          2.6800    0.0000    0.0000 C.2     1 LIG1        0.4500\r\n" ++
    "      4 O1          3.3000    1.0600    0.0000 O.2     1 LIG1       -0.3500\r\n" ++
    "      5 N1          3.3000   -1.1500    0.0000 N.am    1 LIG1       -0.1500\r\n" ++
    "@<TRIPOS>BOND\r\n" ++
    "     1     1     2 ar\r\n" ++
    "     2     2     1 ar\r\n" ++
    "     3     1     3 1\r\n" ++
    "     4     3     4 2\r\n" ++
    "     5     3     5 am\r\n" ++
    "@<TRIPOS>SUBSTRUCTURE\r\n" ++
    "     1 LIG1        1 RESIDUE           4 A     LIG1     0 ROOT\r\n";

// 多分子拼接 .mol2（含第 2 个精简 6 列无电荷分子）
const MULTI_MOL2: []const u8 =
    BENZAMIDE_MOL2 ++
    "\n" ++
    "@<TRIPOS>MOLECULE\n" ++
    "Minimal_Diatomic\n" ++
    " 2 1\n" ++
    "SMALL\n" ++
    "NO_CHARGES\n" ++
    "@<TRIPOS>ATOM\n" ++
    "# 6-column minimal atoms without subst_id/subst_name/charge\n" ++
    "  1 O1   0.000   0.000   0.000  O.2\n" ++
    "  2 O2   1.210   0.000   0.000  O.2\n" ++
    "@<TRIPOS>BOND\n" ++
    "  1 1 2 2\n" ++
    "@<TRIPOS>MOLECULE\n" ++
    "Charged_Ion\n" ++
    " 1 0 1 0 0\n" ++
    "SMALL\n" ++
    "USER_CHARGES\n" ++
    "@<TRIPOS>ATOM\n" ++
    "  1 NA1  5.000  -2.500   1.250  Na   1 ION   1.0000\n";

test("1. Full SYBYL MOL2 header, C.ar/O.2/N.am atoms, partial charges & ar/am/2 bonds", () => {
    expect_eq(std.mem.eql(u8, MOL2_RTI_MOLECULE, "@<TRIPOS>MOLECULE"), true);
    expect_eq(std.mem.eql(u8, MOL2_RTI_ATOM, "@<TRIPOS>ATOM"), true);
    expect_eq(std.mem.eql(u8, MOL2_RTI_BOND, "@<TRIPOS>BOND"), true);
    expect_eq(std.mem.eql(u8, MOL2_RTI_SUBSTRUCTURE, "@<TRIPOS>SUBSTRUCTURE"), true);

    expect_eq(isMol2(BENZAMIDE_MOL2), true);
    const hdr = parseMol2Header(BENZAMIDE_MOL2) ?? unreachable;
    expect_eq(std.mem.eql(u8, hdr.name, "Benzamide_Core"), true);
    expect_eq(hdr.atom_count, 5);
    expect_eq(hdr.bond_count, 5);
    expect_eq(hdr.subst_count, 1);
    expect_eq(hdr.feat_count, 0);
    expect_eq(hdr.set_count, 0);
    expect_eq(std.mem.eql(u8, hdr.mol_type, "SMALL"), true);
    expect_eq(std.mem.eql(u8, hdr.charge_type, "GASTEIGER"), true);

    let ait = Mol2AtomIter.init(hdr.atom_section);
    const a1 = ait.next() ?? unreachable;
    expect_eq(a1.atom_id, 1);
    expect_eq(std.mem.eql(u8, a1.atom_name, "C1"), true);
    expect_eq(approxEq(a1.x, 1.2, 0.0001), true);
    expect_eq(std.mem.eql(u8, a1.sybyl_type, "C.ar"), true);
    expect_eq(a1.subst_id, 1);
    expect_eq(std.mem.eql(u8, a1.subst_name, "LIG1"), true);
    expect_eq(a1.has_charge, true);
    expect_eq(approxEq(a1.charge, 0.1, 0.0001), true);

    * = ait.next() ?? unreachable; // C2
    * = ait.next() ?? unreachable; // C7 (跳过 # 注释行)
    const a4 = ait.next() ?? unreachable; // O1
    expect_eq(std.mem.eql(u8, a4.sybyl_type, "O.2"), true);
    expect_eq(approxEq(a4.charge, -0.35, 0.0001), true);

    const a5 = ait.next() ?? unreachable; // N1
    expect_eq(std.mem.eql(u8, a5.sybyl_type, "N.am"), true);
    expect_eq(approxEq(a5.charge, -0.15, 0.0001), true);
    expect_eq(ait.next() == null, true);
    expect_eq(ait.malformed, false);

    let bit = Mol2BondIter.init(hdr.bond_section);
    const b1 = bit.next() ?? unreachable;
    expect_eq(b1.bond_id, 1);
    expect_eq(b1.origin_atom, 1);
    expect_eq(b1.target_atom, 2);
    expect_eq(b1.isAromatic(), true);

    const b2 = bit.next() ?? unreachable;
    expect_eq(b2.isAromatic(), true);
    const b3 = bit.next() ?? unreachable;
    expect_eq(b3.isAromatic(), false);
    expect_eq(std.mem.eql(u8, b3.bond_type, "1"), true);
    const b4 = bit.next() ?? unreachable;
    expect_eq(std.mem.eql(u8, b4.bond_type, "2"), true);
    const b5 = bit.next() ?? unreachable;
    expect_eq(std.mem.eql(u8, b5.bond_type, "am"), true);
    expect_eq(b5.isAromatic(), false);
    expect_eq(bit.next() == null, true);
});

test("2. Mol2RecordIter splits concatenated multi-molecule .mol2 stream cleanly", () => {
    let rit = Mol2RecordIter.init(MULTI_MOL2);

    const r1 = rit.next() ?? unreachable;
    const h1 = parseMol2Header(r1) ?? unreachable;
    expect_eq(std.mem.eql(u8, h1.name, "Benzamide_Core"), true);

    const r2 = rit.next() ?? unreachable;
    const h2 = parseMol2Header(r2) ?? unreachable;
    expect_eq(std.mem.eql(u8, h2.name, "Minimal_Diatomic"), true);
    expect_eq(h2.atom_count, 2);
    expect_eq(h2.bond_count, 1);
    expect_eq(std.mem.eql(u8, h2.charge_type, "NO_CHARGES"), true);

    const r3 = rit.next() ?? unreachable;
    const h3 = parseMol2Header(r3) ?? unreachable;
    expect_eq(std.mem.eql(u8, h3.name, "Charged_Ion"), true);
    expect_eq(h3.atom_count, 1);
    expect_eq(h3.bond_count, 0);

    // 直接向 Mol2AtomIter 传入完整 record 也能自动定位 @<TRIPOS>ATOM
    let ait3 = Mol2AtomIter.init(r3);
    const ion = ait3.next() ?? unreachable;
    expect_eq(std.mem.eql(u8, ion.sybyl_type, "Na"), true);
    expect_eq(approxEq(ion.charge, 1.0, 0.0001), true);
    expect_eq(ait3.next() == null, true);

    expect_eq(rit.next() == null, true);
});

test("3. Optional subst_id/subst_name/charge omitted & # comment lines handled gracefully", () => {
    let rit = Mol2RecordIter.init(MULTI_MOL2);
    * = rit.next() ?? unreachable;
    const r2 = rit.next() ?? unreachable;
    const h2 = parseMol2Header(r2) ?? unreachable;

    let ait = Mol2AtomIter.init(h2.atom_section);
    const o1 = ait.next() ?? unreachable;
    expect_eq(o1.atom_id, 1);
    expect_eq(std.mem.eql(u8, o1.atom_name, "O1"), true);
    expect_eq(std.mem.eql(u8, o1.sybyl_type, "O.2"), true);
    expect_eq(o1.subst_id, 0);
    expect_eq(o1.subst_name.len, 0);
    expect_eq(o1.has_charge, false);
    expect_eq(approxEq(o1.charge, 0.0, 0.0001), true);

    const o2 = ait.next() ?? unreachable;
    expect_eq(approxEq(o2.x, 1.21, 0.0001), true);
    expect_eq(o2.has_charge, false);
    expect_eq(ait.next() == null, true);

    // 仅含 subst_id 与 subst_name 但无 charge（8 列）
    const a8 = parseMol2AtomLine(" 7 C9 1.0 2.0 3.0 C.3 2 RES2") ?? unreachable;
    expect_eq(a8.subst_id, 2);
    expect_eq(std.mem.eql(u8, a8.subst_name, "RES2"), true);
    expect_eq(a8.has_charge, false);
});

test("4. summarizeMol2 computes molecule_count, atoms, bonds, aromatic_bonds, and net total_charge", () => {
    const stats = summarizeMol2(MULTI_MOL2);
    expect_eq(stats.molecule_count, 3);
    expect_eq(stats.total_atoms, 5 + 2 + 1);
    expect_eq(stats.total_bonds, 5 + 1 + 0);
    expect_eq(stats.aromatic_bonds, 2);
    // Benzamide: 0.10 - 0.05 + 0.45 - 0.35 - 0.15 = 0.00; Minimal: 0.0; Charged_Ion: +1.00
    expect_eq(approxEq(stats.total_charge, 1.0, 0.0001), true);

    const empty_stats = summarizeMol2("");
    expect_eq(empty_stats.molecule_count, 0);
    expect_eq(empty_stats.total_atoms, 0);
    expect_eq(empty_stats.total_bonds, 0);
    expect_eq(empty_stats.aromatic_bonds, 0);
    expect_eq(approxEq(empty_stats.total_charge, 0.0, 0.0001), true);
});

test("5. Resilience against non-MOL2 input, truncated headers, and malformed atom/bond lines", () => {
    expect_eq(isMol2(""), false);
    expect_eq(isMol2("HEADER    NOT A MOL2 FILE\n"), false);
    expect_eq(parseMol2Header("plain text without rti") == null, true);

    // 截断的 @<TRIPOS>MOLECULE 块（缺少 mol_type/charge_type）
    const trunc_hdr = "@<TRIPOS>MOLECULE\nOnlyName\n 3 2\n";
    expect_eq(parseMol2Header(trunc_hdr) == null, true);

    // 单行畸形原子与键
    expect_eq(parseMol2AtomLine("1 C1 bad_x 0.0 0.0 C.3") == null, true);
    expect_eq(parseMol2AtomLine("1 C1 0.0 0.0") == null, true);
    expect_eq(parseMol2AtomLine("1 C1 0.0 0.0 0.0 C.3 1 LIG not_a_charge") == null, true);
    expect_eq(parseMol2BondLine("1 0 2 1") == null, true); // 0 原子索引非法
    expect_eq(parseMol2BondLine("1 1 2") == null, true);   // 缺少 bond_type

    // 迭代器遇畸形行标记 malformed 并跳过继续解析后续合法行
    const mixed_atoms =
        "@<TRIPOS>ATOM\n" ++
        "  1 C1  NaN   0.0  0.0  C.3\n" ++
        "  2 O1  1.5  -1.0  0.5  O.3  1 LIG  -0.4\n" ++
        "@<TRIPOS>BOND\n";
    let ait = Mol2AtomIter.init(mixed_atoms);
    const valid = ait.next() ?? unreachable;
    expect_eq(ait.malformed, true);
    expect_eq(valid.atom_id, 2);
    expect_eq(approxEq(valid.charge, -0.4, 0.0001), true);
    expect_eq(ait.next() == null, true);
});
