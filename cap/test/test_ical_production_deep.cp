// Source: cp/cap/test/test_ical_production_deep.cp
// Deep production test suite for pure CP `cap:ical` & `cap.ical` dynamic mount.

const std = @import("std");
import { test, expect_eq } from "cap:test";
import {
    IcalError,
    RRuleFreq,
    Weekday,
    IcalDateTime,
    RRule,
    IcalEvent,
    IcalCalendar,
} from "cap:ical";
import cap from "cap";

fn expectStrEq(actual: []const u8, expected: []const u8): ! {
    expect_eq(std.mem.eql(u8, actual, expected), true);
}

fn expectInvalidRRule(alloc: std.mem.Allocator, rule_str: []const u8): ! {
    let rr = RRule.parse(alloc, rule_str) catch e => {
        expectStrEq(@errorName(e), "InvalidRRule")?;
        return;
    };
    rr.deinit();
    expect_eq(true, false);
}

fn expectInvalidCalendar(alloc: std.mem.Allocator, ics_text: []const u8, expected_name: []const u8): ! {
    let cal = IcalCalendar.parse(alloc, ics_text) catch e => {
        expectStrEq(@errorName(e), expected_name)?;
        return;
    };
    cal.deinit();
    expect_eq(true, false);
}

pub fn main() {
    test("1. IcalDateTime Leap Year (2024-02-29 / 2100 Non-Leap), addDays & Sakamoto dayOfWeek", () => {
        const alloc: std.mem.Allocator = std.heap.page_allocator;

        // 2024 is a leap year: 2024-02-29 is Thursday (.Th)
        let leap_dt = IcalDateTime.parse("20240228T123045Z") catch unreachable;
        expect_eq(leap_dt.dayOfWeek() == .We, true);

        let feb29 = leap_dt.addDays(1);
        expect_eq(feb29.year, 2024);
        expect_eq(feb29.month, 2);
        expect_eq(feb29.day, 29);
        expect_eq(feb29.hour, 12);
        expect_eq(feb29.minute, 30);
        expect_eq(feb29.second, 45);
        expect_eq(feb29.is_utc, true);
        expect_eq(feb29.dayOfWeek() == .Th, true);

        let mar1_2024 = feb29.addDays(1);
        expect_eq(mar1_2024.year, 2024);
        expect_eq(mar1_2024.month, 3);
        expect_eq(mar1_2024.day, 1);
        expect_eq(mar1_2024.dayOfWeek() == .Fr, true);

        // Negative addDays across leap boundary
        let back_feb29 = mar1_2024.addDays(-1);
        expect_eq(back_feb29.compare(feb29), 0);

        // 2100 is NOT a leap year (divisible by 100, not 400): 2100-02-28 + 1 -> 2100-03-01
        let feb28_2100 = IcalDateTime.parse("21000228") catch unreachable;
        expect_eq(feb28_2100.dayOfWeek() == .Su, true);
        let mar1_2100 = feb28_2100.addDays(1);
        expect_eq(mar1_2100.year, 2100);
        expect_eq(mar1_2100.month, 3);
        expect_eq(mar1_2100.day, 1);
        expect_eq(mar1_2100.dayOfWeek() == .Mo, true);

        let formatted = feb29.format(alloc) catch unreachable;
        defer alloc.free(formatted);
        expectStrEq(formatted, "20240229T123045Z") catch unreachable;
    });

    test("2. RRule Expansion: DAILY+COUNT, WEEKLY+INTERVAL=2+BYDAY, MONTHLY+BYMONTHDAY, UNTIL & EXDATE", () => {
        const alloc: std.mem.Allocator = std.heap.page_allocator;
        let r_start = IcalDateTime.parse("20260101T090000Z") catch unreachable;
        let r_end = IcalDateTime.parse("20261231T235959Z") catch unreachable;

        // 2.1 DAILY + COUNT=4
        let daily = RRule.parse(alloc, "FREQ=DAILY;INTERVAL=2;COUNT=4") catch unreachable;
        defer daily.deinit();
        let d_res = daily.expand(alloc, r_start, r_start, r_end, [], 20) catch unreachable;
        defer alloc.free(d_res);
        expect_eq(d_res.len, 4);
        expect_eq(d_res[0].day, 1);
        expect_eq(d_res[1].day, 3);
        expect_eq(d_res[2].day, 5);
        expect_eq(d_res[3].day, 7);

        // 2.2 WEEKLY + INTERVAL=2 + BYDAY=MO,FR + EXDATE
        // 2026-01-02 is Friday
        let wk_start = IcalDateTime.parse("20260102T090000Z") catch unreachable;
        expect_eq(wk_start.dayOfWeek() == .Fr, true);
        let wk_rule = RRule.parse(alloc, "FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,FR;COUNT=5") catch unreachable;
        defer wk_rule.deinit();
        // Exclude 2026-01-16 (Friday of week 2)
        let ex1 = IcalDateTime.parse("20260116T090000Z") catch unreachable;
        let ex_arr: [1]IcalDateTime = [ex1];
        let wk_res = wk_rule.expand(alloc, wk_start, wk_start, r_end, ex_arr[0..], 20) catch unreachable;
        defer alloc.free(wk_res);
        // Generated by rule (5): Jan 2 (Fr), Jan 12 (Mo), Jan 16 (Fr - excluded!), Jan 26 (Mo), Jan 30 (Fr)
        expect_eq(wk_res.len, 4);
        expect_eq(wk_res[0].day, 2);
        expect_eq(wk_res[1].day, 12);
        expect_eq(wk_res[2].day, 26);
        expect_eq(wk_res[3].day, 30);

        // 2.3 MONTHLY + BYMONTHDAY=15 + UNTIL
        let mo_rule = RRule.parse(alloc, "FREQ=MONTHLY;BYMONTHDAY=15;UNTIL=20260415T090000Z") catch unreachable;
        defer mo_rule.deinit();
        let mo_res = mo_rule.expand(alloc, r_start, r_start, r_end, [], 20) catch unreachable;
        defer alloc.free(mo_res);
        expect_eq(mo_res.len, 4);
        expect_eq(mo_res[0].month, 1);
        expect_eq(mo_res[1].month, 2);
        expect_eq(mo_res[2].month, 3);
        expect_eq(mo_res[3].month, 4);
        expect_eq(mo_res[3].day, 15);
    });

    test("3. IcalCalendar.parse with RFC 5545 Line Unfolding, Escapes & Occurrences", () => {
        const alloc: std.mem.Allocator = std.heap.page_allocator;
        const ics_raw =
            "BEGIN:VCALENDAR\r\n" ++
            "VERSION:2.0\r\n" ++
            "PRODID:-//CP Agent//Calendar 1.0//EN\r\n" ++
            "BEGIN:VEVENT\r\n" ++
            "UID:evt-folded-001\r\n" ++
            "DTSTART:20260302T100000Z\r\n" ++
            "DTEND:20260302T110000Z\r\n" ++
            "SUMMARY:Quarterly Review\\, Architecture\r\n" ++
            "  & Planning\\; Phase 1\r\n" ++
            "DESCRIPTION:Line 1\\nLine 2\\\\Path\r\n" ++
            "\t continued\r\n" ++
            "LOCATION:Room 402\\, Building B\r\n" ++
            "RRULE:FREQ=WEEKLY;COUNT=3\r\n" ++
            "EXDATE:20260309T100000Z\r\n" ++
            "END:VEVENT\r\n" ++
            "END:VCALENDAR\r\n";

        let cal = IcalCalendar.parse(alloc, ics_raw) catch unreachable;
        defer cal.deinit();

        expect_eq(cal.events.items.len, 1);
        let ev: IcalEvent = cal.events.items[0];
        expectStrEq(ev.uid, "evt-folded-001") catch unreachable;
        expectStrEq(ev.summary, "Quarterly Review, Architecture & Planning; Phase 1") catch unreachable;
        expectStrEq(ev.description, "Line 1\nLine 2\\Path continued") catch unreachable;
        expectStrEq(ev.location, "Room 402, Building B") catch unreachable;

        let r_start = IcalDateTime.parse("20260301T000000Z") catch unreachable;
        let r_end = IcalDateTime.parse("20260331T235959Z") catch unreachable;
        let occs = cal.occurrences(alloc, r_start, r_end, 10) catch unreachable;
        defer alloc.free(occs);
        // 3 weekly instances: Mar 2, Mar 9 (excluded), Mar 16 -> 2 occurrences
        expect_eq(occs.len, 2);
        expect_eq(occs[0].day, 2);
        expect_eq(occs[1].day, 16);
    });

    test("4. toIcs() Round-Trip Equivalence & Malformed Input / InvalidRRule Rejection", () => {
        const alloc: std.mem.Allocator = std.heap.page_allocator;
        const ics_src =
            "BEGIN:VCALENDAR\r\n" ++
            "VERSION:2.0\r\n" ++
            "PRODID:-//CP//RoundTrip//EN\r\n" ++
            "BEGIN:VEVENT\r\n" ++
            "UID:rt-100\r\n" ++
            "DTSTART:20260501T080000Z\r\n" ++
            "SUMMARY:Sync\\, Ops\\; Daily\r\n" ++
            "DESCRIPTION:First\\nSecond\r\n" ++
            "RRULE:FREQ=DAILY;COUNT=2\r\n" ++
            "END:VEVENT\r\n" ++
            "END:VCALENDAR\r\n";

        let cal1 = IcalCalendar.parse(alloc, ics_src) catch unreachable;
        defer cal1.deinit();

        let emitted = cal1.toIcs(alloc) catch unreachable;
        defer alloc.free(emitted);

        let cal2 = IcalCalendar.parse(alloc, emitted) catch unreachable;
        defer cal2.deinit();

        expect_eq(cal2.events.items.len, 1);
        expectStrEq(cal2.events.items[0].uid, cal1.events.items[0].uid) catch unreachable;
        expectStrEq(cal2.events.items[0].summary, cal1.events.items[0].summary) catch unreachable;
        expectStrEq(cal2.events.items[0].description, cal1.events.items[0].description) catch unreachable;

        // Invalid RRULE interceptions
        expectInvalidRRule(alloc, "INTERVAL=2") catch unreachable;
        expectInvalidRRule(alloc, "FREQ=HOURLY_UNKNOWN") catch unreachable;
        expectInvalidRRule(alloc, "FREQ=DAILY;INTERVAL=0") catch unreachable;
        expectInvalidRRule(alloc, "FREQ=WEEKLY;BYDAY=XX") catch unreachable;

        // Malformed calendar / missing DTSTART interceptions
        expectInvalidCalendar(alloc, "BEGIN:VCALENDAR\r\nBEGIN:VEVENT\r\nUID:x\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n", "MissingRequiredField") catch unreachable;
        expectInvalidCalendar(alloc, "NOT_A_CALENDAR", "InvalidFormat") catch unreachable;
    });

    test("5. cap.ical Dynamic Namespace Mount Verification", () => {
        const alloc: std.mem.Allocator = std.heap.page_allocator;
        const ics =
            "BEGIN:VCALENDAR\r\n" ++
            "VERSION:2.0\r\n" ++
            "BEGIN:VEVENT\r\n" ++
            "UID:dyn-1\r\n" ++
            "DTSTART:20260228T100000Z\r\n" ++
            "RRULE:FREQ=YEARLY;COUNT=2\r\n" ++
            "SUMMARY:Annual Check\r\n" ++
            "END:VEVENT\r\n" ++
            "END:VCALENDAR\r\n";

        let cal: IcalCalendar = cap.ical.IcalCalendar.parse(alloc, ics) catch unreachable;
        defer cal.deinit();

        let start: IcalDateTime = cap.ical.IcalDateTime.parse("20260101T000000Z") catch unreachable;
        let end: IcalDateTime = cap.ical.IcalDateTime.parse("20280101T000000Z") catch unreachable;
        let occs = cal.occurrences(alloc, start, end, 10) catch unreachable;
        defer alloc.free(occs);

        expect_eq(occs.len, 2);
        expect_eq(occs[0].year, 2026);
        expect_eq(occs[1].year, 2027);
    });
}
