// Source: cp/cap/test/test_trx_production_deep.cp (Production deep tests for cap:trx)

import { test, expect_eq } from "cap:test";
import {
    TrxOutcome,
    TrxRunHeader,
    TrxResult,
    TrxSummary,
    TrxResultIter,
    isTrx,
    parseTrxHeader,
    parseTrxSummary,
} from "cap:trx";

fn bytesEq(a: []const u8, b: []const u8): bool {
    if (a.len != b.len) return false;
    let i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) return false;
        i += 1;
    }
    return true;
}

fn approxEq(a: f64, b: f64, eps: f64): bool {
    const d = if (a >= b) a - b else b - a;
    return d <= eps;
}

test("1. Full dotnet test .trx TestRun + Times + Results + ResultSummary/Counters parsing", () => {
    const trx =
        "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n" +
        "<!-- generated by dotnet test -->\n" +
        "<TestRun id=\"run-001\" name=\"ci@build-node 2026-11-21\" runUser=\"ci\" xmlns=\"http://microsoft.com/schemas/VisualStudio/TeamTest/2010\">\n" +
        "  <Times creation=\"2026-11-21T10:00:00Z\" queuing=\"2026-11-21T10:00:01Z\" start=\"2026-11-21T10:00:02Z\" finish=\"2026-11-21T10:01:05Z\" />\n" +
        "  <Results>\n" +
        "    <UnitTestResult executionId=\"exec-1\" testId=\"tid-1\" testName=\"MathTests.Add\" computerName=\"NODE1\" duration=\"00:00:00.0125000\" outcome=\"Passed\" />\n" +
        "    <UnitTestResult executionId=\"exec-2\" testId=\"tid-2\" testName=\"MathTests.Slow\" computerName=\"NODE1\" duration=\"00:01:02.5000000\" outcome=\"Passed\">\n" +
        "      <Output><StdOut>slow ok</StdOut></Output>\n" +
        "    </UnitTestResult>\n" +
        "  </Results>\n" +
        "  <ResultSummary outcome=\"Completed\">\n" +
        "    <Counters total=\"2\" executed=\"2\" passed=\"2\" failed=\"0\" error=\"0\" timeout=\"0\" aborted=\"0\" inconclusive=\"0\" notExecuted=\"0\" />\n" +
        "  </ResultSummary>\n" +
        "</TestRun>\n";

    expect_eq(isTrx(trx), true);

    const hdr = parseTrxHeader(trx) ?? unreachable;
    expect_eq(bytesEq(hdr.id, "run-001"), true);
    expect_eq(bytesEq(hdr.name, "ci@build-node 2026-11-21"), true);
    expect_eq(bytesEq(hdr.run_user, "ci"), true);
    expect_eq(bytesEq(hdr.creation, "2026-11-21T10:00:00Z"), true);
    expect_eq(bytesEq(hdr.finish, "2026-11-21T10:01:05Z"), true);

    let it = TrxResultIter.init(trx);
    const r1 = it.next() ?? unreachable;
    expect_eq(bytesEq(r1.test_name, "MathTests.Add"), true);
    expect_eq(bytesEq(r1.execution_id, "exec-1"), true);
    expect_eq(bytesEq(r1.test_id, "tid-1"), true);
    expect_eq(bytesEq(r1.computer_name, "NODE1"), true);
    expect_eq(r1.outcome == .passed, true);
    expect_eq(approxEq(r1.durationMs(), 12.5, 1e-6), true);

    const r2 = it.next() ?? unreachable;
    expect_eq(bytesEq(r2.test_name, "MathTests.Slow"), true);
    expect_eq(approxEq(r2.durationMs(), 62500.0, 1e-6), true);
    expect_eq(bytesEq(r2.stdout_text, "slow ok"), true);
    expect_eq(it.next() == null, true);

    const sum = parseTrxSummary(trx) ?? unreachable;
    expect_eq(sum.total, 2);
    expect_eq(sum.executed, 2);
    expect_eq(sum.passed, 2);
    expect_eq(sum.failed, 0);
    expect_eq(sum.allPassed(), true);
});

test("2. Failed test ErrorInfo (Message + StackTrace) and StdOut extraction", () => {
    const trx =
        "<TestRun id=\"r2\" name=\"failrun\" runUser=\"dev\">\n" +
        "  <Results>\n" +
        "    <UnitTestResult executionId=\"e1\" testId=\"t1\" testName=\"Auth.Login\" computerName=\"BOX\" duration=\"00:00:01.2500000\" outcome=\"Failed\">\n" +
        "      <Output>\n" +
        "        <StdOut>attempting login</StdOut>\n" +
        "        <ErrorInfo>\n" +
        "          <Message>Assert.Equal() Failure: Expected 200, Actual 401</Message>\n" +
        "          <StackTrace>at Auth.Login() in AuthTests.cs:line 42</StackTrace>\n" +
        "        </ErrorInfo>\n" +
        "      </Output>\n" +
        "    </UnitTestResult>\n" +
        "  </Results>\n" +
        "  <ResultSummary outcome=\"Failed\">\n" +
        "    <Counters total=\"1\" executed=\"1\" passed=\"0\" failed=\"1\" error=\"0\" timeout=\"0\" aborted=\"0\" inconclusive=\"0\" notExecuted=\"0\" />\n" +
        "  </ResultSummary>\n" +
        "</TestRun>";

    let it = TrxResultIter.init(trx);
    const r = it.next() ?? unreachable;
    expect_eq(r.outcome == .failed, true);
    expect_eq(approxEq(r.durationMs(), 1250.0, 1e-6), true);
    expect_eq(bytesEq(r.stdout_text, "attempting login"), true);
    expect_eq(bytesEq(r.error_message, "Assert.Equal() Failure: Expected 200, Actual 401"), true);
    expect_eq(bytesEq(r.stack_trace, "at Auth.Login() in AuthTests.cs:line 42"), true);

    const sum = parseTrxSummary(trx) ?? unreachable;
    expect_eq(sum.failed, 1);
    expect_eq(sum.allPassed(), false);
});

test("3. Missing Counters automatically falls back to scanning UnitTestResult entries", () => {
    const trx =
        "<TestRun id=\"r3\" name=\"nocounters\">\n" +
        "  <Results>\n" +
        "    <UnitTestResult testName=\"T1\" duration=\"00:00:00.1000000\" outcome=\"Passed\" />\n" +
        "    <UnitTestResult testName=\"T2\" duration=\"00:00:00.2000000\" outcome=\"NotExecuted\" />\n" +
        "    <UnitTestResult testName=\"T3\" duration=\"00:00:05.0000000\" outcome=\"Timeout\" />\n" +
        "  </Results>\n" +
        "</TestRun>";

    const sum = parseTrxSummary(trx) ?? unreachable;
    expect_eq(sum.total, 3);
    expect_eq(sum.executed, 2);
    expect_eq(sum.passed, 1);
    expect_eq(sum.not_executed, 1);
    expect_eq(sum.timeout, 1);
    expect_eq(sum.allPassed(), false);
});

test("4. durationMs precision across day-prefixed, fractional, integer, and invalid durations", () => {
    const r_ok = TrxResult {
        test_name: "",
        execution_id: "",
        test_id: "",
        computer_name: "",
        duration: "00:01:02.5000000",
        outcome: .passed,
        error_message: "",
        stack_trace: "",
        stdout_text: "",
    };
    expect_eq(approxEq(r_ok.durationMs(), 62500.0, 1e-6), true);

    const r_day = TrxResult {
        test_name: "",
        execution_id: "",
        test_id: "",
        computer_name: "",
        duration: "1.00:00:01.0000000",
        outcome: .passed,
        error_message: "",
        stack_trace: "",
        stdout_text: "",
    };
    expect_eq(approxEq(r_day.durationMs(), 86401000.0, 1e-3), true);

    const r_bad = TrxResult {
        test_name: "",
        execution_id: "",
        test_id: "",
        computer_name: "",
        duration: "invalid",
        outcome: .unknown,
        error_message: "",
        stack_trace: "",
        stdout_text: "",
    };
    expect_eq(approxEq(r_bad.durationMs(), 0.0, 1e-9), true);
});

test("5. Non-TRX XML, tag-name boundary, and malformed attributes fault tolerance", () => {
    expect_eq(isTrx("<testsuite name=\"junit\"/>"), false);
    expect_eq(isTrx("<TestRunner id=\"1\"/>"), false);
    expect_eq(parseTrxHeader("<html/>") == null, true);
    expect_eq(parseTrxSummary("<html/>") == null, true);

    // 畸形未闭合属性与未闭合标签安全返回不崩溃
    const malformed = "<TestRun id=\"unclosed><Results><UnitTestResult testName=\"X\" outcome=\"Passed\"></Results></TestRun>";
    expect_eq(isTrx(malformed), true);
    let it = TrxResultIter.init(malformed);
    expect_eq(it.next() == null, true);
});
