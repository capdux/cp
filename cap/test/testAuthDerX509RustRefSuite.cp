fn runTestStrictDerCanonicalization(): void! {
    expect_eq(DER_MAX_DEPTH, 32);
    expect_eq(ASN1_MAX_DEPTH, 32);

    // 1. Non-shortest length (0x81 0x05 for length 5) & leading zero length (0x82 0x00 0x80)
    const non_short: [8]u8 = [0x04, 0x81, 0x05, 0x61, 0x62, 0x63, 0x64, 0x65];
    let r1 = DerReader.init(non_short[0..]);
    let got_non_canon1 = false;
    * = r1.readElement() catch |e| {
        if (e == Asn1Error.NonCanonicalLength) got_non_canon1 = true;
    };
    expect_true(got_non_canon1)?;

    const lead_zero_len: [4]u8 = [0x04, 0x82, 0x00, 0x80];
    let r2 = DerReader.init(lead_zero_len[0..]);
    let got_non_canon2 = false;
    * = r2.readElement() catch |e| {
        if (e == Asn1Error.NonCanonicalLength) got_non_canon2 = true;
    };
    expect_true(got_non_canon2)?;

    // Indefinite length (0x80)
    const indef_len: [4]u8 = [0x30, 0x80, 0x00, 0x00];
    let r3 = DerReader.init(indef_len[0..]);
    let got_indef = false;
    * = r3.readElement() catch |e| {
        if (e == Asn1Error.InvalidLength) got_indef = true;
    };
    expect_true(got_indef)?;

    // 2. BOOLEAN only allows 0x00 / 0xFF (reject 0x01)
    const bad_bool: [3]u8 = [TAG_BOOLEAN, 0x01, 0x01];
    let r4 = DerReader.init(bad_bool[0..]);
    let got_bool_err = false;
    * = r4.readBoolean() catch |e| {
        if (e == Asn1Error.NonCanonicalLength) got_bool_err = true;
    };
    expect_true(got_bool_err)?;

    // 3. INTEGER minimal encoding (reject redundant 0x00 or 0xFF)
    const bad_int_pos: [4]u8 = [TAG_INTEGER, 0x02, 0x00, 0x7F];
    let r5 = DerReader.init(bad_int_pos[0..]);
    let got_int_pos = false;
    * = r5.readIntegerBytes() catch |e| {
        if (e == Asn1Error.NonCanonicalLength) got_int_pos = true;
    };
    expect_true(got_int_pos)?;

    const bad_int_neg: [4]u8 = [TAG_INTEGER, 0x02, 0xFF, 0x80];
    let r6 = DerReader.init(bad_int_neg[0..]);
    let got_int_neg = false;
    * = r6.readIntegerBytes() catch |e| {
        if (e == Asn1Error.NonCanonicalLength) got_int_neg = true;
    };
    expect_true(got_int_neg)?;

    // 4. BIT STRING unused bits must be <= 7 AND trailing unused bits must be zero
    const dirty_bs: [4]u8 = [TAG_BIT_STRING, 0x02, 0x03, 0x07]; // 3 unused bits, low 3 bits = 111 != 0
    let r7 = DerReader.init(dirty_bs[0..]);
    let got_bs_dirty = false;
    * = r7.readBitString() catch |e| {
        if (e == Asn1Error.NonCanonicalLength) got_bs_dirty = true;
    };
    expect_true(got_bs_dirty)?;

    const clean_bs: [4]u8 = [TAG_BIT_STRING, 0x02, 0x03, 0xA8]; // 0xA8 = 1010_1000 -> low 3 bits = 000
    let r7b = DerReader.init(clean_bs[0..]);
    const bs_bytes = r7b.readBitString() catch unreachable;
    expect_eq(bs_bytes.len, 1);
    expect_eq(bs_bytes[0], 0xA8);

    // 5. OID leading 0x80 & truncated VLQ rejected
    const bad_oid_80: [5]u8 = [TAG_OID, 0x03, 0x2A, 0x80, 0x01];
    let r8 = DerReader.init(bad_oid_80[0..]);
    let got_oid_80 = false;
    * = r8.readOidBytes() catch |e| {
        if (e == Asn1Error.InvalidOid) got_oid_80 = true;
    };
    expect_true(got_oid_80)?;

    const bad_oid_trunc: [4]u8 = [TAG_OID, 0x02, 0x2A, 0x81];
    let r9 = DerReader.init(bad_oid_trunc[0..]);
    let got_oid_trunc = false;
    * = r9.readOidBytes() catch |e| {
        if (e == Asn1Error.InvalidOid) got_oid_trunc = true;
    };
    expect_true(got_oid_trunc)?;

    // 6. Nesting depth bomb > DER_MAX_DEPTH (32) rejected
    let bomb: [70]u8 = [0; 70];
    let d: usize = 0;
    while (d < 35) : (d += 1) {
        bomb[d * 2] = TAG_SEQUENCE;
        bomb[d * 2 + 1] = ((35 - d - 1) * 2) as u8;
    }
    let cur = DerReader.init(bomb[0..]);
    let depth_exceeded = false;
    let step: usize = 0;
    while (step < 35) : (step += 1) {
        cur = cur.readSequence() catch |e| {
            if (e == Asn1Error.MaxDepthExceeded) depth_exceeded = true;
            break;
        };
    }
    expect_true(depth_exceeded)?;
}

fn runTestRealX509AndTime(): void! {
    const alloc = std.heap.page_allocator;
    let cert = X509Inspector.parseDer(alloc, RUSTCRYPTO_RSA2048_CRT[0..]) catch unreachable;
    defer cert.deinit();

    expect_eq(cert.version, 3);
    expect_true(bytesEqual(cert.sig_alg_oid, "1.2.840.113549.1.1.11"))?;
    expect_true(bytesEqual(cert.pub_key_alg_oid, "1.2.840.113549.1.1.1"))?;
    expect_true(bytesEqual(cert.subject_cn, "example.com"))?;
    expect_true(bytesEqual(cert.issuer_cn, "example.com"))?;
    expect_true(bytesEqual(cert.subject_org, "Example Inc"))?;
    expect_eq(cert.is_ca, false);
    expect_eq(cert.san_dns.len, 1);
    expect_true(bytesEqual(cert.san_dns[0], "example.com"))?;
    expect_true(cert.not_before_sec < cert.not_after_sec)?;
    // Valid within 2022-01-08 .. 2023-01-08 (1650000000 is ~2022-04-15)
    expect_true(cert.isValidAt(1650000000))?;
    expect_eq(cert.isValidAt(1600000000), false);

    // DerWriter roundtrip + PrintableString / IA5String strict validation
    let dw = DerWriter.init(alloc);
    defer dw.deinit();
    dw.writeBoolean(true) catch unreachable;
    dw.writeUint64(0x123456) catch unreachable;
    dw.writeBitString(3, "\xA8") catch unreachable;
    dw.writeOid("1.2.840.113549.1.1.11") catch unreachable;
    dw.writePrintableString("Example Inc") catch unreachable;
    dw.writeIa5String("example.com") catch unreachable;

    let dr = DerReader.init(dw.asSlice());
    expect_eq(dr.readBoolean() catch unreachable, true);
    expect_eq(dr.readUint64() catch unreachable, 0x123456);
    const bs = dr.readBitString() catch unreachable;
    expect_eq(bs[0], 0xA8);
    const oid_str = dr.readOid(alloc) catch unreachable;
    defer alloc.free(oid_str);
    expect_true(bytesEqual(oid_str, "1.2.840.113549.1.1.11"))?;
    expect_true(bytesEqual(dr.readString() catch unreachable, "Example Inc"))?;
    expect_true(bytesEqual(dr.readString() catch unreachable, "example.com"))?;
    expect_eq(dr.hasNext(), false);

    // Invalid PrintableString ('_') & IA5String (0x80) rejected by DerElement.asString()
    const bad_pr: [5]u8 = [TAG_PRINTABLE_STRING, 0x03, 'a', '_', 'b'];
    let pr_r = DerReader.init(bad_pr[0..]);
    let got_bad_pr = false;
    * = pr_r.readString() catch {
        got_bad_pr = true;
    };
    expect_true(got_bad_pr)?;

    const bad_ia5: [5]u8 = [TAG_IA5_STRING, 0x03, 'a', 0x80, 'b'];
    let ia5_r = DerReader.init(bad_ia5[0..]);
    let got_bad_ia5 = false;
    * = ia5_r.readString() catch {
        got_bad_ia5 = true;
    };
    expect_true(got_bad_ia5)?;
}

fn runTestSimdParity(): void! {
    // 3a. copyBytesSimd vs copyBytesScalar
    let src: [129]u8 = [0; 129];
    let dst_sc: [129]u8 = [0; 129];
    let dst_sm: [129]u8 = [0; 129];
    let i: usize = 0;
    while (i < 129) : (i += 1) {
        src[i] = ((i * 19 + 5) & 0xFF) as u8;
    }
    const lens: [8]usize = [0, 1, 15, 16, 17, 31, 64, 129];
    let li: usize = 0;
    while (li < lens.len) : (li += 1) {
        const n = lens[li];
        @memset(dst_sc[0..n], 0);
        @memset(dst_sm[0..n], 0);
        DerElement.copyBytesScalar(dst_sc[0..n], src[0..n]);
        DerElement.copyBytesSimd(dst_sm[0..n], src[0..n]);
        expect_true(bytesEqual(dst_sc[0..n], dst_sm[0..n]))?;
    }

    // 3b. eqlBytesSimd vs eqlBytesScalar
    expect_eq(DerElement.eqlBytesSimd(dst_sc[0..], dst_sm[0..]), true);
    dst_sm[16] ^= 0x01;
    expect_eq(DerElement.eqlBytesSimd(dst_sc[0..], dst_sm[0..]), DerElement.eqlBytesScalar(dst_sc[0..], dst_sm[0..]));
    expect_eq(DerElement.eqlBytesSimd(dst_sc[0..], dst_sm[0..]), false);

    // 3c. isValidIa5StringSimd vs Scalar & isValidPrintableStringSimd vs Scalar
    const ia5_samples: [4][]const u8 = [
        "example.com",
        "very-long-ia5-string-exceeding-16-bytes-for-simd-lane-coverage!",
        "non-ascii-\x80-byte-inside-long-string-0123456789",
        "short\xFF",
    ];
    let si: usize = 0;
    while (si < ia5_samples.len) : (si += 1) {
        expect_eq(DerElement.isValidIa5StringSimd(ia5_samples[si]), DerElement.isValidIa5StringScalar(ia5_samples[si]));
    }

    const pr_samples: [5][]const u8 = [
        "Example Inc 2026",
        "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz",
        "CN=Test+Org, O=Example (US)/2026:v1?",
        "invalid_underscore_0123456789",
        "invalid@email.com_longer_than_16",
    ];
    si = 0;
    while (si < pr_samples.len) : (si += 1) {
        expect_eq(DerElement.isValidPrintableStringSimd(pr_samples[si]), DerElement.isValidPrintableStringScalar(pr_samples[si]));
    }
}

fn runTestMalformedFuzz(): void! {
    const alloc = std.heap.page_allocator;
    let seed: u64 = 0x517CC1B727220A95;
    let buf: [256]u8 = [0; 256];
    let case_idx: usize = 0;
    while (case_idx < 1300) : (case_idx += 1) {
        seed ^= seed << 13;
        seed ^= seed >> 7;
        seed ^= seed << 17;
        const len: usize = ((seed % 255) as usize) + 1;

        let j: usize = 0;
        while (j < len) : (j += 1) {
            seed ^= seed << 13;
            seed ^= seed >> 7;
            seed ^= seed << 17;
            buf[j] = (seed & 0xFF) as u8;
        }
        if ((case_idx % 3) == 0 && len >= 2) {
            buf[0] = TAG_SEQUENCE;
        }

        const slice = buf[0..len];
        let r = DerReader.init(slice);
        let steps: usize = 0;
        while (steps < 8) : (steps += 1) {
            const elem = r.readElement() catch break;
            * = elem.asBoolean() catch {};
            * = elem.asIntegerBytes() catch {};
            * = elem.asBitString() catch {};
            * = elem.asString() catch {};
        }

        if (cert := tryParseX509(alloc, slice)) {
            let c = cert;
            c.deinit();
        }
    }
}

fn main() {
    test("1. Strict X.690 DER canonicalization (length, BOOLEAN, INTEGER, BIT STRING, OID, depth=32)", () => {
        runTestStrictDerCanonicalization()?;
    });
    test("2. RustCrypto/formats X.509 v3 rsa2048-crt.der & RFC 5280 time validation", () => {
        runTestRealX509AndTime()?;
    });
    test("3. 16-lane SIMD vs Scalar 0-diff parity (copyBytes, eqlBytes, IA5String, PrintableString)", () => {
        runTestSimdParity()?;
    });
    test("4. 1,300 deterministic PRNG malformed DER/X.509 fuzz cases (0 panic / 0 OOB)", () => {
        runTestMalformedFuzz()?;
    });
}
