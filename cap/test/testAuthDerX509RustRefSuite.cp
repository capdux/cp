import { test, expect_eq } from "cap:test";
import {
    DER_MAX_DEPTH,
    ASN1_MAX_DEPTH,
    TAG_BOOLEAN,
    TAG_INTEGER,
    TAG_BIT_STRING,
    TAG_OID,
    TAG_PRINTABLE_STRING,
    TAG_IA5_STRING,
    TAG_UTC_TIME,
    TAG_GENERALIZED_TIME,
    TAG_SEQUENCE,
    Asn1Error,
    DerElement,
    DerReader,
    DerWriter,
    OidCodec,
} from "../../lib/auth/asn1Der.cp";
import {
    X509CertInfo,
    X509Inspector,
} from "../../lib/auth/asn1X509.cp";

const std = @import("std");

fn tryParseX509(alloc: std.mem.Allocator, slice: []const u8): X509CertInfo? {
    return X509Inspector.parseDer(alloc, slice) catch return null;
}

fn expect_true(cond: bool): void! {
    expect_eq(cond, true);
}

fn bytesEqual(a: []const u8, b: []const u8): bool {
    if (a.len != b.len) return false;
    let i: usize = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

