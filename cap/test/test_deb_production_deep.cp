// Source: cp/cap/test/test_deb_production_deep.cp (Production deep tests for cap:deb)

import std from "std";
import { test, expect_eq } from "cap:test";
import {
    DEB_AR_MAGIC,
    DEB_BINARY_MEMBER,
    DebCompression,
    DebPackage,
    DebControlField,
    DebControlIter,
    DebControlMeta,
    detectDebCompression,
    isDeb,
    parseDebPackage,
    parseDebControl,
} from "cap:devops";

fn copyBytes(dst: *[]u8, off: usize, src: []const u8) {
    let i: usize = 0;
    while (i < src.len) {
        dst[off + i] = src[i];
        i += 1;
    }
}

fn writeDecimal(dst: *[]u8, off: usize, val: usize) {
    if (val == 0) {
        dst[off] = '0';
        return;
    }
    let tmp: [20]u8 = [0; 20];
    let n: usize = 0;
    let v = val;
    while (v > 0) {
        tmp[n] = ((v % 10) as u8) + '0';
        v = v / 10;
        n += 1;
    }
    let i: usize = 0;
    while (i < n) {
        dst[off + i] = tmp[n - 1 - i];
        i += 1;
    }
}

fn writeArMember(dst: *[]u8, off: usize, name: []const u8, payload: []const u8): usize {
    // Fill 60-byte header with spaces
    let i: usize = 0;
    while (i < 60) {
        dst[off + i] = ' ';
        i += 1;
    }
    copyBytes(dst, off, name);
    dst[off + 16] = '0'; // mtime
    dst[off + 28] = '0'; // uid
    dst[off + 34] = '0'; // gid
    copyBytes(dst, off + 40, "100644"); // mode
    writeDecimal(dst, off + 48, payload.len);
    dst[off + 58] = 0x60; // '`'
    dst[off + 59] = 0x0A; // '\n'

    copyBytes(dst, off + 60, payload);
    let total: usize = payload.len + 60;
    if ((payload.len & 1) != 0) {
        dst[off + total] = '\n'; // 2-byte even alignment pad
        total += 1;
    }
    return total;
}

test("1. parseDebPackage extracts debian-binary, control.tar.zst, and data.tar.xz with odd-size 2B alignment", () => {
    let buf: [512]u8 = [0; 512];
    let b = buf[0..512];

    let off: usize = 0;
    copyBytes(*b, off, DEB_AR_MAGIC);
    off += 8;

    // debian-binary with trailing slash and 4B "2.0\n"
    off += writeArMember(*b, off, "debian-binary/", "2.0\n");
    // Odd-sized (5 bytes) control.tar.zst to verify 2B even alignment
    off += writeArMember(*b, off, "control.tar.zst", "ZST01");
    // Odd-sized (7 bytes) data.tar.xz
    off += writeArMember(*b, off, "data.tar.xz", "XZDATA!");

    const deb = b[0..off];
    expect_eq(isDeb(deb), true);

    const pkg = parseDebPackage(deb) ?? unreachable;
    expect_eq(std.mem.eql(u8, pkg.format_version, "2.0"), true);
    expect_eq(std.mem.eql(u8, pkg.control_name, "control.tar.zst"), true);
    expect_eq(pkg.control_compression == DebCompression.zstd, true);
    expect_eq(std.mem.eql(u8, pkg.control_data, "ZST01"), true);
    expect_eq(std.mem.eql(u8, pkg.data_name, "data.tar.xz"), true);
    expect_eq(pkg.data_compression == DebCompression.xz, true);
    expect_eq(std.mem.eql(u8, pkg.data_data, "XZDATA!"), true);
});

test("2. detectDebCompression recognizes all Debian tar compression suffixes", () => {
    expect_eq((detectDebCompression("control.tar", "control.tar") ?? DebCompression.unknown) == DebCompression.none, true);
    expect_eq((detectDebCompression("control.tar.gz", "control.tar") ?? DebCompression.unknown) == DebCompression.gzip, true);
    expect_eq((detectDebCompression("data.tar.xz", "data.tar") ?? DebCompression.unknown) == DebCompression.xz, true);
    expect_eq((detectDebCompression("data.tar.zst", "data.tar") ?? DebCompression.unknown) == DebCompression.zstd, true);
    expect_eq((detectDebCompression("data.tar.bz2", "data.tar") ?? DebCompression.unknown) == DebCompression.bzip2, true);
    expect_eq((detectDebCompression("data.tar.lzma", "data.tar") ?? DebCompression.unknown) == DebCompression.lzma, true);
    expect_eq((detectDebCompression("data.tar.lz4", "data.tar") ?? DebCompression.none) == DebCompression.unknown, true);
    expect_eq(detectDebCompression("other.tar.gz", "data.tar") == null, true);
});

test("3. parseDebControl and DebControlIter decode multi-field RFC 822 metadata and multi-line Description", () => {
    const control_text =
        "# Generated by dpkg-deb\n\npackage: cap-runtime\nVersion: 1.4.2-1ubuntu1\nArchitecture: amd64\nMaintainer: CP Team <dev@cp-lang.org>\nSection: devel\nPriority: optional\nInstalled-Size: 4096\nDepends: libc6 (>= 2.35),\n libzstd1 (>= 1.5)\nDescription: High-performance CP runtime\n Pure native execution engine.\n .\n Zero-GC actor scheduler.\n";

    const meta = parseDebControl(control_text);
    expect_eq(meta.isValid(), true);
    expect_eq(std.mem.eql(u8, meta.package, "cap-runtime"), true);
    expect_eq(std.mem.eql(u8, meta.version, "1.4.2-1ubuntu1"), true);
    expect_eq(std.mem.eql(u8, meta.architecture, "amd64"), true);
    expect_eq(std.mem.eql(u8, meta.maintainer, "CP Team <dev@cp-lang.org>"), true);
    expect_eq(std.mem.eql(u8, meta.section, "devel"), true);
    expect_eq(std.mem.eql(u8, meta.priority, "optional"), true);
    expect_eq(meta.installed_size, 4096);
    expect_eq(std.mem.eql(u8, meta.depends, "libc6 (>= 2.35),\n libzstd1 (>= 1.5)"), true);
    expect_eq(
        std.mem.eql(
            u8,
            meta.description,
            "High-performance CP runtime\n Pure native execution engine.\n .\n Zero-GC actor scheduler.",
        ),
        true,
    );

    // Count fields via DebControlIter directly (9 fields total)
    let it = DebControlIter.init(control_text);
    let count: usize = 0;
    while (f := it.next()) {
        * = f.name.len;
        count += 1;
    }
    expect_eq(count, 9);
});

test("4. non-deb standard static library .a archives and wrong debian-binary versions are rejected", () => {
    let buf: [256]u8 = [0; 256];
    let b = buf[0..256];

    // Standard .a archive whose first member is a symbol table "/" or "foo.o/"
    let off: usize = 0;
    copyBytes(*b, off, DEB_AR_MAGIC);
    off += 8;
    off += writeArMember(*b, off, "foo.o/", "ELFDATA");
    expect_eq(isDeb(b[0..off]), false);
    expect_eq(parseDebPackage(b[0..off]) == null, true);

    // debian-binary with unsupported version "3.0\n"
    off = 0;
    copyBytes(*b, off, DEB_AR_MAGIC);
    off += 8;
    off += writeArMember(*b, off, "debian-binary", "3.0\n");
    off += writeArMember(*b, off, "control.tar.gz", "GZ");
    off += writeArMember(*b, off, "data.tar.gz", "GZ");
    expect_eq(isDeb(b[0..off]), false);
    expect_eq(parseDebPackage(b[0..off]) == null, true);
});

test("5. truncated archives, corrupted ar trailers, missing data.tar, and out-of-bounds sizes return null safely", () => {
    const empty: [0]u8 = [];
    expect_eq(isDeb(empty[0..0]), false);
    expect_eq(parseDebPackage(empty[0..0]) == null, true);

    let buf: [300]u8 = [0; 300];
    let b = buf[0..300];
    let off: usize = 0;
    copyBytes(*b, off, DEB_AR_MAGIC);
    off += 8;
    off += writeArMember(*b, off, "debian-binary", "2.0\n");
    off += writeArMember(*b, off, "control.tar.gz", "CTRL");

    // Missing data.tar* member => isDeb is true (valid header), parseDebPackage returns null
    expect_eq(isDeb(b[0..off]), true);
    expect_eq(parseDebPackage(b[0..off]) == null, true);

    // Add data.tar.gz then corrupt its trailer magic byte (58)
    const data_hdr_off = off;
    off += writeArMember(*b, off, "data.tar.gz", "DATA");
    b[data_hdr_off + 58] = 'X';
    expect_eq(parseDebPackage(b[0..off]) == null, true);
    b[data_hdr_off + 58] = 0x60;

    // Truncate inside data.tar.gz payload
    expect_eq(parseDebPackage(b[0 .. off - 2]) == null, true);

    // Out-of-bounds declared member size (99999 > buffer)
    copyBytes(*b, data_hdr_off + 48, "99999     ");
    expect_eq(parseDebPackage(b[0..off]) == null, true);
});
