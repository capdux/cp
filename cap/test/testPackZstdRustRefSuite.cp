// Origin: Pure-CP Stdlib Test Suite (lib/pack/zstdDecode.cp) | Created: 2026-11-23
// Reference-hardened against KillingSpark/zstd-rs (MIT): ruzstd/src/decoding/* & tests/*
// Authentic `/usr/bin/zstd` v1.5.5 cross-validation + RFC 8878 & ruzstd regression boundary suite:
//   1. Formatted Dictionary (0xEC30A437) via `zstd --train` + Dict_ID check + truncated/zero-offset dictionary guards
//   2. Raw Content Dictionary via `zstd -D` + missing-dict OffsetOutOfBounds guard
//   3. Multi-block small-window (`wlog=10`) cross-block Repeat_Mode & 4-Stream Huffman cross-validation
//   4. Empty block, zero-sequence compressed block, RLE block & Skippable + multi-frame concatenation
//   5. RFC 8878 / ruzstd malformed matrix: uninitialized Repeat_Mode/Treeless, block_size > min(window, 128KiB),
//      zero-sequence trailing garbage, 4-stream empty/overflow sub-streams, Content_Size mismatch & huge Window_Descriptor
//   6. 1,000-iteration deterministic fuzzing across both standard & dictionary decompression paths

import { test, expect_eq } from "cap:test";
import {
    ZSTD_DEC_MAGIC,
    ZSTD_DICT_MAGIC,
    ZSTD_MAX_BLOCK_BYTES,
    ZstdDecodeError,
    zstdInspectFrame,
    ZstdWorkspace,
    zstdDecompressWithDictInto,
    zstdDecompressInto,
} from "../../lib/pack/zstdDecode.cp";

fn bytesEq(a: []const u8, b: []const u8): bool {
    if (a.len != b.len) return false;
    let i: usize = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

fn crc32Ieee(bytes: []const u8): u32 {
    let crc: u32 = 0xFFFF_FFFF;
    let i: usize = 0;
    while (i < bytes.len) : (i += 1) {
        crc ^= @as(u32, bytes[i]);
        let b: usize = 0;
        while (b < 8) : (b += 1) {
            if ((crc & 1) != 0) {
                crc = (crc >> 1) ^ 0xEDB88320;
            } else {
                crc >>= 1;
            }
        }
    }
    return ~crc;
}

fn xorshift64(state: *u64): u64 {
    let x: u64 = state.*;
    x ^= x << 13;
    x ^= x >> 7;
    x ^= x << 17;
    state.* = x;
    return x;
}

