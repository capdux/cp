import {
    NameserverIter,
    ResolvOptions,
    effectiveSearchRaw,
    firstNameserver,
} from "cap:resolv_conf";
import { test, expect } from "cap:test";

fn strEq(a: []const u8, b: []const u8): bool {
    if (a.len != b.len) return false;
    let i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) return false;
        i += 1;
    }
    return true;
}

const SAMPLE_RESOLV =
    "# Generated by systemd-resolved\n" ++
    "; semicolon comment\n" ++
    "domain old.local\n" ++
    "search prod.svc.cluster.local svc.cluster.local\n" ++
    "nameserver 10.96.0.10 # kube-dns\n" ++
    "nameserver 2001:4860:4860::8888\n" ++
    "options ndots:5 timeout:2 attempts:3 edns0 trust-ad rotate\n";

test("NameserverIter, firstNameserver, effectiveSearchRaw, and ResolvOptions", () => {
    expect(strEq(firstNameserver(SAMPLE_RESOLV).?, "10.96.0.10"));

    let it = NameserverIter.init(SAMPLE_RESOLV);
    expect(strEq(it.next().?, "10.96.0.10"));
    expect(strEq(it.next().?, "2001:4860:4860::8888"));
    expect(it.next() == null);

    // Last search/domain directive wins
    expect(strEq(effectiveSearchRaw(SAMPLE_RESOLV).?, "prod.svc.cluster.local svc.cluster.local"));

    const opts = ResolvOptions.parse(SAMPLE_RESOLV);
    expect(opts.ndots == 5);
    expect(opts.timeout_sec == 2);
    expect(opts.attempts == 3);
    expect(opts.edns0 && opts.trust_ad && opts.rotate && !opts.use_vc);

    // Clamping per glibc limits
    const clamped = ResolvOptions.parse("options ndots:99 timeout:999 attempts:50 use-vc\n");
    expect(clamped.ndots == 15 && clamped.timeout_sec == 30 && clamped.attempts == 5 && clamped.use_vc);
});
