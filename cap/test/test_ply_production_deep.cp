// Source: cp/cap/test/test_ply_production_deep.cp (Production deep tests for cap:ply)

import std from "std";
import { test, expect_eq } from "cap:test";
import {
    PlyFormat,
    PlyHeader,
    PlyElement,
    isPly,
    parsePlyHeader,
    PlyElementIter,
    plyScalarSize,
} from "cap:ply";

const SAMPLE_PLY_ASCII: []const u8 =
    "ply\n" ++
    "format ascii 1.0\n" ++
    "comment Stanford Bunny mesh\n" ++
    "obj_info generated by cap:ply test\n" ++
    "element vertex 8\n" ++
    "property float x\n" ++
    "property float y\n" ++
    "property float z\n" ++
    "property uchar red\n" ++
    "property uchar green\n" ++
    "property uchar blue\n" ++
    "element face 12\n" ++
    "property list uchar int vertex_indices\n" ++
    "element edge 4\n" ++
    "property int vertex1\n" ++
    "property int vertex2\n" ++
    "end_header\n" ++
    "0.0 0.0 0.0 255 0 0\n";

test("1. isPly and parsePlyHeader parse ASCII PLY header and exact data_offset", () => {
    expect_eq(isPly(SAMPLE_PLY_ASCII), true);
    expect_eq(isPly("ply\r\nformat ascii 1.0\r\nend_header\r\n"), true);
    expect_eq(isPly("plywood\nformat ascii 1.0\n"), false);
    expect_eq(isPly(""), false);

    const hdr = parsePlyHeader(SAMPLE_PLY_ASCII) ?? unreachable;
    expect_eq(hdr.format == PlyFormat.ascii, true);
    expect_eq(std.mem.eql(u8, hdr.version, "1.0"), true);
    expect_eq(hdr.vertex_count, 8);
    expect_eq(hdr.face_count, 12);
    expect_eq(hdr.element_count, 3);

    // Payload starts right after `end_header\n`
    const payload = SAMPLE_PLY_ASCII[hdr.data_offset..];
    expect_eq(std.mem.eql(u8, payload, "0.0 0.0 0.0 255 0 0\n"), true);
});

test("2. parsePlyHeader supports binary_little_endian and binary_big_endian with CRLF", () => {
    const bin_le: []const u8 =
        "ply\r\n" ++
        "format binary_little_endian 1.0\r\n" ++
        "element vertex 1024\r\n" ++
        "property float32 x\r\n" ++
        "property float32 y\r\n" ++
        "property float32 z\r\n" ++
        "end_header\r\n" ++
        "\x01\x02\x03\x04";
    const h1 = parsePlyHeader(bin_le) ?? unreachable;
    expect_eq(h1.format == PlyFormat.binary_little_endian, true);
    expect_eq(h1.vertex_count, 1024);
    expect_eq(h1.face_count, 0);
    expect_eq(h1.element_count, 1);
    expect_eq(bin_le[h1.data_offset], 0x01);

    const bin_be: []const u8 =
        "ply\n" ++
        "format binary_big_endian 1.0\n" ++
        "element vertex 5\n" ++
        "property double x\n" ++
        "end_header\n";
    const h2 = parsePlyHeader(bin_be) ?? unreachable;
    expect_eq(h2.format == PlyFormat.binary_big_endian, true);
    expect_eq(h2.vertex_count, 5);
    expect_eq(h2.data_offset, bin_be.len);
});

test("3. PlyElementIter iterates elements and counts properties per element", () => {
    let it = PlyElementIter.init(SAMPLE_PLY_ASCII);

    const e0 = it.next() ?? unreachable;
    expect_eq(std.mem.eql(u8, e0.name, "vertex"), true);
    expect_eq(e0.count, 8);
    expect_eq(e0.property_count, 6);

    const e1 = it.next() ?? unreachable;
    expect_eq(std.mem.eql(u8, e1.name, "face"), true);
    expect_eq(e1.count, 12);
    expect_eq(e1.property_count, 1);

    const e2 = it.next() ?? unreachable;
    expect_eq(std.mem.eql(u8, e2.name, "edge"), true);
    expect_eq(e2.count, 4);
    expect_eq(e2.property_count, 2);

    expect_eq(it.next() == null, true);
});

test("4. plyScalarSize returns exact byte width for all standard PLY scalar types", () => {
    expect_eq(plyScalarSize("char") ?? 0, 1);
    expect_eq(plyScalarSize("uchar") ?? 0, 1);
    expect_eq(plyScalarSize("int8") ?? 0, 1);
    expect_eq(plyScalarSize("uint8") ?? 0, 1);

    expect_eq(plyScalarSize("short") ?? 0, 2);
    expect_eq(plyScalarSize("ushort") ?? 0, 2);
    expect_eq(plyScalarSize("int16") ?? 0, 2);
    expect_eq(plyScalarSize("uint16") ?? 0, 2);

    expect_eq(plyScalarSize("int") ?? 0, 4);
    expect_eq(plyScalarSize("uint") ?? 0, 4);
    expect_eq(plyScalarSize("float") ?? 0, 4);
    expect_eq(plyScalarSize("int32") ?? 0, 4);
    expect_eq(plyScalarSize("uint32") ?? 0, 4);
    expect_eq(plyScalarSize("float32") ?? 0, 4);

    expect_eq(plyScalarSize("double") ?? 0, 8);
    expect_eq(plyScalarSize("float64") ?? 0, 8);

    expect_eq(plyScalarSize("list") == null, true);
    expect_eq(plyScalarSize("string") == null, true);
});

test("5. Malformed PLY header protection: missing format, missing end_header, orphan property, invalid count", () => {
    // Missing format line
    expect_eq(parsePlyHeader("ply\nelement vertex 3\nend_header\n") == null, true);

    // Missing end_header
    expect_eq(parsePlyHeader("ply\nformat ascii 1.0\nelement vertex 3\n") == null, true);

    // Unknown format
    expect_eq(parsePlyHeader("ply\nformat compressed 1.0\nend_header\n") == null, true);

    // Property declared before any element
    expect_eq(parsePlyHeader("ply\nformat ascii 1.0\nproperty float x\nend_header\n") == null, true);

    // Non-numeric element count
    expect_eq(parsePlyHeader("ply\nformat ascii 1.0\nelement vertex abc\nend_header\n") == null, true);

    // PlyElementIter on invalid input yields null cleanly
    let bad_it = PlyElementIter.init("not a ply file");
    expect_eq(bad_it.next() == null, true);
});
