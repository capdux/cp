// Origin: Pure-CP Stdlib (AI Agent Parallel Tool-Call DAG Orchestrator & Wave Planner) | Created: 2026-11-23
// 100% pure CP zero-heap-allocation DAG orchestrator & parallel wave planner for AI Agent tool calls:
//   - Automatic RAW / WAR / WAW conflict edge inference across matching `resource_hash` entries
//     (`read_only` calls sharing a resource execute concurrently in the same wave;
//      `write_exclusive` serializes against prior/subsequent readers and writers;
//      `barrier_all` isolates all preceding and following calls into strictly separate waves)
//   - Explicit dependency edges (`addDependency`) with Kahn topological cycle detection (`cycle_detected`)
//   - Concurrency-capped wave scheduling (`max_parallel_per_wave`) with critical-path vs serial latency metrics
//   - Runtime readiness collection (`collectReadyCalls`) and transitive failure cascading (`skipped_dep_failed`)

// ============================================================================
// 1. Constants & Enums
// ============================================================================

/// Maximum number of tool calls stored inline inside a single `ToolCallGraph`.
pub const TOOL_GRAPH_MAX_CALLS: usize = 32;

/// Maximum number of explicit dependency edges registered via `addDependency`.
pub const TOOL_GRAPH_MAX_DEPS: usize = 64;

/// Maximum number of execution waves produced by `buildWavePlan`.
pub const TOOL_GRAPH_MAX_WAVES: usize = 32;

/// Maximum inline byte length for a tool call name.
pub const TOOL_GRAPH_NAME_MAX_LEN: usize = 48;

/// Concurrency access mode of a tool call against its target resource.
pub enum ToolAccessMode {
    read_only,
    write_exclusive,
    barrier_all,
}

/// Lifecycle execution state of a scheduled tool call node.
pub enum ToolCallExecState {
    pending,
    ready,
    running,
    succeeded,
    failed,
    skipped_dep_failed,
}

/// Status code returned by dependency registration and wave planning.
pub enum ToolGraphStatus {
    ok,
    cycle_detected,
    capacity_full,
    invalid_id,
}

// ============================================================================
// 2. Data Models (100% Zero-Heap Value Semantics)
// ============================================================================

/// Single tool call vertex stored inline inside `ToolCallGraph`.
pub struct ToolCallNode {
    call_id: u16 = 0;
    name_buf: [TOOL_GRAPH_NAME_MAX_LEN]u8 = [0; TOOL_GRAPH_NAME_MAX_LEN];
    name_len: usize = 0;
    resource_hash: u64 = 0;
    access_mode: ToolAccessMode = ToolAccessMode.read_only;
    est_cost_ms: u32 = 0;
    wave_index: u16 = 0;
    state: ToolCallExecState = ToolCallExecState.pending;

    /// Returns the stored tool name slice.
    fn tool_name(): []const u8 {
        return name_buf[0..name_len];
    }
}

/// Deterministic parallel execution wave plan generated by `buildWavePlan`.
pub struct ToolWavePlan {
    status: ToolGraphStatus = ToolGraphStatus.ok;
    wave_count: usize = 0;
    wave_sizes: [TOOL_GRAPH_MAX_WAVES]usize = [0; TOOL_GRAPH_MAX_WAVES];
    wave_members: [TOOL_GRAPH_MAX_WAVES][TOOL_GRAPH_MAX_CALLS]u16 = [[0; TOOL_GRAPH_MAX_CALLS]; TOOL_GRAPH_MAX_WAVES];
    critical_path_ms: u32 = 0;
    total_serial_ms: u32 = 0;
    auto_conflict_edges: usize = 0;
}

/// Aggregate execution progress statistics for `ToolCallGraph`.
pub struct ToolGraphStats {
    total_calls: usize = 0;
    succeeded: usize = 0;
    failed: usize = 0;
    skipped: usize = 0;
    completed_waves: usize = 0;
}

// ============================================================================
// 3. Internal Pure-CP Helpers
// ============================================================================

fn bitOf(idx: usize): u32 {
    return @as(u32, 1) << @as(u5, @intCast(idx));
}

fn satAddU32(a: u32, b: u32): u32 {
    if (a > 0xFFFFFFFF - b) {
        return 0xFFFFFFFF;
    }
    return a + b;
}

fn isTerminalState(st: ToolCallExecState): bool {
    return st == ToolCallExecState.succeeded ||
        st == ToolCallExecState.failed ||
        st == ToolCallExecState.skipped_dep_failed;
}

fn copyNameBytes(dst: *[]u8, src: []const u8): usize {
    const n: usize = if (src.len <= dst.len) src.len else dst.len;
    let i: usize = 0;
    while (i < n) : (i += 1) {
        dst[i] = src[i];
    }
    return n;
}

// ============================================================================
// 4. Core Engine: ToolCallGraph
// ============================================================================

/// Zero-heap-allocation parallel tool-call DAG orchestrator and wave planner.
pub struct ToolCallGraph {
    nodes: [TOOL_GRAPH_MAX_CALLS]ToolCallNode = [ToolCallNode{}; TOOL_GRAPH_MAX_CALLS];
    node_count: usize = 0;

    explicit_before: [TOOL_GRAPH_MAX_DEPS]u16 = [0; TOOL_GRAPH_MAX_DEPS];
    explicit_after: [TOOL_GRAPH_MAX_DEPS]u16 = [0; TOOL_GRAPH_MAX_DEPS];
    explicit_dep_count: usize = 0;

    adj_mask: [TOOL_GRAPH_MAX_CALLS]u32 = [0; TOOL_GRAPH_MAX_CALLS];
    rev_mask: [TOOL_GRAPH_MAX_CALLS]u32 = [0; TOOL_GRAPH_MAX_CALLS];
    planned: bool = false;
    planned_wave_count: usize = 0;

    /// Creates an empty `ToolCallGraph`.
    static fn init(): ToolCallGraph {
        return ToolCallGraph{};
    }

    /// Resets the graph to empty state for zero-allocation reuse.
    fn reset(*_) {
        let i: usize = 0;
        while (i < TOOL_GRAPH_MAX_CALLS) : (i += 1) {
            nodes[i] = ToolCallNode{};
            adj_mask[i] = 0;
            rev_mask[i] = 0;
        }
        node_count = 0;
        explicit_dep_count = 0;
        planned = false;
        planned_wave_count = 0;
    }

    /// Returns the number of registered tool calls.
    fn nodeCount(): usize {
        return node_count;
    }

    /// Returns a copy of the `ToolCallNode` for `call_id`, or `null` if out of range.
    fn getNode(call_id: u16): ToolCallNode? {
        const idx: usize = @as(usize, call_id);
        if (idx >= node_count) {
            return null;
        }
        return nodes[idx];
    }

    /// Registers a tool call node and returns its assigned `call_id`, or `null` when full.
    fn addCall(
        *_,
        tool_name: []const u8,
        resource_hash: u64,
        access_mode: ToolAccessMode,
        est_cost_ms: u32,
    ): u16? {
        if (node_count >= TOOL_GRAPH_MAX_CALLS) {
            return null;
        }
        const idx: usize = node_count;
        let node = ToolCallNode{
            call_id: @as(u16, @intCast(idx)),
            resource_hash: resource_hash,
            access_mode: access_mode,
            est_cost_ms: est_cost_ms,
            wave_index: 0,
            state: ToolCallExecState.pending,
        };
        let dst: []u8 = node.name_buf[0..];
        node.name_len = copyNameBytes(*dst, tool_name);
        nodes[idx] = node;
        node_count += 1;
        planned = false;
        return node.call_id;
    }

    /// Adds an explicit ordering constraint requiring `before_id` to succeed before `after_id`.
    fn addDependency(*_, before_id: u16, after_id: u16): ToolGraphStatus {
        const u: usize = @as(usize, before_id);
        const v: usize = @as(usize, after_id);
        if (u >= node_count || v >= node_count) {
            return ToolGraphStatus.invalid_id;
        }
        let i: usize = 0;
        while (i < explicit_dep_count) : (i += 1) {
            if (explicit_before[i] == before_id && explicit_after[i] == after_id) {
                return ToolGraphStatus.ok;
            }
        }
        if (explicit_dep_count >= TOOL_GRAPH_MAX_DEPS) {
            return ToolGraphStatus.capacity_full;
        }
        explicit_before[explicit_dep_count] = before_id;
        explicit_after[explicit_dep_count] = after_id;
        explicit_dep_count += 1;
        planned = false;
        return ToolGraphStatus.ok;
    }

    fn insertEdge(*_, u: usize, v: usize): bool {
        if (u == v || u >= node_count || v >= node_count) {
            return false;
        }
        const v_bit: u32 = bitOf(v);
        if ((adj_mask[u] & v_bit) != 0) {
            return false;
        }
        adj_mask[u] |= v_bit;
        rev_mask[v] |= bitOf(u);
        return true;
    }

    /// Builds the dependency DAG (explicit edges + automatic RAW/WAR/WAW & barrier edges),
    /// runs Kahn topological cycle detection, and assigns parallel waves bounded by
    /// `max_parallel_per_wave` (`0` = unbounded).
    fn buildWavePlan(*_, max_parallel_per_wave: usize): ToolWavePlan {
        let plan = ToolWavePlan{};

        let i: usize = 0;
        while (i < TOOL_GRAPH_MAX_CALLS) : (i += 1) {
            adj_mask[i] = 0;
            rev_mask[i] = 0;
        }
        planned = false;
        planned_wave_count = 0;

        if (node_count == 0) {
            planned = true;
            return plan;
        }

        // 1. Inject explicit dependencies (self-loop triggers immediate cycle_detected).
        let has_self_loop: bool = false;
        let e: usize = 0;
        while (e < explicit_dep_count) : (e += 1) {
            const u: usize = @as(usize, explicit_before[e]);
            const v: usize = @as(usize, explicit_after[e]);
            if (u == v) {
                has_self_loop = true;
                break;
            }
            * = insertEdge(u, v);
        }
        if (has_self_loop) {
            plan.status = ToolGraphStatus.cycle_detected;
            return plan;
        }

        // 2. Inject automatic RAW / WAR / WAW conflict edges for matching resource_hash.
        //    Track per-node conflict edges using last-writer + readers-since-last-writer in
        //    submission order so read_only calls remain parallel and redundant transitive edges
        //    are avoided.
        let auto_edges: usize = 0;
        let j: usize = 0;
        while (j < node_count) : (j += 1) {
            const mode_j = nodes[j].access_mode;
            if (mode_j == ToolAccessMode.barrier_all) {
                continue;
            }
            const res_j: u64 = nodes[j].resource_hash;
            if (res_j == 0) {
                continue;
            }

            if (mode_j == ToolAccessMode.read_only) {
                // RAW: depend on the most recent prior write_exclusive on the same resource.
                let k: usize = j;
                while (k > 0) {
                    k -= 1;
                    if (nodes[k].access_mode == ToolAccessMode.barrier_all) {
                        break;
                    }
                    if (nodes[k].resource_hash == res_j &&
                        nodes[k].access_mode == ToolAccessMode.write_exclusive)
                    {
                        if (insertEdge(k, j)) {
                            auto_edges += 1;
                        }
                        break;
                    }
                }
            } else {
                // write_exclusive:
                // WAR against all read_only calls since the last write_exclusive on res_j;
                // if no intervening readers exist, WAW against the last write_exclusive.
                let found_reader: bool = false;
                let k: usize = j;
                while (k > 0) {
                    k -= 1;
                    if (nodes[k].access_mode == ToolAccessMode.barrier_all) {
                        break;
                    }
                    if (nodes[k].resource_hash != res_j) {
                        continue;
                    }
                    if (nodes[k].access_mode == ToolAccessMode.read_only) {
                        if (insertEdge(k, j)) {
                            auto_edges += 1;
                        }
                        found_reader = true;
                    } else if (nodes[k].access_mode == ToolAccessMode.write_exclusive) {
                        if (!found_reader) {
                            if (insertEdge(k, j)) {
                                auto_edges += 1;
                            }
                        }
                        break;
                    }
                }
            }
        }

        // 3. Inject barrier_all isolation edges:
        //    Every call in the segment before a barrier must finish before the barrier;
        //    every call in the segment after a barrier must start after the barrier.
        let prev_barrier_plus_one: usize = 0;
        let b: usize = 0;
        while (b < node_count) : (b += 1) {
            if (nodes[b].access_mode != ToolAccessMode.barrier_all) {
                continue;
            }
            // Predecessors: all nodes in [prev_barrier_plus_one .. b), plus previous barrier if segment is empty.
            let seg_start: usize = prev_barrier_plus_one;
            if (seg_start == b && prev_barrier_plus_one > 0) {
                if (insertEdge(prev_barrier_plus_one - 1, b)) {
                    auto_edges += 1;
                }
            } else {
                let p: usize = seg_start;
                while (p < b) : (p += 1) {
                    if (insertEdge(p, b)) {
                        auto_edges += 1;
                    }
                }
            }

            // Successors: all nodes after b up to (and excluding) the next barrier.
            let s: usize = b + 1;
            while (s < node_count) : (s += 1) {
                if (nodes[s].access_mode == ToolAccessMode.barrier_all) {
                    break;
                }
                if (insertEdge(b, s)) {
                    auto_edges += 1;
                }
            }

            prev_barrier_plus_one = b + 1;
        }
        plan.auto_conflict_edges = auto_edges;

        // 4. Kahn topological sort for cycle detection.
        let in_deg: [TOOL_GRAPH_MAX_CALLS]u16 = [0; TOOL_GRAPH_MAX_CALLS];
        let rem_deg: [TOOL_GRAPH_MAX_CALLS]u16 = [0; TOOL_GRAPH_MAX_CALLS];
        let v_idx: usize = 0;
        while (v_idx < node_count) : (v_idx += 1) {
            let deg: u16 = 0;
            let u_idx: usize = 0;
            while (u_idx < node_count) : (u_idx += 1) {
                if ((rev_mask[v_idx] & bitOf(u_idx)) != 0) {
                    deg += 1;
                }
            }
            in_deg[v_idx] = deg;
            rem_deg[v_idx] = deg;
        }

        let queue: [TOOL_GRAPH_MAX_CALLS]u16 = [0; TOOL_GRAPH_MAX_CALLS];
        let q_head: usize = 0;
        let q_tail: usize = 0;
        let q_i: usize = 0;
        while (q_i < node_count) : (q_i += 1) {
            if (in_deg[q_i] == 0) {
                queue[q_tail] = @as(u16, @intCast(q_i));
                q_tail += 1;
            }
        }

        let visited: usize = 0;
        while (q_head < q_tail) {
            const u: usize = @as(usize, queue[q_head]);
            q_head += 1;
            visited += 1;

            let dst: usize = 0;
            while (dst < node_count) : (dst += 1) {
                if ((adj_mask[u] & bitOf(dst)) != 0) {
                    in_deg[dst] -= 1;
                    if (in_deg[dst] == 0) {
                        queue[q_tail] = @as(u16, @intCast(dst));
                        q_tail += 1;
                    }
                }
            }
        }

        if (visited < node_count) {
            plan.status = ToolGraphStatus.cycle_detected;
            return plan;
        }

        // 5. Wave-by-wave scheduling with optional `max_parallel_per_wave` cap.
        const cap: usize = if (max_parallel_per_wave == 0 || max_parallel_per_wave > TOOL_GRAPH_MAX_CALLS)
            TOOL_GRAPH_MAX_CALLS
        else
            max_parallel_per_wave;

        let scheduled: [TOOL_GRAPH_MAX_CALLS]bool = [false; TOOL_GRAPH_MAX_CALLS];
        let scheduled_count: usize = 0;
        let wave_idx: usize = 0;
        let critical_ms: u32 = 0;

        while (scheduled_count < node_count && wave_idx < TOOL_GRAPH_MAX_WAVES) {
            let count_in_wave: usize = 0;
            let wave_max_ms: u32 = 0;

            let c: usize = 0;
            while (c < node_count && count_in_wave < cap) : (c += 1) {
                if (!scheduled[c] && rem_deg[c] == 0) {
                    plan.wave_members[wave_idx][count_in_wave] = @as(u16, @intCast(c));
                    count_in_wave += 1;
                    if (nodes[c].est_cost_ms > wave_max_ms) {
                        wave_max_ms = nodes[c].est_cost_ms;
                    }
                }
            }

            if (count_in_wave == 0) {
                plan.status = ToolGraphStatus.cycle_detected;
                return plan;
            }

            plan.wave_sizes[wave_idx] = count_in_wave;
            critical_ms = satAddU32(critical_ms, wave_max_ms);

            // Commit this wave and decrement downstream in-degrees after the full wave is chosen.
            let m: usize = 0;
            while (m < count_in_wave) : (m += 1) {
                const u: usize = @as(usize, plan.wave_members[wave_idx][m]);
                scheduled[u] = true;
                scheduled_count += 1;
                nodes[u].wave_index = @as(u16, @intCast(wave_idx));

                let dst: usize = 0;
                while (dst < node_count) : (dst += 1) {
                    if ((adj_mask[u] & bitOf(dst)) != 0 && rem_deg[dst] > 0) {
                        rem_deg[dst] -= 1;
                    }
                }
            }

            wave_idx += 1;
        }

        // 6. Compute total serial cost and initialize node readiness states.
        let serial_ms: u32 = 0;
        let n_i: usize = 0;
        while (n_i < node_count) : (n_i += 1) {
            serial_ms = satAddU32(serial_ms, nodes[n_i].est_cost_ms);
            if (!isTerminalState(nodes[n_i].state)) {
                if (rev_mask[n_i] == 0) {
                    nodes[n_i].state = ToolCallExecState.ready;
                } else {
                    nodes[n_i].state = ToolCallExecState.pending;
                }
            }
        }

        plan.status = ToolGraphStatus.ok;
        plan.wave_count = wave_idx;
        plan.critical_path_ms = critical_ms;
        plan.total_serial_ms = serial_ms;
        planned = true;
        planned_wave_count = wave_idx;
        return plan;
    }

    /// Optionally marks a `ready` call as `running`.
    fn markRunning(*_, call_id: u16): ToolGraphStatus {
        const idx: usize = @as(usize, call_id);
        if (idx >= node_count) {
            return ToolGraphStatus.invalid_id;
        }
        if (nodes[idx].state == ToolCallExecState.ready) {
            nodes[idx].state = ToolCallExecState.running;
        }
        return ToolGraphStatus.ok;
    }

    /// Marks `call_id` as `succeeded` or `failed`.
    /// - On success: promotes downstream `pending` calls whose predecessors all succeeded to `ready`; returns `0`.
    /// - On failure: transitively cascades `skipped_dep_failed` to all non-terminal downstream dependents
    ///   and returns the count of newly skipped calls.
    fn markResult(*_, call_id: u16, succeeded: bool): usize {
        const idx: usize = @as(usize, call_id);
        if (idx >= node_count) {
            return 0;
        }

        if (succeeded) {
            nodes[idx].state = ToolCallExecState.succeeded;

            let v: usize = 0;
            while (v < node_count) : (v += 1) {
                if (nodes[v].state != ToolCallExecState.pending) {
                    continue;
                }
                const preds: u32 = rev_mask[v];
                let all_done: bool = true;
                let p: usize = 0;
                while (p < node_count) : (p += 1) {
                    if ((preds & bitOf(p)) != 0) {
                        if (nodes[p].state != ToolCallExecState.succeeded) {
                            all_done = false;
                            break;
                        }
                    }
                }
                if (all_done) {
                    nodes[v].state = ToolCallExecState.ready;
                }
            }
            return 0;
        }

        // Failure path: BFS cascade to all reachable downstream non-terminal dependents.
        nodes[idx].state = ToolCallExecState.failed;

        let queue: [TOOL_GRAPH_MAX_CALLS]u16 = [0; TOOL_GRAPH_MAX_CALLS];
        let in_q: [TOOL_GRAPH_MAX_CALLS]bool = [false; TOOL_GRAPH_MAX_CALLS];
        let q_head: usize = 0;
        let q_tail: usize = 0;

        queue[q_tail] = call_id;
        q_tail += 1;
        in_q[idx] = true;

        let newly_skipped: usize = 0;
        while (q_head < q_tail) {
            const u: usize = @as(usize, queue[q_head]);
            q_head += 1;

            let v: usize = 0;
            while (v < node_count) : (v += 1) {
                if ((adj_mask[u] & bitOf(v)) != 0 && !in_q[v]) {
                    in_q[v] = true;
                    if (!isTerminalState(nodes[v].state)) {
                        nodes[v].state = ToolCallExecState.skipped_dep_failed;
                        newly_skipped += 1;
                    }
                    queue[q_tail] = @as(u16, @intCast(v));
                    q_tail += 1;
                }
            }
        }
        return newly_skipped;
    }

    /// Collects all currently `ready` call IDs in ascending `call_id` order into `out_ids`.
    /// Returns the number of IDs written.
    fn collectReadyCalls(out_ids: *[]u16): usize {
        let written: usize = 0;
        let i: usize = 0;
        while (i < node_count && written < out_ids.len) : (i += 1) {
            if (nodes[i].state == ToolCallExecState.ready) {
                out_ids[written] = nodes[i].call_id;
                written += 1;
            }
        }
        return written;
    }

    /// Computes aggregate execution statistics across all registered calls and planned waves.
    fn stats(): ToolGraphStats {
        let st = ToolGraphStats{
            total_calls: node_count,
        };
        let i: usize = 0;
        while (i < node_count) : (i += 1) {
            if (nodes[i].state == ToolCallExecState.succeeded) {
                st.succeeded += 1;
            } else if (nodes[i].state == ToolCallExecState.failed) {
                st.failed += 1;
            } else if (nodes[i].state == ToolCallExecState.skipped_dep_failed) {
                st.skipped += 1;
            }
        }

        if (planned && planned_wave_count > 0) {
            let w: usize = 0;
            while (w < planned_wave_count) : (w += 1) {
                let has_member: bool = false;
                let all_terminal: bool = true;
                let k: usize = 0;
                while (k < node_count) : (k += 1) {
                    if (@as(usize, nodes[k].wave_index) == w) {
                        has_member = true;
                        if (!isTerminalState(nodes[k].state)) {
                            all_terminal = false;
                            break;
                        }
                    }
                }
                if (has_member && all_terminal) {
                    st.completed_waves += 1;
                }
            }
        }

        return st;
    }
}
