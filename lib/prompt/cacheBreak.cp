// Origin: Pure-CP Stdlib (Zero-Alloc LLM Prompt Prefix Cache Breakpoint Planner & Bust Diagnostics) | Created: 2026-11-23
// Pure CP zero-heap-allocation Anthropic/OpenAI LLM Prompt Prefix Caching Optimizer & Diagnostics:
//   - Fixed 32-block prompt segment model (`system | tools | docs | few_shot | history | user_query`)
//     with deterministic FNV-1a content hashing & `volatile_hint` stability annotations
//   - Automatic breakpoint planner (`planCacheBreakpoints`): enforces vendor `max_breakpoints <= 4` and
//     `min_cache_tokens`, halts before volatile/user-query regions, maximizes reusable prefix coverage,
//     and flags `has_order_anti_pattern` when volatile blocks precede static stable segments
//   - Cross-turn cache hit & bust root-cause diagnostics (`diffWithPrevTurn`): computes exact
//     `cached_read_tokens`, `cache_write_tokens`, `uncached_tokens`, `first_bust_index`, `bust_reason`,
//     and net cost `savings_bps` under Anthropic/OpenAI pricing models
//   - Zero-heap stateful multi-turn tracker (`PromptCacheTracker`) & global telemetry (`PromptCacheStats`)

// ============================================================================
// 1. Constants, Enums & Data Models
// ============================================================================

/// Maximum number of prompt blocks supported per turn (zero dynamic heap).
pub const CACHE_BREAK_MAX_BLOCKS: usize = 32;

/// Maximum number of explicit cache breakpoints supported per turn (Anthropic limit = 4).
pub const CACHE_BREAK_MAX_BREAKPOINTS: usize = 4;

/// Basis-point scale (10000 bps = 100.00%).
pub const CACHE_BREAK_BPS_SCALE: u32 = 10_000;

/// Logical role of a prompt segment ordered from most static (`system`) to most volatile (`user_query`).
pub enum CacheBlockRole {
    system,
    tools,
    docs,
    few_shot,
    history,
    user_query,
}

/// Primary root cause explaining why a turn failed to reuse the full previous cache prefix.
pub enum CacheBustReason {
    none,
    content_changed,
    role_changed,
    volatile_inserted,
    prefix_shortened,
    below_min_tokens,
}

/// Single prompt segment descriptor.
pub struct PromptCacheBlock {
    block_id: u32 = 0;
    role: CacheBlockRole = CacheBlockRole.system;
    content_hash: u64 = 0;
    token_count: u32 = 0;
    volatile_hint: bool = false;

    static fn make(
        block_id: u32,
        role: CacheBlockRole,
        content_hash: u64,
        token_count: u32,
        volatile_hint: bool,
    ): PromptCacheBlock {
        return PromptCacheBlock{
            block_id: block_id,
            role: role,
            content_hash: content_hash,
            token_count: token_count,
            volatile_hint: volatile_hint,
        };
    }
}

/// Vendor-specific prompt caching policy & pricing parameters (in basis points of base input price).
pub struct CacheBreakConfig {
    max_breakpoints: usize = CACHE_BREAK_MAX_BREAKPOINTS;
    min_cache_tokens: u32 = 1024;
    min_segment_delta_tokens: u32 = 256;
    cache_read_cost_bps: u32 = 1000;   // 10% of base input cost (Anthropic)
    cache_write_cost_bps: u32 = 12500; // 125% of base input cost (Anthropic 5m TTL)

    /// Anthropic Claude prompt caching defaults (4 breakpoints, 1024 min tokens, 0.1x read, 1.25x write).
    static fn anthropicDefaults(): CacheBreakConfig {
        return CacheBreakConfig{};
    }

    /// OpenAI automatic prompt caching defaults (1024 min tokens, 0.5x read, 1.0x write).
    static fn openAiDefaults(): CacheBreakConfig {
        return CacheBreakConfig{
            max_breakpoints: CACHE_BREAK_MAX_BREAKPOINTS,
            min_cache_tokens: 1024,
            min_segment_delta_tokens: 256,
            cache_read_cost_bps: 5000,
            cache_write_cost_bps: 10000,
        };
    }
}

/// Output plan generated by `planCacheBreakpoints`.
pub struct CacheBreakpointPlan {
    total_blocks: usize = 0;
    total_tokens: u64 = 0;
    stable_prefix_blocks: usize = 0;
    stable_prefix_tokens: u64 = 0;
    breakpoint_indices: [CACHE_BREAK_MAX_BREAKPOINTS]usize = [0; CACHE_BREAK_MAX_BREAKPOINTS];
    breakpoint_prefix_tokens: [CACHE_BREAK_MAX_BREAKPOINTS]u64 = [0; CACHE_BREAK_MAX_BREAKPOINTS];
    breakpoint_count: usize = 0;
    cacheable_tokens: u64 = 0;
    uncached_tokens: u64 = 0;
    has_order_anti_pattern: bool = false;
    anti_pattern_count: u32 = 0;
    has_volatile: bool = false;
    first_volatile_index: usize = 0;
}

/// Cross-turn cache hit/write/bust diagnostic report returned by `diffWithPrevTurn`.
pub struct CacheTurnDiff {
    curr_total_tokens: u64 = 0;
    common_prefix_blocks: usize = 0;
    common_prefix_tokens: u64 = 0;
    cached_read_tokens: u64 = 0;
    cache_write_tokens: u64 = 0;
    uncached_tokens: u64 = 0;
    has_bust: bool = false;
    first_bust_index: usize = 0;
    bust_reason: CacheBustReason = CacheBustReason.none;
    baseline_cost_units: u64 = 0;
    effective_cost_units: u64 = 0;
    savings_bps: i32 = 0;
    has_order_anti_pattern: bool = false;
}

/// Zero-heap global telemetry snapshot for `PromptCacheTracker`.
pub struct PromptCacheStats {
    total_turns: u64 = 0;
    total_tokens: u64 = 0;
    total_cached_read_tokens: u64 = 0;
    total_cache_write_tokens: u64 = 0;
    total_uncached_tokens: u64 = 0;
    cache_hit_turns: u64 = 0;
    cache_bust_turns: u64 = 0;
    anti_pattern_turns: u64 = 0;
    cumulative_savings_bps: i32 = 0;
}

// ============================================================================
// 2. Hashing, Role Ordering & Breakpoint Planning Functions
// ============================================================================

/// Compute a deterministic 64-bit FNV-1a hash of prompt text bytes for `PromptCacheBlock.content_hash`.
pub fn hashCacheBlockBytes(data: []const u8): u64 {
    let h: u64 = 14695981039346656037;
    let i: usize = 0;
    while (i < data.len) : (i += 1) {
        h = h ^ @as(u64, data[i]);
        h = h *% 1099511628211;
    }
    return h;
}

/// Canonical stability rank of a `CacheBlockRole` (lower = more static, should appear earlier).
pub fn cacheRoleRank(role: CacheBlockRole): u8 {
    if (role == CacheBlockRole.system) return 0;
    if (role == CacheBlockRole.tools) return 1;
    if (role == CacheBlockRole.docs) return 2;
    if (role == CacheBlockRole.few_shot) return 3;
    if (role == CacheBlockRole.history) return 4;
    return 5; // user_query
}

fn isStaticRole(role: CacheBlockRole): bool {
    return cacheRoleRank(role) <= 3;
}

fn effectiveMaxBreakpoints(cfg: CacheBreakConfig): usize {
    if (cfg.max_breakpoints == 0) return 0;
    if (cfg.max_breakpoints > CACHE_BREAK_MAX_BREAKPOINTS) return CACHE_BREAK_MAX_BREAKPOINTS;
    return cfg.max_breakpoints;
}

fn computeSavingsBps(baseline_units: u64, effective_units: u64): i32 {
    if (baseline_units == 0) return 0;
    if (baseline_units >= effective_units) {
        const diff = baseline_units - effective_units;
        const bps = (diff * @as(u64, CACHE_BREAK_BPS_SCALE)) / baseline_units;
        return @as(i32, @intCast(bps));
    }
    const over = effective_units - baseline_units;
    const bps = (over * @as(u64, CACHE_BREAK_BPS_SCALE)) / baseline_units;
    return -@as(i32, @intCast(bps));
}

/// Plan optimal prefix cache breakpoints for `blocks` under `cfg` and write the result into `out_plan`.
///   - Stops placing breakpoints at the first `volatile_hint` or `user_query` block
///   - Places up to `cfg.max_breakpoints` breakpoints (<= 4) once cumulative tokens >= `min_cache_tokens`
///   - Flags `has_order_anti_pattern` when a static block appears after a volatile/user_query block
///     or when a more-static role (`system`/`tools`/`docs`/`few_shot`) appears after a less-static role
pub fn planCacheBreakpoints(
    blocks: []const PromptCacheBlock,
    cfg: CacheBreakConfig,
    out_plan: *CacheBreakpointPlan,
) {
    let plan = CacheBreakpointPlan{};
    const n = if (blocks.len > CACHE_BREAK_MAX_BLOCKS) CACHE_BREAK_MAX_BLOCKS else blocks.len;
    plan.total_blocks = n;

    // 1. Scan total tokens, stable prefix boundary, and ordering anti-patterns.
    let stable_end: usize = n;
    let found_volatile = false;
    let max_rank_seen: u8 = 0;

    let i: usize = 0;
    while (i < n) : (i += 1) {
        const b = blocks[i];
        plan.total_tokens += @as(u64, b.token_count);
        const rank = cacheRoleRank(b.role);
        const is_vol = b.volatile_hint or b.role == CacheBlockRole.user_query;

        if (is_vol) {
            if (!found_volatile) {
                found_volatile = true;
                stable_end = i;
                plan.has_volatile = true;
                plan.first_volatile_index = i;
            }
        } else {
            if (found_volatile) {
                // Static/stable block placed after a volatile block breaks prefix caching!
                plan.has_order_anti_pattern = true;
                plan.anti_pattern_count += 1;
            } else if (i > 0 and isStaticRole(b.role) and rank < max_rank_seen) {
                // E.g. `system` or `tools` placed after `history` or `docs`
                plan.has_order_anti_pattern = true;
                plan.anti_pattern_count += 1;
            }
        }

        if (rank > max_rank_seen) {
            max_rank_seen = rank;
        }
    }

    plan.stable_prefix_blocks = stable_end;

    // Compute cumulative tokens across the stable prefix.
    let cum_tokens: [CACHE_BREAK_MAX_BLOCKS]u64 = [0; CACHE_BREAK_MAX_BLOCKS];
    let running: u64 = 0;
    i = 0;
    while (i < stable_end) : (i += 1) {
        running += @as(u64, blocks[i].token_count);
        cum_tokens[i] = running;
    }
    plan.stable_prefix_tokens = running;

    const max_bp = effectiveMaxBreakpoints(cfg);
    const min_tok = @as(u64, cfg.min_cache_tokens);
    const min_delta = @as(u64, cfg.min_segment_delta_tokens);

    if (stable_end == 0 or max_bp == 0 or running < min_tok) {
        plan.cacheable_tokens = 0;
        plan.uncached_tokens = plan.total_tokens;
        out_plan.* = plan;
        return;
    }

    // 2. Collect candidate breakpoints at role transitions and the end of the stable prefix.
    let cand_idx: [CACHE_BREAK_MAX_BLOCKS]usize = [0; CACHE_BREAK_MAX_BLOCKS];
    let cand_tok: [CACHE_BREAK_MAX_BLOCKS]u64 = [0; CACHE_BREAK_MAX_BLOCKS];
    let cand_count: usize = 0;
    let last_cand_tok: u64 = 0;

    let k: usize = 0;
    while (k < stable_end) : (k += 1) {
        const is_last_stable = (k + 1 == stable_end);
        const is_role_boundary = !is_last_stable and (blocks[k].role != blocks[k + 1].role);
        if (!is_last_stable and !is_role_boundary) continue;
        if (cum_tokens[k] < min_tok) continue;

        if (cand_count == 0 or is_last_stable or (cum_tokens[k] - last_cand_tok) >= min_delta) {
            // If last stable block is identical in tokens to previous candidate (0-token tail), replace it.
            if (cand_count > 0 and cum_tokens[k] == last_cand_tok) {
                cand_idx[cand_count - 1] = k;
            } else {
                cand_idx[cand_count] = k;
                cand_tok[cand_count] = cum_tokens[k];
                cand_count += 1;
                last_cand_tok = cum_tokens[k];
            }
        }
    }

    // 3. Select up to `max_bp` breakpoints, always keeping the final stable boundary for max coverage.
    if (cand_count <= max_bp) {
        let j: usize = 0;
        while (j < cand_count) : (j += 1) {
            plan.breakpoint_indices[j] = cand_idx[j];
            plan.breakpoint_prefix_tokens[j] = cand_tok[j];
        }
        plan.breakpoint_count = cand_count;
    } else {
        // Keep the latest `max_bp` candidates so we maximize reusable prefix coverage including tail.
        const start_c = cand_count - max_bp;
        let j: usize = 0;
        while (j < max_bp) : (j += 1) {
            plan.breakpoint_indices[j] = cand_idx[start_c + j];
            plan.breakpoint_prefix_tokens[j] = cand_tok[start_c + j];
        }
        plan.breakpoint_count = max_bp;
    }

    if (plan.breakpoint_count > 0) {
        plan.cacheable_tokens = plan.breakpoint_prefix_tokens[plan.breakpoint_count - 1];
    }
    plan.uncached_tokens = plan.total_tokens - plan.cacheable_tokens;
    out_plan.* = plan;
}

/// Diagnose cross-turn prefix cache reuse, cache writes, root-cause bust index & cost savings.
pub fn diffWithPrevTurn(
    prev_blocks: []const PromptCacheBlock,
    curr_blocks: []const PromptCacheBlock,
    cfg: CacheBreakConfig,
): CacheTurnDiff {
    let prev_plan = CacheBreakpointPlan{};
    let curr_plan = CacheBreakpointPlan{};
    planCacheBreakpoints(prev_blocks, cfg, *prev_plan);
    planCacheBreakpoints(curr_blocks, cfg, *curr_plan);

    let out = CacheTurnDiff{};
    out.curr_total_tokens = curr_plan.total_tokens;
    out.has_order_anti_pattern = curr_plan.has_order_anti_pattern;

    const prev_n = prev_plan.total_blocks;
    const curr_n = curr_plan.total_blocks;
    const min_n = if (prev_n < curr_n) prev_n else curr_n;

    // 1. Walk matching prefix blocks between previous turn and current turn.
    let common_blocks: usize = 0;
    let common_tokens: u64 = 0;
    let bust_found = false;
    let bust_idx: usize = 0;
    let bust_reason = CacheBustReason.none;

    let i: usize = 0;
    while (i < min_n) : (i += 1) {
        const pb = prev_blocks[i];
        const cb = curr_blocks[i];
        const p_vol = pb.volatile_hint or pb.role == CacheBlockRole.user_query;
        const c_vol = cb.volatile_hint or cb.role == CacheBlockRole.user_query;

        if (c_vol or p_vol) {
            if (i < prev_plan.stable_prefix_blocks) {
                bust_found = true;
                bust_idx = i;
                bust_reason = CacheBustReason.volatile_inserted;
            }
            break;
        }
        if (pb.role != cb.role) {
            bust_found = true;
            bust_idx = i;
            bust_reason = CacheBustReason.role_changed;
            break;
        }
        if (pb.content_hash != cb.content_hash or pb.token_count != cb.token_count) {
            bust_found = true;
            bust_idx = i;
            bust_reason = CacheBustReason.content_changed;
            break;
        }
        common_blocks += 1;
        common_tokens += @as(u64, cb.token_count);
    }

    if (!bust_found and curr_n < prev_plan.stable_prefix_blocks) {
        bust_found = true;
        bust_idx = curr_n;
        bust_reason = CacheBustReason.prefix_shortened;
    }

    out.common_prefix_blocks = common_blocks;
    out.common_prefix_tokens = common_tokens;

    // 2. Cached read hits only up to the largest breakpoint from `prev_plan` wholly inside `common_blocks`.
    let hit_tokens: u64 = 0;
    if (common_blocks > 0 and prev_plan.breakpoint_count > 0) {
        let bp_i: usize = 0;
        while (bp_i < prev_plan.breakpoint_count) : (bp_i += 1) {
            if (prev_plan.breakpoint_indices[bp_i] < common_blocks) {
                hit_tokens = prev_plan.breakpoint_prefix_tokens[bp_i];
            }
        }
    }

    // Cap hit_tokens by current plan's cacheable prefix & min_cache_tokens.
    if (hit_tokens < @as(u64, cfg.min_cache_tokens)) {
        hit_tokens = 0;
        if (!bust_found and prev_n > 0 and curr_plan.total_tokens > 0 and common_tokens < @as(u64, cfg.min_cache_tokens)) {
            bust_found = true;
            bust_idx = common_blocks;
            bust_reason = CacheBustReason.below_min_tokens;
        }
    }
    if (hit_tokens > curr_plan.total_tokens) {
        hit_tokens = curr_plan.total_tokens;
    }

    out.cached_read_tokens = hit_tokens;
    if (curr_plan.cacheable_tokens > hit_tokens) {
        out.cache_write_tokens = curr_plan.cacheable_tokens - hit_tokens;
    } else {
        out.cache_write_tokens = 0;
    }
    const covered = out.cached_read_tokens + out.cache_write_tokens;
    out.uncached_tokens = if (curr_plan.total_tokens > covered) curr_plan.total_tokens - covered else 0;

    // Report bust when previous turn had a cached prefix that was not fully reused.
    if (bust_found and prev_plan.cacheable_tokens > 0 and hit_tokens < prev_plan.cacheable_tokens) {
        out.has_bust = true;
        out.first_bust_index = bust_idx;
        out.bust_reason = bust_reason;
    } else if (bust_reason == CacheBustReason.below_min_tokens and prev_n > 0) {
        out.has_bust = true;
        out.first_bust_index = bust_idx;
        out.bust_reason = bust_reason;
    }

    // 3. Pricing model cost & net savings in basis points.
    const base_cost = curr_plan.total_tokens * @as(u64, CACHE_BREAK_BPS_SCALE);
    const eff_cost = out.cached_read_tokens * @as(u64, cfg.cache_read_cost_bps) +
        out.cache_write_tokens * @as(u64, cfg.cache_write_cost_bps) +
        out.uncached_tokens * @as(u64, CACHE_BREAK_BPS_SCALE);

    out.baseline_cost_units = base_cost;
    out.effective_cost_units = eff_cost;
    out.savings_bps = computeSavingsBps(base_cost, eff_cost);
    return out;
}

// ============================================================================
// 3. PromptCacheTracker — Zero-Heap Multi-Turn Cache Telemetry Tracker
// ============================================================================

/// Zero-heap stateful multi-turn prompt cache tracker retaining the previous turn snapshot.
pub struct PromptCacheTracker {
    config: CacheBreakConfig = CacheBreakConfig{},
    prev_blocks: [CACHE_BREAK_MAX_BLOCKS]PromptCacheBlock = [PromptCacheBlock{}; CACHE_BREAK_MAX_BLOCKS];
    prev_count: usize = 0;

    total_turns: u64 = 0;
    total_tokens: u64 = 0;
    total_cached_read_tokens: u64 = 0;
    total_cache_write_tokens: u64 = 0;
    total_uncached_tokens: u64 = 0;
    total_baseline_cost: u64 = 0;
    total_effective_cost: u64 = 0;
    cache_hit_turns: u64 = 0;
    cache_bust_turns: u64 = 0;
    anti_pattern_turns: u64 = 0;

    static fn init(cfg: CacheBreakConfig): PromptCacheTracker {
        let t = PromptCacheTracker{};
        t.config = cfg;
        return t;
    }

    pub fn reset(*_) {
        prev_count = 0;
        total_turns = 0;
        total_tokens = 0;
        total_cached_read_tokens = 0;
        total_cache_write_tokens = 0;
        total_uncached_tokens = 0;
        total_baseline_cost = 0;
        total_effective_cost = 0;
        cache_hit_turns = 0;
        cache_bust_turns = 0;
        anti_pattern_turns = 0;
    }

    /// Record a new turn's prompt blocks, diff against the previous turn, and update global stats.
    pub fn recordTurn(*_, curr_blocks: []const PromptCacheBlock): CacheTurnDiff {
        const diff = diffWithPrevTurn(prev_blocks[0..prev_count], curr_blocks, config);

        const n = if (curr_blocks.len > CACHE_BREAK_MAX_BLOCKS) CACHE_BREAK_MAX_BLOCKS else curr_blocks.len;
        let i: usize = 0;
        while (i < n) : (i += 1) {
            prev_blocks[i] = curr_blocks[i];
        }
        prev_count = n;

        total_turns += 1;
        total_tokens += diff.curr_total_tokens;
        total_cached_read_tokens += diff.cached_read_tokens;
        total_cache_write_tokens += diff.cache_write_tokens;
        total_uncached_tokens += diff.uncached_tokens;
        total_baseline_cost += diff.baseline_cost_units;
        total_effective_cost += diff.effective_cost_units;

        if (diff.cached_read_tokens > 0) {
            cache_hit_turns += 1;
        }
        if (diff.has_bust) {
            cache_bust_turns += 1;
        }
        if (diff.has_order_anti_pattern) {
            anti_pattern_turns += 1;
        }
        return diff;
    }

    /// Return a zero-heap global telemetry snapshot.
    pub fn stats(): PromptCacheStats {
        return PromptCacheStats{
            total_turns: total_turns,
            total_tokens: total_tokens,
            total_cached_read_tokens: total_cached_read_tokens,
            total_cache_write_tokens: total_cache_write_tokens,
            total_uncached_tokens: total_uncached_tokens,
            cache_hit_turns: cache_hit_turns,
            cache_bust_turns: cache_bust_turns,
            anti_pattern_turns: anti_pattern_turns,
            cumulative_savings_bps: computeSavingsBps(total_baseline_cost, total_effective_cost),
        };
    }
}
