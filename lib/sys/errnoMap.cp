    /// 从 Linux 系统错误号（支持正数或内核负返回值 `-errno`）映射为 `SystemErrno`
    static fn fromLinuxCode(code: i32): SystemErrno? {
        const c = if (code < 0) -code else code;
        return switch (c) {
            1 => .EPERM,
            2 => .ENOENT,
            3 => .ESRCH,
            4 => .EINTR,
            5 => .EIO,
            6 => .ENXIO,
            7 => .E2BIG,
            8 => .ENOEXEC,
            9 => .EBADF,
            10 => .ECHILD,
            11 => .EAGAIN,
            12 => .ENOMEM,
            13 => .EACCES,
