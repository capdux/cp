            16 => .EBUSY,
            17 => .EEXIST,
            18 => .EXDEV,
            19 => .ENODEV,
            20 => .ENOTDIR,
            21 => .EISDIR,
            22 => .EINVAL,
            23 => .ENFILE,
            24 => .EMFILE,
            25 => .ENOTTY,
            26 => .ETXTBSY,
            27 => .EFBIG,
            28 => .ENOSPC,
            29 => .ESPIPE,
            30 => .EROFS,
            31 => .EMLINK,
            32 => .EPIPE,
            33 => .EDOM,
            34 => .ERANGE,
            35 => .EDEADLK,
            36 => .ENAMETOOLONG,
            37 => .ENOLCK,
            38 => .ENOSYS,
            39 => .ENOTEMPTY,
            40 => .ELOOP,
            75 => .EOVERFLOW,
            84 => .EILSEQ,
            88 => .ENOTSOCK,
            89 => .EDESTADDRREQ,
            90 => .EMSGSIZE,
            91 => .EPROTOTYPE,
            92 => .ENOPROTOOPT,
            93 => .EPROTONOSUPPORT,
            95 => .EOPNOTSUPP,
            97 => .EAFNOSUPPORT,
            98 => .EADDRINUSE,
            99 => .EADDRNOTAVAIL,
            100 => .ENETDOWN,
            101 => .ENETUNREACH,
            102 => .ENETRESET,
            103 => .ECONNABORTED,
            104 => .ECONNRESET,
            105 => .ENOBUFS,
            106 => .EISCONN,
            107 => .ENOTCONN,
            108 => .ESHUTDOWN,
            110 => .ETIMEDOUT,
            111 => .ECONNREFUSED,
            112 => .EHOSTDOWN,
            113 => .EHOSTUNREACH,
            114 => .EALREADY,
            115 => .EINPROGRESS,
            116 => .ESTALE,
            122 => .EDQUOT,
            125 => .ECANCELED,
            else => null,
        };
    }

    /// 从 macOS / Darwin 系统错误号（支持正数或负返回值 `-errno`）映射为 `SystemErrno`
    static fn fromDarwinCode(code: i32): SystemErrno? {
        const c = if (code < 0) -code else code;
