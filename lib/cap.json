{
  "ver": "0.1.0",
  "opt": "small",
  "lib": {
    "http": {
      "path": "http",
      "bin": {
        "picohttpparser": {
          "path": "vendor/picohttpparser",
          "src": [
            "picohttpparser.c"
          ],
          "include": [
            "."
          ],
          "opt": "fast"
        },
        "z": {
          "path": "vendor/zlib",
          "src": [
            "adler32.c",
            "compress.c",
            "crc32.c",
            "crc32_braid_comb.c",
            "deflate.c",
            "deflate_fast.c",
            "deflate_huff.c",
            "deflate_medium.c",
            "deflate_quick.c",
            "deflate_rle.c",
            "deflate_slow.c",
            "deflate_stored.c",
            "functable.c",
            "infback.c",
            "inflate.c",
            "inftrees.c",
            "insert_string.c",
            "insert_string_roll.c",
            "trees.c",
            "uncompr.c",
            "zutil.c"
          ],
          "include": [
            "."
          ],
          "flag": [
            "-DZLIB_COMPAT",
            "-DNDEBUG"
          ],
          "opt": "fast"
        }
      }
    },
    "net": {
      "path": "net",
      "bin": {
        "usockets": {
          "path": "vendor/usockets",
          "src": [
            "src/bsd.c",
            "src/context.c",
            "src/loop.c",
            "src/socket.c",
            "src/eventing/epoll_kqueue.c"
          ],
          "include": [
            "src"
          ],
          "flag": [
            "-DLIBUS_USE_OPENSSL=0"
          ]
        }
      }
    },
    "pack": {
      "path": "pack",
      "bin": {
        "z": {
          "path": "vendor/zlib",
          "src": [
            "adler32.c",
            "compress.c",
            "crc32.c",
            "crc32_braid_comb.c",
            "deflate.c",
            "deflate_fast.c",
            "deflate_huff.c",
            "deflate_medium.c",
            "deflate_quick.c",
            "deflate_rle.c",
            "deflate_slow.c",
            "deflate_stored.c",
            "functable.c",
            "infback.c",
            "inflate.c",
            "inftrees.c",
            "insert_string.c",
            "insert_string_roll.c",
            "trees.c",
            "uncompr.c",
            "zutil.c"
          ],
          "include": [
            "."
          ],
          "flag": [
            "-DZLIB_COMPAT",
            "-DNDEBUG"
          ],
          "opt": "fast"
        }
      }
    }
  }
}
