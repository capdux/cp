{
  "ver": "0.1.0",
  "opt": "small",
  "lib": {
    "http": {
      "path": "http",
      "bin": {
        "picohttpparser": {
          "path": "vendor/picohttpparser",
          "src": [
            "picohttpparser.c"
          ],
          "include": [
            "."
          ],
          "opt": "fast"
        },
        "z": {
          "path": "vendor/zlib",
          "src": [
            "adler32.c",
            "compress.c",
            "crc32.c",
            "crc32_braid_comb.c",
            "deflate.c",
            "deflate_fast.c",
            "deflate_huff.c",
            "deflate_medium.c",
            "deflate_quick.c",
            "deflate_rle.c",
            "deflate_slow.c",
            "deflate_stored.c",
            "functable.c",
            "infback.c",
            "inflate.c",
            "inftrees.c",
            "insert_string.c",
            "insert_string_roll.c",
            "trees.c",
            "uncompr.c",
            "zutil.c"
          ],
          "include": [
            "."
          ],
          "flag": [
            "-DZLIB_COMPAT",
            "-DNDEBUG"
          ],
          "opt": "fast"
        }
      }
    },
    "net": {
      "path": "net",
      "bin": {
        "usockets": {
          "path": "vendor/usockets",
          "src": [
            "src/bsd.c",
            "src/context.c",
            "src/loop.c",
            "src/socket.c",
            "src/eventing/epoll_kqueue.c"
          ],
          "include": [
            "src"
          ],
          "flag": [
            "-DLIBUS_USE_OPENSSL=0"
          ]
        }
      }
    },
    "pack": {
      "path": "pack",
      "bin": {
        "z": {
          "path": "vendor/zlib",
          "src": [
            "adler32.c",
            "compress.c",
            "crc32.c",
            "crc32_braid_comb.c",
            "deflate.c",
            "deflate_fast.c",
            "deflate_huff.c",
            "deflate_medium.c",
            "deflate_quick.c",
            "deflate_rle.c",
            "deflate_slow.c",
            "deflate_stored.c",
            "functable.c",
            "infback.c",
            "inflate.c",
            "inftrees.c",
            "insert_string.c",
            "insert_string_roll.c",
            "trees.c",
            "uncompr.c",
            "zutil.c"
          ],
          "include": [
            "."
          ],
          "flag": [
            "-DZLIB_COMPAT",
            "-DNDEBUG"
          ],
          "opt": "fast"
        }
      }
    },
    "image": {
      "path": "image",
      "bin": {
        "z": {
          "path": "vendor/zlib",
          "src": [
            "adler32.c",
            "compress.c",
            "crc32.c",
            "crc32_braid_comb.c",
            "deflate.c",
            "deflate_fast.c",
            "deflate_huff.c",
            "deflate_medium.c",
            "deflate_quick.c",
            "deflate_rle.c",
            "deflate_slow.c",
            "deflate_stored.c",
            "functable.c",
            "infback.c",
            "inflate.c",
            "inftrees.c",
            "insert_string.c",
            "insert_string_roll.c",
            "trees.c",
            "uncompr.c",
            "zutil.c"
          ],
          "include": [
            "."
          ],
          "flag": [
            "-DZLIB_COMPAT",
            "-DNDEBUG"
          ],
          "opt": "fast"
        }
      }
    },
    "sqlite": {
      "path": "sqlite.cp",
      "bin": {
        "sqlite3": {
          "path": "vendor/sqlite",
          "src": [
            "sqlite3.c"
          ],
          "include": [
            "."
          ],
          "flag": [
            "-DSQLITE_DQS=0",
            "-DSQLITE_DEFAULT_MEMSTATUS=0",
            "-DSQLITE_DEFAULT_WAL_SYNCHRONOUS=1",
            "-DSQLITE_LIKE_DOESNT_MATCH_BLOBS",
            "-DSQLITE_MAX_EXPR_DEPTH=0",
            "-DSQLITE_OMIT_DEPRECATED",
            "-DSQLITE_USE_ALLOCA",
            "-DSQLITE_ENABLE_FTS5",
            "-DSQLITE_ENABLE_RTREE",
            "-DSQLITE_ENABLE_JSON1",
            "-DSQLITE_ENABLE_MATH_FUNCTIONS",
            "-DSQLITE_ENABLE_DESERIALIZE",
            "-DSQLITE_THREADSAFE=1"
          ],
          "opt": "fast",
          "prebuilt": "prebuilt"
        }
      },
      "sys": {
        "c": {},
        "m": {},
        "pthread": {},
        "dl": {}
      }
    }
  }
}
