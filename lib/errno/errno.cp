// Source: /data/dev/bun/src/errno/linux_errno.cp
// lib/errno/errno.cp
// Cross-platform POSIX / Linux / Darwin / Windows System Error Codes (cap:errno)
// Absorbed from Bun src/errno/{linux_errno,darwin_errno,windows_errno}.cp

pub enum SystemErrno: u16 {
    SUCCESS = 0,
    EPERM = 1,
    ENOENT = 2,
    ESRCH = 3,
    EINTR = 4,
    EIO = 5,
    ENXIO = 6,
    E2BIG = 7,
    ENOEXEC = 8,
    EBADF = 9,
    ECHILD = 10,
    EAGAIN = 11,
    ENOMEM = 12,
    EACCES = 13,
    EFAULT = 14,
    ENOTBLK = 15,
    EBUSY = 16,
    EEXIST = 17,
    EXDEV = 18,
    ENODEV = 19,
    ENOTDIR = 20,
    EISDIR = 21,
    EINVAL = 22,
    ENFILE = 23,
    EMFILE = 24,
    ENOTTY = 25,
    ETXTBSY = 26,
    EFBIG = 27,
    ENOSPC = 28,
    ESPIPE = 29,
    EROFS = 30,
    EMLINK = 31,
    EPIPE = 32,
    EDOM = 33,
    ERANGE = 34,
    EDEADLK = 35,
    ENAMETOOLONG = 36,
    ENOLCK = 37,
    ENOSYS = 38,
    ENOTEMPTY = 39,
    ELOOP = 40,
    EWOULDBLOCK = 41,
    EOVERFLOW = 75,
    ENOTSOCK = 88,
    EMSGSIZE = 90,
    ENOTSUP = 95,
    EAFNOSUPPORT = 97,
    EADDRINUSE = 98,
    EADDRNOTAVAIL = 99,
    ENETDOWN = 100,
    ENETUNREACH = 101,
    ECONNABORTED = 103,
    ECONNRESET = 104,
    ENOBUFS = 105,
    EISCONN = 106,
    ENOTCONN = 107,
    ESHUTDOWN = 108,
    ETIMEDOUT = 110,
    ECONNREFUSED = 111,
    EHOSTDOWN = 112,
    EHOSTUNREACH = 113,
    EALREADY = 114,
    EINPROGRESS = 115,
    ECANCELED = 125,
    UNKNOWN = 65535,

    /// Converts a raw OS errno (positive POSIX code or negative Linux syscall return `-errno`) into `SystemErrno`.
    pub static fn fromCode(code: i32): SystemErrno {
        const abs_code: i32 = if (code < 0) (-code) else code;
        return switch (abs_code) {
            0 => SystemErrno.SUCCESS,
            1 => SystemErrno.EPERM,
            2 => SystemErrno.ENOENT,
            3 => SystemErrno.ESRCH,
            4 => SystemErrno.EINTR,
            5 => SystemErrno.EIO,
            6 => SystemErrno.ENXIO,
            7 => SystemErrno.E2BIG,
            8 => SystemErrno.ENOEXEC,
            9 => SystemErrno.EBADF,
            10 => SystemErrno.ECHILD,
            11 => SystemErrno.EAGAIN,
            12 => SystemErrno.ENOMEM,
            13 => SystemErrno.EACCES,
            14 => SystemErrno.EFAULT,
            15 => SystemErrno.ENOTBLK,
            16 => SystemErrno.EBUSY,
            17 => SystemErrno.EEXIST,
            18 => SystemErrno.EXDEV,
            19 => SystemErrno.ENODEV,
            20 => SystemErrno.ENOTDIR,
            21 => SystemErrno.EISDIR,
            22 => SystemErrno.EINVAL,
            23 => SystemErrno.ENFILE,
            24 => SystemErrno.EMFILE,
            25 => SystemErrno.ENOTTY,
            26 => SystemErrno.ETXTBSY,
            27 => SystemErrno.EFBIG,
            28 => SystemErrno.ENOSPC,
            29 => SystemErrno.ESPIPE,
            30 => SystemErrno.EROFS,
            31 => SystemErrno.EMLINK,
            32 => SystemErrno.EPIPE,
            33 => SystemErrno.EDOM,
            34 => SystemErrno.ERANGE,
            35 => SystemErrno.EDEADLK,
            36 => SystemErrno.ENAMETOOLONG,
            37 => SystemErrno.ENOLCK,
            38 => SystemErrno.ENOSYS,
            39 => SystemErrno.ENOTEMPTY,
            40 => SystemErrno.ELOOP,
            41 => SystemErrno.EWOULDBLOCK,
            75 => SystemErrno.EOVERFLOW,
            88 => SystemErrno.ENOTSOCK,
            90 => SystemErrno.EMSGSIZE,
            95 => SystemErrno.ENOTSUP,
            97 => SystemErrno.EAFNOSUPPORT,
            98 => SystemErrno.EADDRINUSE,
            99 => SystemErrno.EADDRNOTAVAIL,
            100 => SystemErrno.ENETDOWN,
            101 => SystemErrno.ENETUNREACH,
            103 => SystemErrno.ECONNABORTED,
            104 => SystemErrno.ECONNRESET,
            105 => SystemErrno.ENOBUFS,
            106 => SystemErrno.EISCONN,
            107 => SystemErrno.ENOTCONN,
            108 => SystemErrno.ESHUTDOWN,
            110 => SystemErrno.ETIMEDOUT,
            111 => SystemErrno.ECONNREFUSED,
            112 => SystemErrno.EHOSTDOWN,
            113 => SystemErrno.EHOSTUNREACH,
            114 => SystemErrno.EALREADY,
            115 => SystemErrno.EINPROGRESS,
            125 => SystemErrno.ECANCELED,
            else => SystemErrno.UNKNOWN,
        };
    }

    /// Returns the numeric POSIX/Linux error code as `i32`.
    pub fn toCode(): i32 {
        return @intFromEnum(_) as i32;
    }

    /// Returns the canonical symbolic POSIX name (e.g., `"ENOENT"`, `"ECONNREFUSED"`).
    /// Note: CP enums also expose `.name` property and `.toString()` returning the variant tag name.
    pub fn codeName(): []const u8 {
        return SystemErrno.name(_);
    }

    /// Returns the canonical symbolic POSIX name (usable via `SystemErrno.name(err)`).
    pub fn name(): []const u8 {
        return switch (_) {
            .SUCCESS => "SUCCESS",
            .EPERM => "EPERM",
            .ENOENT => "ENOENT",
            .ESRCH => "ESRCH",
            .EINTR => "EINTR",
            .EIO => "EIO",
            .ENXIO => "ENXIO",
            .E2BIG => "E2BIG",
            .ENOEXEC => "ENOEXEC",
            .EBADF => "EBADF",
            .ECHILD => "ECHILD",
            .EAGAIN => "EAGAIN",
            .ENOMEM => "ENOMEM",
            .EACCES => "EACCES",
            .EFAULT => "EFAULT",
            .ENOTBLK => "ENOTBLK",
            .EBUSY => "EBUSY",
            .EEXIST => "EEXIST",
            .EXDEV => "EXDEV",
            .ENODEV => "ENODEV",
            .ENOTDIR => "ENOTDIR",
            .EISDIR => "EISDIR",
            .EINVAL => "EINVAL",
            .ENFILE => "ENFILE",
            .EMFILE => "EMFILE",
            .ENOTTY => "ENOTTY",
            .ETXTBSY => "ETXTBSY",
            .EFBIG => "EFBIG",
            .ENOSPC => "ENOSPC",
            .ESPIPE => "ESPIPE",
            .EROFS => "EROFS",
            .EMLINK => "EMLINK",
            .EPIPE => "EPIPE",
            .EDOM => "EDOM",
            .ERANGE => "ERANGE",
            .EDEADLK => "EDEADLK",
            .ENAMETOOLONG => "ENAMETOOLONG",
            .ENOLCK => "ENOLCK",
            .ENOSYS => "ENOSYS",
            .ENOTEMPTY => "ENOTEMPTY",
            .ELOOP => "ELOOP",
            .EWOULDBLOCK => "EWOULDBLOCK",
            .EOVERFLOW => "EOVERFLOW",
            .ENOTSOCK => "ENOTSOCK",
            .EMSGSIZE => "EMSGSIZE",
            .ENOTSUP => "ENOTSUP",
            .EAFNOSUPPORT => "EAFNOSUPPORT",
            .EADDRINUSE => "EADDRINUSE",
            .EADDRNOTAVAIL => "EADDRNOTAVAIL",
            .ENETDOWN => "ENETDOWN",
            .ENETUNREACH => "ENETUNREACH",
            .ECONNABORTED => "ECONNABORTED",
            .ECONNRESET => "ECONNRESET",
            .ENOBUFS => "ENOBUFS",
            .EISCONN => "EISCONN",
            .ENOTCONN => "ENOTCONN",
            .ESHUTDOWN => "ESHUTDOWN",
            .ETIMEDOUT => "ETIMEDOUT",
            .ECONNREFUSED => "ECONNREFUSED",
            .EHOSTDOWN => "EHOSTDOWN",
            .EHOSTUNREACH => "EHOSTUNREACH",
            .EALREADY => "EALREADY",
            .EINPROGRESS => "EINPROGRESS",
            .ECANCELED => "ECANCELED",
            .UNKNOWN => "UNKNOWN",
        };
    }

    /// Returns a human-readable POSIX diagnostic description.
    pub fn description(): []const u8 {
        return switch (_) {
            .SUCCESS => "Success",
            .EPERM => "Operation not permitted",
            .ENOENT => "No such file or directory",
            .ESRCH => "No such process",
            .EINTR => "Interrupted system call",
            .EIO => "Input/output error",
            .ENXIO => "No such device or address",
            .E2BIG => "Argument list too long",
            .ENOEXEC => "Exec format error",
            .EBADF => "Bad file descriptor",
            .ECHILD => "No child processes",
            .EAGAIN => "Resource temporarily unavailable",
            .ENOMEM => "Cannot allocate memory",
            .EACCES => "Permission denied",
            .EFAULT => "Bad address",
            .ENOTBLK => "Block device required",
            .EBUSY => "Device or resource busy",
            .EEXIST => "File exists",
            .EXDEV => "Invalid cross-device link",
            .ENODEV => "No such device",
            .ENOTDIR => "Not a directory",
            .EISDIR => "Is a directory",
            .EINVAL => "Invalid argument",
            .ENFILE => "Too many open files in system",
            .EMFILE => "Too many open files",
            .ENOTTY => "Inappropriate ioctl for device",
            .ETXTBSY => "Text file busy",
            .EFBIG => "File too large",
            .ENOSPC => "No space left on device",
            .ESPIPE => "Illegal seek",
            .EROFS => "Read-only file system",
            .EMLINK => "Too many links",
            .EPIPE => "Broken pipe",
            .EDOM => "Numerical argument out of domain",
            .ERANGE => "Numerical result out of range",
            .EDEADLK => "Resource deadlock avoided",
            .ENAMETOOLONG => "File name too long",
            .ENOLCK => "No locks available",
            .ENOSYS => "Function not implemented",
            .ENOTEMPTY => "Directory not empty",
            .ELOOP => "Too many levels of symbolic links",
            .EWOULDBLOCK => "Operation would block",
            .EOVERFLOW => "Value too large for defined data type",
            .ENOTSOCK => "Socket operation on non-socket",
            .EMSGSIZE => "Message too long",
            .ENOTSUP => "Operation not supported",
            .EAFNOSUPPORT => "Address family not supported by protocol",
            .EADDRINUSE => "Address already in use",
            .EADDRNOTAVAIL => "Cannot assign requested address",
            .ENETDOWN => "Network is down",
            .ENETUNREACH => "Network is unreachable",
            .ECONNABORTED => "Software caused connection abort",
            .ECONNRESET => "Connection reset by peer",
            .ENOBUFS => "No buffer space available",
            .EISCONN => "Transport endpoint is already connected",
            .ENOTCONN => "Transport endpoint is not connected",
            .ESHUTDOWN => "Cannot send after transport endpoint shutdown",
            .ETIMEDOUT => "Connection timed out",
            .ECONNREFUSED => "Connection refused",
            .EHOSTDOWN => "Host is down",
            .EHOSTUNREACH => "No route to host",
            .EALREADY => "Operation already in progress",
            .EINPROGRESS => "Operation now in progress",
            .ECANCELED => "Operation canceled",
            .UNKNOWN => "Unknown system error",
        };
    }

    /// Returns `true` if the error represents a transient condition where retrying may succeed.
    pub fn isRetryable(): bool {
        return switch (_) {
            .EINTR, .EAGAIN, .EWOULDBLOCK, .EBUSY, .ETIMEDOUT => true,
            else => false,
        };
    }

    /// Returns `true` if the target file, directory, device, or process was not found.
    pub fn isNotFound(): bool {
        return switch (_) {
            .ENOENT, .ESRCH, .ENODEV, .ENXIO => true,
            else => false,
        };
    }

    /// Returns `true` if the operation was rejected due to missing permissions or read-only media.
    pub fn isPermissionDenied(): bool {
        return switch (_) {
            .EPERM, .EACCES, .EROFS => true,
            else => false,
        };
    }

    /// Returns `true` if the error code represents `SUCCESS` (`0`).
    pub fn isOk(): bool {
        return _ == SystemErrno.SUCCESS;
    }

    /// Returns `true` for socket and network transport error codes.
    pub fn isNetworkError(): bool {
        return switch (_) {
            .EADDRINUSE,
            .EADDRNOTAVAIL,
            .ENETDOWN,
            .ENETUNREACH,
            .ECONNABORTED,
            .ECONNRESET,
            .ENOBUFS,
            .EISCONN,
            .ENOTCONN,
            .ESHUTDOWN,
            .ETIMEDOUT,
            .ECONNREFUSED,
            .EHOSTDOWN,
            .EHOSTUNREACH => true,
            else => false,
        };
    }
}
