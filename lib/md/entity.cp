// Source: /data/dev/bun/src/md/entity.cp
// lib/md/entity.cp
// Full W3C HTML5 Named Character Reference Table (2,125 entities) with O(log N) binary search

const std = @import("std");

pub struct Entity {
    name: []const u8,
    codepoints: [2]u21,
}

/// Look up an HTML entity by name (including '&' prefix and ';' suffix).
/// Uses binary search on the sorted entity map.
pub fn lookup(name: []const u8): ([2]u21)? {
    let low: usize = 0;
    let high: usize = entity_map.len;
    while (low < high) {
        const mid = low + (high - low) / 2;
        const cmp = orderStrings(entity_map[mid].name, name);
        if (cmp == .lt) {
            low = mid + 1;
        } else if (cmp == .gt) {
            high = mid;
        } else {
            return entity_map[mid].codepoints;
        }
    }
    return null;
}

fn orderStrings(a: []const u8, b: []const u8): std.math.Order {
    const len = @min(a.len, b.len);
    let i: usize = 0;
    while (i < len) : (i += 1) {
        if (a[i] < b[i]) return .lt;
        if (a[i] > b[i]) return .gt;
    }
    return std.math.order(a.len, b.len);
}

